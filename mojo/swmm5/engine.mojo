        return
    report_writeLine(G, rt.s(""))
    report_writeLine(G, rt.s("***************************"))
    report_writeLine(G, rt.s("Subcatchment Runoff Summary"))
    report_writeLine(G, rt.s("***************************"))
    report_writeLine(G, rt.s(""))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  ------------------------------------------------------------------------------------------------------------------------------\n                            Total      Total      Total      Total     Imperv       Perv      Total       Total     Peak  Runoff\n                           Precip      Runon       Evap      Infil     Runoff     Runoff     Runoff      Runoff   Runoff   Coeff"))
    if (G[].UnitSystem == Int32(0)):
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Subcatchment                 in         in         in         in         in         in         in    %8s      %3s"), rt.astr(G[].VolUnitsWords[unsafe_offset=Int(G[].UnitSystem)]), rt.astr(G[].FlowUnitWords[unsafe_offset=Int(G[].FlowUnits)]))
    else:
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Subcatchment                 mm         mm         mm         mm         mm         mm         mm    %8s      %3s"), rt.astr(G[].VolUnitsWords[unsafe_offset=Int(G[].UnitSystem)]), rt.astr(G[].FlowUnitWords[unsafe_offset=Int(G[].FlowUnits)]))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  ------------------------------------------------------------------------------------------------------------------------------"))
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=1]):
        a = G[].Subcatch[unsafe_offset=Int(j)].area
        if (a == Float64(0.0)):
            j += 1
            continue
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  %-20s"), rt.astr(G[].Subcatch[unsafe_offset=Int(j)].ID))
        x = (G[].SubcatchStats[unsafe_offset=Int(j)].precip * UCF(G, Int32(1)))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" %10.2f"), rt.ad((x / a)))
        x = (G[].SubcatchStats[unsafe_offset=Int(j)].runon * UCF(G, Int32(1)))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" %10.2f"), rt.ad((x / a)))
        x = (G[].SubcatchStats[unsafe_offset=Int(j)].evap * UCF(G, Int32(1)))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" %10.2f"), rt.ad((x / a)))
        x = (G[].SubcatchStats[unsafe_offset=Int(j)].infil * UCF(G, Int32(1)))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" %10.2f"), rt.ad((x / a)))
        x = (G[].SubcatchStats[unsafe_offset=Int(j)].impervRunoff * UCF(G, Int32(1)))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" %10.2f"), rt.ad((x / a)))
        x = (G[].SubcatchStats[unsafe_offset=Int(j)].pervRunoff * UCF(G, Int32(1)))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" %10.2f"), rt.ad((x / a)))
        x = (G[].SubcatchStats[unsafe_offset=Int(j)].runoff * UCF(G, Int32(1)))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" %10.2f"), rt.ad((x / a)))
        x = (G[].SubcatchStats[unsafe_offset=Int(j)].runoff * G[].Vcf)
        _ = rt.fprintf(G[].Frpt.file, rt.s("%12.2f"), rt.ad(x))
        x = (G[].SubcatchStats[unsafe_offset=Int(j)].maxFlow * UCF(G, Int32(10)))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" %8.2f"), rt.ad(x))
        r = (G[].SubcatchStats[unsafe_offset=Int(j)].precip + G[].SubcatchStats[unsafe_offset=Int(j)].runon)
        if (r > Float64(0.0)):
            r = (G[].SubcatchStats[unsafe_offset=Int(j)].runoff / r)
        _ = rt.fprintf(G[].Frpt.file, rt.s("%8.3f"), rt.ad(r))
        j += 1
    report_writeLine(G, rt.s(""))


