    j2 = jLast
    if (y <= table[unsafe_offset=0]):
        return Int32(0)
    if (y >= table[unsafe_offset=Int(jLast)]):
        return jLast
    while ((j2 - j1) > Int32(1)):
        j = ((j1 + j2) >> Int32(1))
        if (y >= table[unsafe_offset=Int(j)]):
            j1 = j
        else:
            j2 = j
    return j1


