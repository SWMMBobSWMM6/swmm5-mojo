        subcatch_getResults(G, j, Float64(1.0), G[].SubcatchResults)
        _ = rt.fwrite(G[].SubcatchResults.unsafe_bitcast[NoneType](), UInt64(4), UInt64(n), G[].Frunoff.file)
        j += 1
    G[].R_[].sp = __sp


# runoff.c:412
def runoff_readFromFile(G: P[Globals]):
    var i: Int32 = Int32(0)
    var j: Int32 = Int32(0)
