# link.c:783
def link_getYnorm(G: P[Globals], j: Int32, var q: Float64) -> Float64:
    var k: Int32 = Int32(0)
    var s: Float64 = Float64(0.0)
    var a: Float64 = Float64(0.0)
    var y: Float64 = Float64(0.0)
    if (G[].Link[unsafe_offset=Int(j)].type != Int32(0)):
        return Float64(0.0)
    if (G[].Link[unsafe_offset=Int(j)].xsect.type == Int32(0)):
        return Float64(0.0)
    q = rt.fabs(q)
    k = G[].Link[unsafe_offset=Int(j)].subIndex
    if (q > G[].Conduit[unsafe_offset=Int(k)].qMax):
        q = G[].Conduit[unsafe_offset=Int(k)].qMax
    if (q <= Float64(0.0)):
        return Float64(0.0)
    s = (q / G[].Conduit[unsafe_offset=Int(k)].beta)
    a = xsect_getAofS(G, rt.addr(G[].Link[unsafe_offset=Int(j)].xsect), s)
    y = xsect_getYofA(G, rt.addr(G[].Link[unsafe_offset=Int(j)].xsect), a)
    return y


