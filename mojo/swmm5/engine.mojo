    G[].SubcatchStats[unsafe_offset=Int(j)].runoff = (G[].SubcatchStats[unsafe_offset=Int(j)].runoff + runoffVol)
    G[].SubcatchStats[unsafe_offset=Int(j)].maxFlow = ((G[].SubcatchStats[unsafe_offset=Int(j)].maxFlow) if ((G[].SubcatchStats[unsafe_offset=Int(j)].maxFlow) >= runoff) else runoff)
