# swmm5.c:314
def swmm_start(G: P[Globals], saveResults_2: Int32) -> Int32:
    if (G[].ErrorCode != 0):
        return G[].ErrorCode
    if (not (G[].IsOpenFlag != 0)):
        return (rt.set(G[].ErrorCode, Int32(501)))
    if (G[].IsStartedFlag != 0):
        return (rt.set(G[].ErrorCode, Int32(503)))
    if (not (G[].RptFlags.disabled != 0)):
        if (G[].RptFlags.input != 0):
            inputrpt_writeInput(G)
        report_writeOptions(G)
    G[].SaveResultsFlag = saveResults_2
    G[].ExceptionCount = Int32(0)
    G[].ElapsedTime = Float64(0.0)
    G[].RoutingDuration = G[].TotalDuration
    G[].NewRunoffTime = Float64(0.0)
    G[].NewRoutingTime = Float64(0.0)
    G[].ReportTime = (Float64(1000.0) * Float64(G[].ReportStep))
    G[].TotalStepCount = Int64(0)
    G[].ReportStepCount = Int64(0)
    G[].NonConvergeCount = Int64(0)
    G[].IsStartedFlag = Int32(1)
    G[].RunoffError = Float64(0.0)
    G[].GwaterError = Float64(0.0)
    G[].FlowError = Float64(0.0)
    G[].QualError = Float64(0.0)
    if (not (G[].IgnoreRainfall != 0)):
        rain_open(G)
    if (G[].ErrorCode != 0):
        return G[].ErrorCode
    _ = project_init(G)
    if (G[].Nobjects[unsafe_offset=1] > Int32(0)):
        G[].DoRunoff = Int32(1)
    else:
        G[].DoRunoff = Int32(0)
    if ((G[].Nobjects[unsafe_offset=2] > Int32(0)) and (not (G[].IgnoreRouting != 0))):
        G[].DoRouting = Int32(1)
    else:
        G[].DoRouting = Int32(0)
    _ = output_open(G)
    if (G[].DoRunoff != 0):
        _ = runoff_open(G)
    if (not (hotstart_open(G) != 0)):
        return G[].ErrorCode
    if (G[].DoRouting != 0):
        _ = routing_open(G)
    _ = massbal_open(G)
    _ = stats_open(G)
    if ((not (G[].RptFlags.disabled != 0)) and (Int32(G[].RptFlags.controls) != 0)):
        report_writeControlActionsHeading(G)
    return G[].ErrorCode


# swmm5.c:410
def swmm_step(G: P[Globals], elapsedTime: P[Float64]) -> Int32:
    elapsedTime[] = Float64(0.0)
    if (G[].ErrorCode != 0):
        return G[].ErrorCode
    if (not (G[].IsOpenFlag != 0)):
        return (rt.set(G[].ErrorCode, Int32(501)))
    if (not (G[].IsStartedFlag != 0)):
        return (rt.set(G[].ErrorCode, Int32(502)))
    if (G[].NewRoutingTime < G[].RoutingDuration):
        execRouting(G)
    if (G[].SaveResultsFlag != 0):
        saveResults(G)
    if (G[].NewRoutingTime < G[].RoutingDuration):
        G[].ElapsedTime = (G[].NewRoutingTime / Float64(86400000.0))
    else:
        G[].ElapsedTime = Float64(0.0)
    elapsedTime[] = G[].ElapsedTime
    return G[].ErrorCode


