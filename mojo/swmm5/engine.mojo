                    (G[].Node[unsafe_offset=Int(k)].newQual)[unsafe_offset=Int(p)] = ((G[].Node[unsafe_offset=Int(k)].newQual)[unsafe_offset=Int(p)] + w)
                    massbal_addInflowQual(G, Int32(2), p, w)
                    p += 1
            lidList = lidList[].nextLidUnit


# lid.c:1609
def lid_getRunoff(G: P[Globals], j: Int32, tStep: Float64):
    var theLidGroup: P[LidGroup] = rt.null[LidGroup]()
    var lidList: P[TLidList] = rt.null[TLidList]()
    var lidUnit: P[TLidUnit] = rt.null[TLidUnit]()
    var lidArea: Float64 = Float64(0.0)
    var qImperv: Float64 = Float64(0.0)
    var qPerv: Float64 = Float64(0.0)
    var lidInflow: Float64 = Float64(0.0)
    var __sp = G[].R_[].sp
    var qRunoff = rt.salloc[Float64](G[].R_, 1)
    var qDrain = rt.salloc[Float64](G[].R_, 1)
    var qReturn = rt.salloc[Float64](G[].R_, 1)
    qImperv = Float64(0.0)
    qPerv = Float64(0.0)
    lidInflow = Float64(0.0)
    qRunoff[] = Float64(0.0)
    qDrain[] = Float64(0.0)
    qReturn[] = Float64(0.0)
    theLidGroup = G[].LidGroups[unsafe_offset=Int(j)]
    if (not (not rt.isnull(theLidGroup))):
        G[].R_[].sp = __sp
        return
    lidList = theLidGroup[].lidList
    if (not (not rt.isnull(lidList))):
        G[].R_[].sp = __sp
        return
    G[].lid_EvapRate = G[].Evap.rate
    if ((G[].Evap.dryOnly != 0) and (G[].Subcatch[unsafe_offset=Int(j)].rainfall > Float64(0.0))):
        G[].lid_EvapRate = Float64(0.0)
    findNativeInfil(G, j, tStep)
    if (G[].Subcatch[unsafe_offset=Int(j)].area > G[].Subcatch[unsafe_offset=Int(j)].lidArea):
        qImperv = getImpervAreaRunoff(G, j)
        qPerv = getPervAreaRunoff(G, j)
    while (not rt.isnull(lidList)):
        lidUnit = lidList[].lidUnit
        lidArea = (lidUnit[].area * Float64(lidUnit[].number))
        if (lidArea > Float64(0.0)):
            lidInflow = (((qImperv * lidUnit[].fromImperv) + (qPerv * lidUnit[].fromPerv)) / lidArea)
            G[].VlidIn = (G[].VlidIn + ((lidInflow * lidArea) * tStep))
            lidInflow = (lidInflow + getRainInflow(G, j, lidUnit))
            if (G[].Subcatch[unsafe_offset=Int(j)].area == G[].Subcatch[unsafe_offset=Int(j)].lidArea):
                lidInflow = (lidInflow + G[].Subcatch[unsafe_offset=Int(j)].runon)
            evalLidUnit(G, j, lidUnit, lidArea, lidInflow, tStep, qRunoff, qDrain, qReturn)
        lidList = lidList[].nextLidUnit
    theLidGroup[].newDrainFlow = qDrain[]
    theLidGroup[].flowToPerv = qReturn[]
    G[].VlidOut = (qRunoff[] * tStep)
    G[].VlidDrain = (qDrain[] * tStep)
    G[].VlidReturn = (qReturn[] * tStep)
    G[].R_[].sp = __sp


# lid.c:1697
def findNativeInfil(G: P[Globals], j: Int32, tStep: Float64):
    var nonLidArea: Float64 = Float64(0.0)
    nonLidArea = (G[].Subcatch[unsafe_offset=Int(j)].area - G[].Subcatch[unsafe_offset=Int(j)].lidArea)
    if ((nonLidArea > Float64(0.0)) and (G[].Subcatch[unsafe_offset=Int(j)].fracImperv < Float64(1.0))):
        G[].NativeInfil = ((G[].Vinfil / nonLidArea) / tStep)
    else:
        G[].NativeInfil = infil_getInfil(G, j, tStep, G[].Subcatch[unsafe_offset=Int(j)].rainfall, G[].Subcatch[unsafe_offset=Int(j)].runon, getSurfaceDepth(G, j))
    if ((not (G[].IgnoreGwater != 0)) and (not rt.isnull(G[].Subcatch[unsafe_offset=Int(j)].groundwater))):
        G[].lid_MaxNativeInfil = ((G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].maxInfilVol / tStep)
    else:
        G[].lid_MaxNativeInfil = Float64(10000000000.0)


# lid.c:1734
def getRainInflow(G: P[Globals], j: Int32, lidUnit: P[TLidUnit]) -> Float64:
    var lidProc: P[TLidProc] = rt.null[TLidProc]()
    lidProc = G[].LidProcs.unsafe_offset(Int(lidUnit[].lidIndex))
    if ((lidProc[].lidType == Int32(5)) and (lidProc[].storage.covered == Int32(1))):
        return Float64(0.0)
    return G[].Subcatch[unsafe_offset=Int(j)].rainfall


