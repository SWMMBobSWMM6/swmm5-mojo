    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=2]):
        if ((G[].Node[unsafe_offset=Int(i)].type == Int32(1)) and (G[].Node[unsafe_offset=Int(i)].inflow > Float64(0.0))):
            k = G[].Node[unsafe_offset=Int(i)].subIndex
            if (G[].Outfall[unsafe_offset=Int(k)].routeTo >= Int32(0)):
                v = (G[].Node[unsafe_offset=Int(i)].inflow * tStep)
                G[].Outfall[unsafe_offset=Int(k)].vRouted = (G[].Outfall[unsafe_offset=Int(k)].vRouted + v)
                p = Int32(0)
