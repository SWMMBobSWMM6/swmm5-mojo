# dynwave.c:177
def dynwave_validate(G: P[Globals]):
    if (G[].MinRouteStep > G[].RouteStep):
        G[].MinRouteStep = G[].RouteStep
    if (G[].MinRouteStep < G[].MINTIMESTEP):
        G[].MinRouteStep = G[].MINTIMESTEP
    if (G[].MinSurfArea == Float64(0.0)):
        G[].MinSurfArea = G[].DEFAULT_SURFAREA
    else:
        G[].MinSurfArea = (G[].MinSurfArea / (UCF(G, Int32(3)) * UCF(G, Int32(3))))
    if (G[].HeadTol == Float64(0.0)):
        G[].HeadTol = G[].DEFAULT_HEADTOL
    else:
        G[].HeadTol = (G[].HeadTol / UCF(G, Int32(3)))
    if (G[].MaxTrials == Int32(0)):
        G[].MaxTrials = G[].DEFAULT_MAXTRIALS


# dynwave.c:195
def dynwave_getRoutingStep(G: P[Globals], fixedStep: Float64) -> Float64:
    if (G[].CourantFactor == Float64(0.0)):
        return fixedStep
    if (fixedStep < G[].MINTIMESTEP):
        return fixedStep
    if (G[].VariableStep == Float64(0.0)):
        G[].VariableStep = G[].MinRouteStep
    else:
        G[].VariableStep = getVariableStep(G, fixedStep)
    G[].VariableStep = (floor((Float64(1000.0) * G[].VariableStep)) / Float64(1000.0))
    return G[].VariableStep


# dynwave.c:224
def dynwave_execute(G: P[Globals], tStep: Float64) -> Int32:
    var converged: Int32 = Int32(0)
    if (G[].ErrorCode != 0):
        return Int32(0)
    G[].Steps = Int32(0)
    converged = Int32(0)
    G[].Omega = G[].dynwave_OMEGA
    initRoutingStep(G)
    while (G[].Steps < G[].MaxTrials):
        initNodeStates(G)
        findLinkFlows(G, tStep)
        converged = findNodeDepths(G, tStep)
        G[].Steps += 1
        if (G[].Steps > Int32(1)):
            if (converged != 0):
                break
            findBypassedLinks(G)
    if (not (converged != 0)):
        updateConvergenceStats(G)
    findLimitedLinks(G)
    return G[].Steps


# dynwave.c:266
def updateConvergenceStats(G: P[Globals]):
