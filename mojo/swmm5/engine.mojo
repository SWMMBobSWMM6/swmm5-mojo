        fHi = fLo
        aLo = Float64(0.0)
        fLo = G[].C2
    if ((fHi * fLo) <= Float64(0.0)):
        if ((aout[] < aLo) or (aout[] > aHi)):
            aout[] = (Float64(0.5) * (aLo + aHi))
        if (fLo > fHi):
