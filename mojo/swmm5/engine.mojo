# lidproc.c:1344
def getStorageDrainRate(G: P[Globals], storageDepth: Float64, soilTheta: Float64, paveDepth: Float64, surfaceDepth: Float64) -> Float64:
    var curve: Int32 = Int32(0)
    var head: Float64 = Float64(0.0)
    var outflow: Float64 = Float64(0.0)
    var paveThickness: Float64 = Float64(0.0)
    var soilThickness: Float64 = Float64(0.0)
    var soilPorosity: Float64 = Float64(0.0)
    var soilFieldCap: Float64 = Float64(0.0)
    var storageThickness: Float64 = Float64(0.0)
    curve = G[].theLidProc[].drain.qCurve
    head = storageDepth
    outflow = Float64(0.0)
    paveThickness = G[].theLidProc[].pavement.thickness
    soilThickness = G[].theLidProc[].soil.thickness
    soilPorosity = G[].theLidProc[].soil.porosity
    soilFieldCap = G[].theLidProc[].soil.fieldCap
    storageThickness = G[].theLidProc[].storage.thickness
    if (storageDepth >= storageThickness):
        if (soilThickness > Float64(0.0)):
            if (soilTheta > soilFieldCap):
                head = (head + (((soilTheta - soilFieldCap) / (soilPorosity - soilFieldCap)) * soilThickness))
                if (soilTheta >= soilPorosity):
                    if (paveThickness > Float64(0.0)):
                        head = (head + paveDepth)
                        if (paveDepth >= paveThickness):
                            head = (head + surfaceDepth)
                    else:
                        head = (head + surfaceDepth)
        elif (paveThickness > Float64(0.0)):
            head = (head + paveDepth)
            if (paveDepth >= paveThickness):
                head = (head + surfaceDepth)
    if ((G[].theLidUnit[].oldDrainFlow == Float64(0.0)) and (head <= G[].theLidProc[].drain.hOpen)):
        return Float64(0.0)
    if ((G[].theLidUnit[].oldDrainFlow > Float64(0.0)) and (head <= G[].theLidProc[].drain.hClose)):
        return Float64(0.0)
    head = (head - G[].theLidProc[].drain.offset)
    if (head > Float64(1e-10)):
        head = (head * UCF(G, Int32(1)))
        outflow = (G[].theLidProc[].drain.coeff * rt.pow(head, G[].theLidProc[].drain.expon))
        if (curve >= Int32(0)):
            outflow = (outflow * table_lookup(G, G[].Curve.unsafe_offset(Int(curve)), head))
        outflow = (outflow / UCF(G, Int32(0)))
    return outflow


