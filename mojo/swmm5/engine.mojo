    report_writeLine(G, rt.s(""))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  ---------------------------------------------------------------------------------------------------------------------------------------\n                                                                                        Peak     Avg.   Bypass     Back     Peak     Peak\n                        Peak   Maximum   Maximum                                        Flow     Flow     Flow     Flow  Capture   Bypass\n                        Flow    Spread     Depth  Inlet             Inlet     Inlet  Capture  Capture     Freq     Freq  / Inlet     Flow"))
    if (G[].UnitSystem == Int32(0)):
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Street Conduit         %3s        ft        ft  Design            Location  Count     Pcnt     Pcnt     Pcnt     Pcnt      %3s      %3s"), rt.astr(G[].FlowUnitWords[unsafe_offset=Int(G[].FlowUnits)]), rt.astr(G[].FlowUnitWords[unsafe_offset=Int(G[].FlowUnits)]), rt.astr(G[].FlowUnitWords[unsafe_offset=Int(G[].FlowUnits)]))
    else:
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Street Conduit         %3s         m         m  Design            Location            Pcnt     Pcnt     Pcnt     Pcnt      %3s      %3s"), rt.astr(G[].FlowUnitWords[unsafe_offset=Int(G[].FlowUnits)]), rt.astr(G[].FlowUnitWords[unsafe_offset=Int(G[].FlowUnits)]), rt.astr(G[].FlowUnitWords[unsafe_offset=Int(G[].FlowUnits)]))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  ---------------------------------------------------------------------------------------------------------------------------------------"))


