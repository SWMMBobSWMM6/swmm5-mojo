# inlet.c:1147
def getConduitGeometry(G: P[Globals], inlet: P[TInlet]):
    var linkIndex: Int32 = Int32(0)
    var t: Int32 = Int32(0)
    var k: Int32 = Int32(0)
    linkIndex = inlet[].linkIndex
    k = G[].Link[unsafe_offset=Int(linkIndex)].subIndex
    G[].SL = G[].Conduit[unsafe_offset=Int(k)].slope
    G[].Beta = G[].Conduit[unsafe_offset=Int(k)].beta
    G[].xsect = rt.addr(G[].Link[unsafe_offset=Int(linkIndex)].xsect)
    if (G[].xsect[].type == Int32(25)):
        t = G[].xsect[].transect
        G[].Sx = G[].Street[unsafe_offset=Int(t)].slope
        G[].a = G[].Street[unsafe_offset=Int(t)].gutterDepression
        G[].W = G[].Street[unsafe_offset=Int(t)].gutterWidth
        G[].n = G[].Street[unsafe_offset=Int(t)].roughness
        G[].Nsides = G[].Street[unsafe_offset=Int(t)].sides
        G[].Tcrown = G[].Street[unsafe_offset=Int(t)].width
        G[].Qfactor = inlet[].flowFactor
        if ((not rt.isnull(inlet)) and ((inlet[].localDepress * inlet[].localWidth) > Float64(0.0))):
            G[].a = (G[].a + inlet[].localDepress)
            G[].W = inlet[].localWidth
        if ((G[].W * G[].a) > Float64(0.0)):
            G[].Sw = (G[].Sx + (G[].a / G[].W))
        else:
            G[].Sw = G[].Sx
    else:
        G[].a = Float64(0.0)
        G[].W = Float64(0.0)
        G[].n = G[].Conduit[unsafe_offset=Int(k)].roughness
        G[].Nsides = Int32(1)
        G[].Sx = Float64(0.01)
        G[].Sw = G[].Sx


# inlet.c:1200
def getFlowSpread(G: P[Globals], Q: Float64) -> Float64:
    var iter: Int32 = Int32(0)
    var f: Float64 = Float64(0.0)
    var f1: Float64 = Float64(0.0)
    var Sr: Float64 = Float64(0.0)
    var Ts1: Float64 = Float64(0.0)
    var Ts2: Float64 = Float64(0.0)
    var Tw: Float64 = Float64(0.0)
    var Qs: Float64 = Float64(0.0)
    var Eo: Float64 = Float64(0.0)
    f = G[].Qfactor
    if (G[].a == Float64(0.0)):
        Ts1 = rt.pow((Q / f), Float64(0.375))
    else:
        f1 = (f * rt.pow(((G[].a / G[].W) / G[].Sx), Float64(1.67)))
        Tw = rt.pow((Q / f1), Float64(0.375))
        if (Tw <= G[].W):
            Ts1 = Tw
        else:
            Sr = ((G[].Sx + (G[].a / G[].W)) / G[].Sx)
            iter = Int32(1)
            Ts1 = (rt.pow((Q / f), Float64(0.375)) - G[].W)
            if (Ts1 <= Float64(0.0)):
                Ts1 = (Tw - G[].W)
            while (iter < Int32(11)):
                Eo = getEo(G, Sr, Ts1, G[].W)
                Qs = ((Float64(1.0) - Eo) * Q)
                Ts2 = rt.pow((Qs / f), Float64(0.375))
                if (rt.fabs((Ts2 - Ts1)) < Float64(0.01)):
                    break
                Ts1 = Ts2
                iter += 1
            Ts1 = (Ts2 + G[].W)
    return (Ts1 if (Ts1 <= G[].Tcrown) else G[].Tcrown)


# inlet.c:1248
def getEo(G: P[Globals], Sr: Float64, Ts: Float64, w: Float64) -> Float64:
    var x: Float64 = Float64(0.0)
    x = (Sr / (Ts / w))
    x = (rt.pow((Float64(1.0) + x), Float64(2.67)) - Float64(1.0))
    x = (Float64(1.0) + (Sr / x))
    return (Float64(1.0) / x)


# inlet.c:1267
def getOnGradeCapturedFlow(G: P[Globals], inlet: P[TInlet], q: Float64, d: Float64) -> Float64:
    var i: Int32 = Int32(0)
    var linkIndex: Int32 = Int32(0)
    var qApproach: Float64 = Float64(0.0)
    var qc: Float64 = Float64(0.0)
    var qCaptured: Float64 = Float64(0.0)
    var qBypassed: Float64 = Float64(0.0)
    var qMax: Float64 = Float64(0.0)
    if (inlet[].numInlets == Int32(0)):
        return Float64(0.0)
    linkIndex = inlet[].linkIndex
    qApproach = q
    if (qApproach < Float64(0.001)):
        return Float64(0.0)
    getConduitGeometry(G, inlet)
    qApproach = (qApproach / Float64(G[].Nsides))
    qBypassed = qApproach
    qCaptured = Float64(0.0)
    qMax = Float64(10000000000.0)
    if (inlet[].flowLimit > Float64(0.0)):
        qMax = inlet[].flowLimit
    i = Int32(1)
    while (i <= inlet[].numInlets):
        qc = (getOnGradeInletCapture(G, inlet[].designIndex, qBypassed, d) * inlet[].clogFactor)
        qc = (qc if (qc <= qMax) else qMax)
        qc = (qc if (qc <= qBypassed) else qBypassed)
        qCaptured = (qCaptured + qc)
        qBypassed = (qBypassed - qc)
        if (qBypassed < Float64(0.001)):
            break
        i += 1
    return rt.set(qCaptured, (qCaptured * Float64(G[].Nsides)))


# inlet.c:1325
def getOnGradeInletCapture(G: P[Globals], i: Int32, Q: Float64, d: Float64) -> Float64:
    var Q1: Float64 = Float64(0.0)
    var Qc: Float64 = Float64(0.0)
    var Lsweep: Float64 = Float64(0.0)
    var Lcurb: Float64 = Float64(0.0)
    var Lgrate: Float64 = Float64(0.0)
    Q1 = Q
    Qc = Float64(0.0)
    Lsweep = Float64(0.0)
    Lcurb = Float64(0.0)
    Lgrate = Float64(0.0)
    if (G[].InletDesigns[unsafe_offset=Int(i)].type == Int32(5)):
        Qc = getOnSagInletCapture(G, i, d)
        return (Qc if (Qc <= Q) else Q)
    if (G[].InletDesigns[unsafe_offset=Int(i)].type == Int32(4)):
        Qc = getGrateInletCapture(G, i, Q)
        return (Qc if (Qc <= Q) else Q)
    G[].T = getFlowSpread(G, Q)
    if (G[].InletDesigns[unsafe_offset=Int(i)].type == Int32(3)):
        Qc = getCurbInletCapture(G, Q, G[].InletDesigns[unsafe_offset=Int(i)].slottedInlet.length)
        return (Qc if (Qc <= Q) else Q)
    Lcurb = G[].InletDesigns[unsafe_offset=Int(i)].curbInlet.length
    Lgrate = G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.length
    if (Lcurb > Float64(0.0)):
        Lsweep = (Lcurb - Lgrate)
        if (Lsweep > Float64(0.0)):
            Qc = getCurbInletCapture(G, Q1, Lsweep)
            Q1 = (Q1 - Qc)
    if ((Lgrate > Float64(0.0)) and (Q1 > Float64(0.0))):
        if (Q1 != Q):
            G[].T = getFlowSpread(G, Q1)
        Qc = (Qc + getGrateInletCapture(G, i, Q1))
    return Qc


# inlet.c:1387
def getGrateInletCapture(G: P[Globals], i: Int32, Q: Float64) -> Float64:
    var grateType: Int32 = Int32(0)
    var Lg: Float64 = Float64(0.0)
    var Wg: Float64 = Float64(0.0)
    var A: Float64 = Float64(0.0)
    var Y_2: Float64 = Float64(0.0)
    var Eo: Float64 = Float64(0.0)
    var V: Float64 = Float64(0.0)
    var Vo: Float64 = Float64(0.0)
    var Qo: Float64 = Float64(0.0)
    var Rf: Float64 = Float64(0.0)
    var Rs: Float64 = Float64(0.0)
    Qo = Q
    Rf = Float64(1.0)
    Rs = Float64(0.0)
    Lg = G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.length
    Wg = G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.width
    if ((G[].xsect[].type == Int32(5)) or (G[].xsect[].type == Int32(4))):
        A = xsect_getAofS(G, G[].xsect, (Q / G[].Beta))
        Y_2 = xsect_getYofA(G, G[].xsect, A)
        G[].T = xsect_getWofY(G, G[].xsect, Y_2)
        Eo = (((G[].Beta * rt.pow((Y_2 * Wg), Float64(1.67))) / rt.pow((Wg + (Float64(2.0) * Y_2)), Float64(0.67))) / Q)
        if (((Wg > (Float64(0.99) * G[].xsect[].yBot)) and (G[].xsect[].type == Int32(5))) and (G[].xsect[].sBot > Float64(0.0))):
            Wg = G[].xsect[].yBot
            G[].Sx = (Float64(1.0) / G[].xsect[].sBot)
    elif (G[].a == Float64(0.0)):
        A = (((G[].T * G[].T) * G[].Sx) / Float64(2.0))
        Eo = getGutterFlowRatio(G, Wg)
        if (G[].T >= G[].Tcrown):
            Qo = (G[].Qfactor * rt.pow(G[].Tcrown, Float64(2.67)))
    else:
        if (G[].T <= G[].W):
            A = (((G[].T * G[].T) * G[].Sw) / Float64(2.0))
        else:
            A = ((((G[].T * G[].T) * G[].Sx) + (G[].a * G[].W)) / Float64(2.0))
        Eo = getGutterFlowRatio(G, G[].W)
        if (Eo < Float64(1.0)):
            if (G[].T >= G[].Tcrown):
                Qo = ((G[].Qfactor * rt.pow(G[].Tcrown, Float64(2.67))) / (Float64(1.0) - Eo))
            Eo = (Eo * getGutterAreaRatio(G, Wg, A))
    V = (Qo / A)
    grateType = G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.type
    if ((grateType < Int32(0)) or (grateType == Int32(7))):
        Vo = G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.splashVeloc
    else:
        Vo = getSplashOverVelocity(G, grateType, Lg)
    if (V > Vo):
        Rf = (Float64(1.0) - (Float64(0.09) * (V - Vo)))
    if (Eo < Float64(1.0)):
        Rs = (Float64(1.0) / (Float64(1.0) + (((Float64(0.15) * rt.pow(V, Float64(1.8))) / G[].Sx) / rt.pow(Lg, Float64(2.3)))))
    return (Q * ((Rf * Eo) + (Rs * (Float64(1.0) - Eo))))


# inlet.c:1477
def getCurbInletCapture(G: P[Globals], Q: Float64, L: Float64) -> Float64:
    var Se: Float64 = Float64(0.0)
    var Lt: Float64 = Float64(0.0)
    var Sr: Float64 = Float64(0.0)
    var Eo: Float64 = Float64(0.0)
    var E: Float64 = Float64(0.0)
    Se = G[].Sx
    Eo = Float64(0.0)
    E = Float64(1.0)
    if (G[].a > Float64(0.0)):
        Sr = (G[].Sw / G[].Sx)
        Eo = getEo(G, Sr, (G[].T - G[].W), G[].W)
        Se = (G[].Sx + ((G[].a / G[].W) * Eo))
    Lt = (((Float64(0.6) * rt.pow(Q, Float64(0.42))) * rt.pow(G[].SL, Float64(0.3))) * rt.pow((Float64(1.0) / (G[].n * Se)), Float64(0.6)))
    if (L < Lt):
        E = (Float64(1.0) - (L / Lt))
        E = (Float64(1.0) - rt.pow(E, Float64(1.8)))
    E = (E if (E <= (Float64(1.0))) else (Float64(1.0)))
    E = (E if (E >= (Float64(0.0))) else (Float64(0.0)))
    return (E * Q)


# inlet.c:1518
def getGutterFlowRatio(G: P[Globals], w: Float64) -> Float64:
    if (G[].T <= w):
        return Float64(1.0)
    elif (G[].a > Float64(0.0)):
        return getEo(G, (G[].Sw / G[].Sx), (G[].T - w), w)
    else:
        return (Float64(1.0) - rt.pow((Float64(1.0) - (w / G[].T)), Float64(2.67)))
    return Float64(0.0)


# inlet.c:1535
def getGutterAreaRatio(G: P[Globals], Wg: Float64, A: Float64) -> Float64:
    var As: Float64 = Float64(0.0)
    var Ag: Float64 = Float64(0.0)
    if (Wg >= G[].W):
        return Float64(1.0)
    if (G[].T <= Wg):
        return Float64(1.0)
    if (G[].T <= G[].W):
        return (Wg / G[].T)
    As = ((Float64(0.5) * ((G[].T - G[].W) * (G[].T - G[].W))) * G[].Sx)
    Ag = (Wg * (((G[].T * G[].Sx) + G[].a) - ((Wg * G[].Sw) / Float64(2.0))))
    return (Ag / (A - As))


