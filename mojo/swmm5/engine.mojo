def getFluxes(G: P[Globals], theta: Float64, var lowerDepth: Float64):
    var upperDepth: Float64 = Float64(0.0)
    lowerDepth = (lowerDepth if (lowerDepth >= (Float64(0.0))) else (Float64(0.0)))
