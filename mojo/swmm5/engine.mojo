    if (x < Float64(0.0)):
        x = Float64(0.0)
    if (x > Float64(1.0)):
        x = Float64(1.0)
    return x


# xsect.c:1571
def locate(G: P[Globals], y: Float64, table: P[Float64], jLast: Int32) -> Int32:
    var j: Int32 = Int32(0)
    var j1: Int32 = Int32(0)
    var j2: Int32 = Int32(0)
