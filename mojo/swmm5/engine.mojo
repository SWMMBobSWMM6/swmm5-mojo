                report_writeWarningMsg(G, rt.s("WARNING 10: crest elevation raised to downstream invert for regulator Link"), G[].Link[unsafe_offset=Int(j)].ID)
            else:
                report_writeWarningMsg(G, rt.s("WARNING 10: crest elevation is below downstream invert for regulator Link"), G[].Link[unsafe_offset=Int(j)].ID)
