        _ = rt.fprintf(G[].Frpt.file, rt.s("  %5d"), rt.ai(inlet[].numInlets))
        fp = (Float64(inlet[].stats.flowPeriods) / Float64(100.0))
        if (fp > Float64(0.0)):
            cp = (Float64(inlet[].stats.capturePeriods) / Float64(100.0))
            _ = rt.fprintf(G[].Frpt.file, rt.s("  %7.2f"), rt.ad(inlet[].stats.peakFlowCapture))
            if (cp > Float64(0.0)):
                afc = (inlet[].stats.avgFlowCapture / cp)
                bpf = (inlet[].stats.bypassFreq / cp)
            _ = rt.fprintf(G[].Frpt.file, rt.s("  %7.2f"), rt.ad(afc))
            _ = rt.fprintf(G[].Frpt.file, rt.s("  %7.2f"), rt.ad(bpf))
            _ = rt.fprintf(G[].Frpt.file, rt.s("  %7.2f"), rt.ad((Float64(inlet[].stats.backflowPeriods) / fp)))
            _ = rt.fprintf(G[].Frpt.file, rt.s("  %7.2f"), rt.ad((((((maxFlow / Float64(G[].Street[unsafe_offset=Int(t)].sides)) * UCF(G, Int32(10))) * Float64(0.01)) * inlet[].stats.peakFlowCapture) / Float64(inlet[].numInlets))))
            _ = rt.fprintf(G[].Frpt.file, rt.s("  %7.2f"), rt.ad((((maxFlow * UCF(G, Int32(10))) * Float64(0.01)) * (Float64(100.0) - inlet[].stats.peakFlowCapture))))


