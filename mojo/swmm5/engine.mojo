            subarea[].depth = G[].Dstore
        if ((G[].Alpha > Float64(0.0)) and (tx > Float64(0.0))):
            G[].theSubarea = subarea
            _ = odesolve_integrate(G, rt.addr(subarea[].depth), Int32(1), Float64(0.0), tx, G[].ODETOL, tx, Int32(16))
        else:
