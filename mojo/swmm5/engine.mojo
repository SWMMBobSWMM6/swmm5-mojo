# statsrpt.c:403
def writeNodeSurcharge(G: P[Globals]):
    var j: Int32 = Int32(0)
    var n: Int32 = Int32(0)
    var t: Float64 = Float64(0.0)
    var d1: Float64 = Float64(0.0)
    var d2: Float64 = Float64(0.0)
    n = Int32(0)
    report_writeLine(G, rt.s(""))
    report_writeLine(G, rt.s("**********************"))
    report_writeLine(G, rt.s("Node Surcharge Summary"))
    report_writeLine(G, rt.s("**********************"))
    report_writeLine(G, rt.s(""))
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        if (G[].Node[unsafe_offset=Int(j)].type == Int32(1)):
            j += 1
            continue
        if (G[].NodeStats[unsafe_offset=Int(j)].timeSurcharged == Float64(0.0)):
            j += 1
            continue
        t = ((Float64(0.01)) if ((Float64(0.01)) >= (G[].NodeStats[unsafe_offset=Int(j)].timeSurcharged / Float64(3600.0))) else (G[].NodeStats[unsafe_offset=Int(j)].timeSurcharged / Float64(3600.0)))
        if (n == Int32(0)):
            report_writeLine(G, rt.s("Surcharging occurs when water rises above the top of the highest conduit."))
            _ = rt.fprintf(G[].Frpt.file, rt.s("\n  ---------------------------------------------------------------------\n                                               Max. Height   Min. Depth\n                                   Hours       Above Crown    Below Rim"))
            if (G[].UnitSystem == Int32(0)):
                _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Node                 Type      Surcharged           Feet         Feet"))
            else:
                _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Node                 Type      Surcharged         Meters       Meters"))
            _ = rt.fprintf(G[].Frpt.file, rt.s("\n  ---------------------------------------------------------------------"))
            n = Int32(1)
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  %-20s"), rt.astr(G[].Node[unsafe_offset=Int(j)].ID))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" %-9s"), rt.astr(G[].NodeTypeWords[unsafe_offset=Int(G[].Node[unsafe_offset=Int(j)].type)]))
        d1 = ((G[].NodeStats[unsafe_offset=Int(j)].maxDepth + G[].Node[unsafe_offset=Int(j)].invertElev) - G[].Node[unsafe_offset=Int(j)].crownElev)
        if (d1 < Float64(0.0)):
            d1 = Float64(0.0)
        d2 = (G[].Node[unsafe_offset=Int(j)].fullDepth - G[].NodeStats[unsafe_offset=Int(j)].maxDepth)
        if (d2 < Float64(0.0)):
            d2 = Float64(0.0)
        _ = rt.fprintf(G[].Frpt.file, rt.s("  %9.2f      %9.3f    %9.3f"), rt.ad(t), rt.ad((d1 * UCF(G, Int32(3)))), rt.ad((d2 * UCF(G, Int32(3)))))
        j += 1
    if (n == Int32(0)):
        report_writeLine(G, rt.s("No nodes were surcharged."))
    report_writeLine(G, rt.s(""))


