def iface_saveOutletResults(G: P[Globals], reportDate: Float64, file: P[rt.FILE]):
    var i: Int32 = Int32(0)
    var p: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var yr = rt.salloc[Int32](G[].R_, 1)
    var mon = rt.salloc[Int32](G[].R_, 1)
    var day = rt.salloc[Int32](G[].R_, 1)
    var hr = rt.salloc[Int32](G[].R_, 1)
    var min_2 = rt.salloc[Int32](G[].R_, 1)
    var sec = rt.salloc[Int32](G[].R_, 1)
    var theDate = rt.salloc[Int8](G[].R_, 26)
    datetime_decodeDate(G, reportDate, yr, mon, day)
    datetime_decodeTime(G, reportDate, hr, min_2, sec)
    _ = rt.snprintf(theDate, UInt64(26), rt.s(" %04d %02d  %02d  %02d  %02d  %02d "), rt.ai(yr[]), rt.ai(mon[]), rt.ai(day[]), rt.ai(hr[]), rt.ai(min_2[]), rt.ai(sec[]))
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=2]):
        if (not (isOutletNode(G, i) != 0)):
            i += 1
            continue
        _ = rt.fprintf(file, rt.s("\n%-16s"), rt.astr(G[].Node[unsafe_offset=Int(i)].ID))
        _ = rt.fprintf(file, rt.s("%s"), rt.astr(theDate))
        _ = rt.fprintf(file, rt.s(" %-10f"), rt.ad((G[].Node[unsafe_offset=Int(i)].inflow * UCF(G, Int32(10)))))
        p = Int32(0)
        while (p < G[].Nobjects[unsafe_offset=4]):
            _ = rt.fprintf(file, rt.s(" %-10f"), rt.ad((G[].Node[unsafe_offset=Int(i)].newQual)[unsafe_offset=Int(p)]))
            p += 1
        i += 1
    G[].R_[].sp = __sp


# iface.c:313
def openFileForOutput(G: P[Globals]):
    var i: Int32 = Int32(0)
    var n: Int32 = Int32(0)
    G[].Foutflows.file = rt.fopen(rt.addr(G[].Foutflows.name).unsafe_bitcast[Int8](), rt.s("wt"))
    if (Int(G[].Foutflows.file) == Int((rt.null[NoneType]()).unsafe_bitcast[rt.FILE]())):
        report_writeErrorMsg(G, Int32(351), rt.addr(G[].Foutflows.name).unsafe_bitcast[Int8]())
        return
    _ = rt.fprintf(G[].Foutflows.file, rt.s("SWMM5 Interface File"))
    _ = rt.fprintf(G[].Foutflows.file, rt.s("\n%s"), rt.astr(G[].Title.unsafe_offset(0)))
    _ = rt.fprintf(G[].Foutflows.file, rt.s("\n%-4d - reporting time step in sec"), rt.ai(G[].ReportStep))
    _ = rt.fprintf(G[].Foutflows.file, rt.s("\n%-4d - number of constituents as listed below:"), rt.ai((G[].Nobjects[unsafe_offset=4] + Int32(1))))
    _ = rt.fprintf(G[].Foutflows.file, rt.s("\nFLOW %s"), rt.astr(G[].FlowUnitWords[unsafe_offset=Int(G[].FlowUnits)]))
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=4]):
        _ = rt.fprintf(G[].Foutflows.file, rt.s("\n%s %s"), rt.astr(G[].Pollut[unsafe_offset=Int(i)].ID), rt.astr(G[].QualUnitsWords[unsafe_offset=Int(G[].Pollut[unsafe_offset=Int(i)].units)]))
        i += 1
    n = Int32(0)
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=2]):
        if (isOutletNode(G, i) != 0):
            n += 1
        i += 1
    _ = rt.fprintf(G[].Foutflows.file, rt.s("\n%-4d - number of nodes as listed below:"), rt.ai(n))
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=2]):
        if (isOutletNode(G, i) != 0):
            _ = rt.fprintf(G[].Foutflows.file, rt.s("\n%s"), rt.astr(G[].Node[unsafe_offset=Int(i)].ID))
        i += 1
    _ = rt.fprintf(G[].Foutflows.file, rt.s("\nNode             Year Mon Day Hr  Min Sec FLOW      "))
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=4]):
        _ = rt.fprintf(G[].Foutflows.file, rt.s(" %-10s"), rt.astr(G[].Pollut[unsafe_offset=Int(i)].ID))
        i += 1
    if (G[].ReportStart == G[].StartDateTime):
        iface_saveOutletResults(G, G[].ReportStart, G[].Foutflows.file)


