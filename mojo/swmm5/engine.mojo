    var topWidth: Float64 = Float64(0.0)
    var evapLossRate: Float64 = Float64(0.0)
    var seepLossRate: Float64 = Float64(0.0)
    var totalLossRate: Float64 = Float64(0.0)
    depth = (Float64(0.5) * (G[].Link[unsafe_offset=Int(j)].oldDepth + G[].Link[unsafe_offset=Int(j)].newDepth))
    evapLossRate = Float64(0.0)
    seepLossRate = Float64(0.0)
    totalLossRate = Float64(0.0)
