        if ((massbal_getFlowError(G) > G[].MAX_FLOW_BALANCE_ERR) or (Int32(G[].RptFlags.continuity) == Int32(1))):
            report_writeFlowError(G, rt.addr(G[].FlowTotals))
        if ((G[].Nobjects[unsafe_offset=4] > Int32(0)) and (not (G[].IgnoreQuality != 0))):
            if ((massbal_getQualError(G) > G[].MAX_FLOW_BALANCE_ERR) or (Int32(G[].RptFlags.continuity) == Int32(1))):
                report_writeQualError(G, G[].QualTotals)


