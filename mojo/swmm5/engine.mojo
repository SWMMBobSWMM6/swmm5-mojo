# iface.c:187
def iface_getNumIfaceNodes(G: P[Globals], currentDate: Float64) -> Int32:
    if (G[].OldIfaceDate > currentDate):
        return Int32(0)
    while ((G[].NewIfaceDate < currentDate) and (G[].NewIfaceDate != Float64(-693594.0))):
        setOldIfaceValues(G)
        readNewIfaceValues(G)
    if (G[].NewIfaceDate == Float64(-693594.0)):
        return Int32(0)
    G[].IfaceFrac = ((currentDate - G[].OldIfaceDate) / (G[].NewIfaceDate - G[].OldIfaceDate))
    G[].IfaceFrac = ((Float64(0.0)) if ((Float64(0.0)) >= G[].IfaceFrac) else G[].IfaceFrac)
    G[].IfaceFrac = (G[].IfaceFrac if (G[].IfaceFrac <= (Float64(1.0))) else (Float64(1.0)))
    return G[].NumIfaceNodes


