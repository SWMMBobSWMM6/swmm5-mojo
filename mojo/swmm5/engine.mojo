# routing.c:929
def sortEvents(G: P[Globals]):
    var i: Int32 = Int32(0)
    var j: Int32 = Int32(0)
    var gap: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var temp = rt.salloc[TEvent](G[].R_, 1)
    gap = rt.idiv32(G[].NumEvents, Int32(2))
    while (gap >= Int32(1)):
        i = gap
        while (i < G[].NumEvents):
            temp[] = (G[].Event[unsafe_offset=Int(i)]).copy()
            j = (i - gap)
            while ((j >= Int32(0)) and (G[].Event[unsafe_offset=Int(j)].start > temp[].start)):
                G[].Event[unsafe_offset=Int((j + gap))] = (G[].Event[unsafe_offset=Int(j)]).copy()
                j -= gap
            if (j != (i - gap)):
                G[].Event[unsafe_offset=Int((j + gap))] = temp[].copy()
            i += gap
        gap = rt.idiv32(gap, Int32(2))
    i = Int32(0)
    while (i < (G[].NumEvents - Int32(1))):
        if (G[].Event[unsafe_offset=Int(i)].end > G[].Event[unsafe_offset=Int((i + Int32(1)))].start):
            G[].Event[unsafe_offset=Int(i)].end = G[].Event[unsafe_offset=Int((i + Int32(1)))].start
        i += 1
    G[].R_[].sp = __sp


# runoff.c:82
def runoff_open(G: P[Globals]) -> Int32:
