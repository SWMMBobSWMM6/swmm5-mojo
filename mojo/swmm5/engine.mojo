    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  %-16s"), rt.astr(G[].Link[unsafe_offset=Int(link)].ID))
    _ = rt.fprintf(G[].Frpt.file, rt.s(" %9.3f"), rt.ad((maxFlow * UCF(G, Int32(10)))))
    _ = rt.fprintf(G[].Frpt.file, rt.s(" %9.3f"), rt.ad((maxSpread * UCF(G, Int32(3)))))
    _ = rt.fprintf(G[].Frpt.file, rt.s(" %9.3f"), rt.ad((maxDepth * UCF(G, Int32(3)))))
    if (not rt.isnull(inlet)):
        _ = rt.fprintf(G[].Frpt.file, rt.s("  %-16s"), rt.astr(G[].InletDesigns[unsafe_offset=Int(inlet[].designIndex)].ID))
        placement = getInletPlacement(G, inlet, G[].Link[unsafe_offset=Int(inlet[].linkIndex)].node2)
        if (placement == Int32(1)):
            _ = rt.fprintf(G[].Frpt.file, rt.s("  ON-GRADE"))
