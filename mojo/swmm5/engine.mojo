            seepLossRate = ((seepLossRate * q) / totalLossRate)
            totalLossRate = q
    G[].Conduit[unsafe_offset=Int(G[].Link[unsafe_offset=Int(j)].subIndex)].evapLossRate = evapLossRate
    G[].Conduit[unsafe_offset=Int(G[].Link[unsafe_offset=Int(j)].subIndex)].seepLossRate = seepLossRate
    return totalLossRate


