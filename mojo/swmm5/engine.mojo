# stats.c:756
def stats_findMaxStats(G: P[Globals]):
    var j: Int32 = Int32(0)
    var x: Float64 = Float64(0.0)
    var z: Float64 = Float64(0.0)
    var stepCount: Float64 = Float64(0.0)
    j = Int32(0)
    while (j < Int32(5)):
        G[].MaxMassBalErrs[unsafe_offset=Int(j)].objType = Int32(2)
        G[].MaxMassBalErrs[unsafe_offset=Int(j)].index = Int32(-1)
        G[].MaxMassBalErrs[unsafe_offset=Int(j)].value = Float64(-1.0)
        G[].MaxCourantCrit[unsafe_offset=Int(j)].index = Int32(-1)
        G[].MaxCourantCrit[unsafe_offset=Int(j)].value = Float64(-1.0)
        G[].MaxFlowTurns[unsafe_offset=Int(j)].index = Int32(-1)
        G[].MaxFlowTurns[unsafe_offset=Int(j)].value = Float64(-1.0)
        G[].MaxNonConverged[unsafe_offset=Int(j)].index = Int32(-1)
        G[].MaxNonConverged[unsafe_offset=Int(j)].value = Float64(0.0)
        j += 1
    if (G[].ReportStepCount > Int64(2)):
        stepCount = Float64(G[].ReportStepCount)
        z = (Float64(100.0) / ((Float64(2.0) / Float64(3.0)) * (stepCount - Float64(2.0))))
        j = Int32(0)
        while (j < G[].Nobjects[unsafe_offset=3]):
            x = (Float64(G[].LinkStats[unsafe_offset=Int(j)].flowTurns) * z)
            stats_updateMaxStats(G, G[].MaxFlowTurns, Int32(3), j, x)
            j += 1
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        if (G[].Node[unsafe_offset=Int(j)].degree <= Int32(0)):
            j += 1
            continue
        if (G[].NodeInflow[unsafe_offset=Int(j)] <= Float64(0.1)):
            j += 1
            continue
        if (G[].NodeInflow[unsafe_offset=Int(j)] > Float64(0.0)):
            x = (Float64(1.0) - (G[].NodeOutflow[unsafe_offset=Int(j)] / G[].NodeInflow[unsafe_offset=Int(j)]))
        elif (G[].NodeOutflow[unsafe_offset=Int(j)] > Float64(0.0)):
            x = Float64(-1.0)
        else:
            x = Float64(0.0)
        stats_updateMaxStats(G, G[].MaxMassBalErrs, Int32(2), j, (Float64(100.0) * x))
        j += 1
    stepCount = Float64(G[].TimeStepStats.timeStepCount)
    if (G[].RouteModel == Int32(4)):
        j = Int32(0)
        while (j < G[].Nobjects[unsafe_offset=2]):
            stats_updateMaxStats(G, G[].MaxNonConverged, Int32(2), j, (Float64(G[].NodeStats[unsafe_offset=Int(j)].nonConvergedCount) / stepCount))
            j += 1
    if ((G[].RouteModel != Int32(4)) or (G[].CourantFactor == Float64(0.0))):
        return
    if (stepCount == Float64(0.0)):
        return
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        x = (G[].NodeStats[unsafe_offset=Int(j)].timeCourantCritical / stepCount)
        stats_updateMaxStats(G, G[].MaxCourantCrit, Int32(2), j, (Float64(100.0) * x))
        j += 1
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=3]):
        x = (G[].LinkStats[unsafe_offset=Int(j)].timeCourantCritical / stepCount)
        stats_updateMaxStats(G, G[].MaxCourantCrit, Int32(3), j, (Float64(100.0) * x))
        j += 1


# stats.c:841
def stats_updateMaxStats(G: P[Globals], maxStats: P[TMaxStats], i: Int32, j: Int32, x: Float64):
    var k: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var maxStats1 = rt.salloc[TMaxStats](G[].R_, 1)
    var maxStats2 = rt.salloc[TMaxStats](G[].R_, 1)
    maxStats1[].objType = i
    maxStats1[].index = j
    maxStats1[].value = x
    k = Int32(0)
    while (k < Int32(5)):
        if (rt.fabs(maxStats1[].value) > rt.fabs(maxStats[unsafe_offset=Int(k)].value)):
            maxStats2[] = (maxStats[unsafe_offset=Int(k)]).copy()
            maxStats[unsafe_offset=Int(k)] = maxStats1[].copy()
            maxStats1[] = maxStats2[].copy()
        k += 1
    G[].R_[].sp = __sp


# statsrpt.c:84
def statsrpt_writeReport(G: P[Globals]):
    if ((G[].FlowUnits == Int32(2)) or (G[].FlowUnits == Int32(3))):
        _ = sstrncpy(G, G[].FlowFmt, rt.s("%9.3f"), UInt64(5))
    else:
        _ = sstrncpy(G, G[].FlowFmt, rt.s("%9.2f"), UInt64(5))
    if (G[].UnitSystem == Int32(0)):
        G[].Vcf = (Float64(7.48) / Float64(1000000.0))
    else:
        G[].Vcf = (Float64(28.317) / Float64(1000000.0))
    if (G[].Nobjects[unsafe_offset=1] > Int32(0)):
        if (((not (G[].IgnoreRainfall != 0)) or ((G[].Nobjects[unsafe_offset=13] > Int32(0)) and (not (G[].IgnoreSnowmelt != 0)))) or ((G[].Nobjects[unsafe_offset=11] > Int32(0)) and (not (G[].IgnoreGwater != 0)))):
            writeSubcatchRunoff(G)
            lid_writeWaterBalance(G)
            if (not (G[].IgnoreGwater != 0)):
                writeGroundwater(G)
            if ((G[].Nobjects[unsafe_offset=4] > Int32(0)) and (not (G[].IgnoreQuality != 0))):
                writeSubcatchLoads(G)
    if ((G[].Nobjects[unsafe_offset=3] > Int32(0)) and (not (G[].IgnoreRouting != 0))):
        writeNodeDepths(G)
        writeNodeFlows(G)
        if (G[].RouteModel == Int32(4)):
            writeNodeSurcharge(G)
        writeNodeFlooding(G)
        writeStorageVolumes(G)
        writeOutfallLoads(G)
        inlet_writeStatsReport(G)
        writeLinkFlows(G)
        writeFlowClass(G)
        writeLinkSurcharge(G)
        writePumpFlows(G)
        if ((G[].Nobjects[unsafe_offset=4] > Int32(0)) and (not (G[].IgnoreQuality != 0))):
            writeLinkLoads(G)


