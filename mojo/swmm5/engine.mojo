        k = Int8(1)
    else:
        k = Int8(2)
        t = Int32(1)
        while (t < ntoks):
            j = project_findObject(G, m, tok[unsafe_offset=Int(t)])
            if (j < Int32(0)):
                return error_setInpError(G, Int32(209), tok[unsafe_offset=Int(t)])
            __sw3 = m
            if __sw3 == Int32(1):
                G[].Subcatch[unsafe_offset=Int(j)].rptFlag = Int32(1)
            elif __sw3 == Int32(2):
                G[].Node[unsafe_offset=Int(j)].rptFlag = Int32(1)
            elif __sw3 == Int32(3):
                G[].Link[unsafe_offset=Int(j)].rptFlag = Int32(1)
            t += 1
    __sw4 = m
    if __sw4 == Int32(1):
        G[].RptFlags.subcatchments = k
    elif __sw4 == Int32(2):
        G[].RptFlags.nodes = k
    elif __sw4 == Int32(3):
        G[].RptFlags.links = k
    return Int32(0)


