    return rt.pow((((Float64(3.0) / Float64(4.0)) * a) / xsect[].rBot), (Float64(2.0) / Float64(3.0)))


# xsect.c:2278
def parab_getRofA(G: P[Globals], xsect: P[TXsect], a: Float64) -> Float64:
    if (a <= Float64(0.0)):
        return Float64(0.0)
    return (a / parab_getPofY(G, xsect, parab_getYofA(G, xsect, a)))


# xsect.c:2284
def parab_getPofY(G: P[Globals], xsect: P[TXsect], y: Float64) -> Float64:
    var x: Float64 = Float64(0.0)
    var t: Float64 = Float64(0.0)
    x = ((Float64(2.0) * sqrt(y)) / xsect[].rBot)
    t = sqrt((Float64(1.0) + (x * x)))
    return (((Float64(0.5) * xsect[].rBot) * xsect[].rBot) * ((x * t) + rt.log((x + t))))


# xsect.c:2291
def parab_getAofY(G: P[Globals], xsect: P[TXsect], y: Float64) -> Float64:
    return ((((Float64(4.0) / Float64(3.0)) * xsect[].rBot) * y) * sqrt(y))


# xsect.c:2296
def parab_getRofY(G: P[Globals], xsect: P[TXsect], y: Float64) -> Float64:
    if (y <= Float64(0.0)):
        return Float64(0.0)
    return (parab_getAofY(G, xsect, y) / parab_getPofY(G, xsect, y))


# xsect.c:2302
def parab_getWofY(G: P[Globals], xsect: P[TXsect], y: Float64) -> Float64:
    return ((Float64(2.0) * xsect[].rBot) * sqrt(y))


# xsect.c:2312
def powerfunc_getYofA(G: P[Globals], xsect: P[TXsect], a: Float64) -> Float64:
