    var placement: Int32 = Int32(0)
    var maxSpread: Float64 = Float64(0.0)
    var maxDepth: Float64 = Float64(0.0)
    var maxFlow: Float64 = Float64(0.0)
    var fp: Float64 = Float64(0.0)
    var cp: Float64 = Float64(0.0)
