            lidUnit[].drainSubcatch = G[].Subcatch[unsafe_offset=Int(j)].outSubcatch
        lidList = lidList[].nextLidUnit
    if (totalLidArea > (Float64(1.001) * totalArea)):
        report_writeErrorMsg(G, Int32(187), G[].Subcatch[unsafe_offset=Int(j)].ID)
    if ((fromImperv > Float64(1.001)) or (fromPerv > Float64(1.001))):
        report_writeErrorMsg(G, Int32(188), G[].Subcatch[unsafe_offset=Int(j)].ID)
    if (totalLidArea > (Float64(0.999) * totalArea)):
