    hasGwater = Int32(((G[].Nobjects[unsafe_offset=11] > Int32(0)) and (not (G[].IgnoreGwater != 0))))
    hasQuality = Int32(((G[].Nobjects[unsafe_offset=4] > Int32(0)) and (not (G[].IgnoreQuality != 0))))
    if (G[].Nobjects[unsafe_offset=1] == Int32(0)):
        G[].R_[].sp = __sp
