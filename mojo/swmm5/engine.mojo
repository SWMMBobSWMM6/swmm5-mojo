# exfil.c:34
def exfil_readStorageParams(G: P[Globals], k: Int32, tok: P[P[Int8]], ntoks: Int32, n: Int32) -> Int32:
    var i: Int32 = Int32(0)
    var __rv: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var x = rt.salloc[Float64](G[].R_, 3)
    if (ntoks == (n + Int32(1))):
        if (not (getDouble(G, tok[unsafe_offset=Int(n)], x.unsafe_offset(1)) != 0)):
            __rv = error_setInpError(G, Int32(211), tok[unsafe_offset=Int(n)])
            G[].R_[].sp = __sp
            return __rv
        x[unsafe_offset=0] = Float64(0.0)
        x[unsafe_offset=2] = Float64(0.0)
    elif (ntoks < (n + Int32(3))):
        __rv = error_setInpError(G, Int32(203), rt.s(""))
        G[].R_[].sp = __sp
        return __rv
    else:
        i = Int32(0)
        while (i < Int32(3)):
            if (not (getDouble(G, tok[unsafe_offset=Int((n + i))], x.unsafe_offset(Int(i))) != 0)):
                __rv = error_setInpError(G, Int32(211), tok[unsafe_offset=Int((n + i))])
                G[].R_[].sp = __sp
                return __rv
            i += 1
    if (x[unsafe_offset=1] == Float64(0.0)):
        __rv = Int32(0)
        G[].R_[].sp = __sp
        return __rv
    __rv = createStorageExfil(G, k, x)
    G[].R_[].sp = __sp
    return __rv


# exfil.c:74
def exfil_initState(G: P[Globals], k: Int32):
    var i: Int32 = Int32(0)
    var alast: Float64 = Float64(0.0)
    var aCurve: P[TTable] = rt.null[TTable]()
    var exfil: P[TExfil] = rt.null[TExfil]()
    var __sw1: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var a = rt.salloc[Float64](G[].R_, 1)
    var d = rt.salloc[Float64](G[].R_, 1)
    exfil = G[].Storage[unsafe_offset=Int(k)].exfil
    if (Int(exfil) != Int((rt.null[NoneType]()).unsafe_bitcast[TExfil]())):
        grnampt_initState(G, exfil[].btmExfil)
        grnampt_initState(G, exfil[].bankExfil)
        __sw1 = G[].Storage[unsafe_offset=Int(k)].shape
        if __sw1 == Int32(0):
            i = G[].Storage[unsafe_offset=Int(k)].aCurve
            exfil[].btmArea = Float64(0.0)
            exfil[].bankMinDepth = Float64(0.0)
            exfil[].bankMaxDepth = Float64(0.0)
            exfil[].bankMaxArea = Float64(0.0)
            if (i >= Int32(0)):
                aCurve = G[].Curve.unsafe_offset(Int(i))
                (G[].Storage[unsafe_offset=Int(k)].exfil)[].btmArea = table_lookupEx(G, aCurve, Float64(0.0))
                _ = table_getFirstEntry(G, aCurve, d, a)
                alast = a[]
                while (table_getNextEntry(G, aCurve, d, a) != 0):
                    if (a[] < alast):
                        break
                    elif (a[] > alast):
                        exfil[].bankMaxArea = a[]
                        exfil[].bankMaxDepth = d[]
                    elif (exfil[].bankMaxArea == Float64(0.0)):
                        exfil[].bankMinDepth = d[]
                    else:
                        break
                    alast = a[]
                exfil[].btmArea = (exfil[].btmArea / (UCF(G, Int32(3)) * UCF(G, Int32(3))))
                exfil[].bankMaxArea = (exfil[].bankMaxArea / (UCF(G, Int32(3)) * UCF(G, Int32(3))))
                exfil[].bankMinDepth = (exfil[].bankMinDepth / UCF(G, Int32(3)))
                exfil[].bankMaxDepth = (exfil[].bankMaxDepth / UCF(G, Int32(3)))
        elif __sw1 == Int32(1):
            exfil[].btmArea = G[].Storage[unsafe_offset=Int(k)].a0
            if (G[].Storage[unsafe_offset=Int(k)].a2 == Float64(0.0)):
                exfil[].btmArea = (exfil[].btmArea + G[].Storage[unsafe_offset=Int(k)].a1)
            exfil[].bankMinDepth = Float64(0.0)
            exfil[].bankMaxDepth = Float64(10000000000.0)
            exfil[].bankMaxArea = Float64(10000000000.0)
        elif (__sw1 == Int32(2)) or (__sw1 == Int32(3)) or (__sw1 == Int32(5)):
            exfil[].btmArea = G[].Storage[unsafe_offset=Int(k)].a0
            exfil[].bankMinDepth = Float64(0.0)
            exfil[].bankMaxDepth = Float64(10000000000.0)
            exfil[].bankMaxArea = Float64(10000000000.0)
    G[].R_[].sp = __sp


# exfil.c:158
def exfil_getLoss(G: P[Globals], exfil: P[TExfil], tStep: Float64, var depth: Float64, var area: Float64) -> Float64:
    var exfilRate: Float64 = Float64(0.0)
    exfilRate = Float64(0.0)
    if (exfil[].btmExfil[].IMDmax == Float64(0.0)):
        exfilRate = (exfil[].btmExfil[].Ks * G[].Adjust.hydconFactor)
    else:
        exfilRate = grnampt_getInfil(G, exfil[].btmExfil, tStep, Float64(0.0), depth, Int32(3))
    exfilRate = (exfilRate * exfil[].btmArea)
    if (depth > exfil[].bankMinDepth):
        area = ((area if (area <= exfil[].bankMaxArea) else exfil[].bankMaxArea) - exfil[].btmArea)
        if (area > Float64(0.0)):
            if (exfil[].btmExfil[].IMDmax == Float64(0.0)):
                exfilRate = (exfilRate + ((area * exfil[].btmExfil[].Ks) * G[].Adjust.hydconFactor))
            else:
                if (depth > exfil[].bankMaxDepth):
                    depth = ((depth - exfil[].bankMaxDepth) + ((exfil[].bankMaxDepth - exfil[].bankMinDepth) / Float64(2.0)))
                else:
                    depth = ((depth - exfil[].bankMinDepth) / Float64(2.0))
                exfilRate = (exfilRate + (area * grnampt_getInfil(G, exfil[].bankExfil, tStep, Float64(0.0), depth, Int32(3))))
    return exfilRate


# exfil.c:218
def createStorageExfil(G: P[Globals], k: Int32, x: P[Float64]) -> Int32:
    var exfil: P[TExfil] = rt.null[TExfil]()
    exfil = G[].Storage[unsafe_offset=Int(k)].exfil
    if (Int(exfil) == Int((rt.null[NoneType]()).unsafe_bitcast[TExfil]())):
        exfil = (rt.malloc(UInt64(size_of[TExfil]()))).unsafe_bitcast[TExfil]()
        if (Int(exfil) == Int((rt.null[NoneType]()).unsafe_bitcast[TExfil]())):
            return error_setInpError(G, Int32(101), rt.s(""))
        G[].Storage[unsafe_offset=Int(k)].exfil = exfil
        exfil[].btmExfil = (rt.null[NoneType]()).unsafe_bitcast[TGrnAmpt]()
        exfil[].bankExfil = (rt.null[NoneType]()).unsafe_bitcast[TGrnAmpt]()
        exfil[].btmExfil = (rt.malloc(UInt64(size_of[TGrnAmpt]()))).unsafe_bitcast[TGrnAmpt]()
        if (Int(exfil[].btmExfil) == Int((rt.null[NoneType]()).unsafe_bitcast[TGrnAmpt]())):
            return error_setInpError(G, Int32(101), rt.s(""))
        exfil[].bankExfil = (rt.malloc(UInt64(size_of[TGrnAmpt]()))).unsafe_bitcast[TGrnAmpt]()
        if (Int(exfil[].bankExfil) == Int((rt.null[NoneType]()).unsafe_bitcast[TGrnAmpt]())):
            return error_setInpError(G, Int32(101), rt.s(""))
    if (not (grnampt_setParams(G, exfil[].btmExfil, x) != 0)):
        return error_setInpError(G, Int32(211), rt.s(""))
    _ = grnampt_setParams(G, exfil[].bankExfil, x)
    return Int32(0)


# findroot.c:20
def findroot_Newton(G: P[Globals], x1: Float64, x2: Float64, rts: P[Float64], xacc: Float64, func: Int32, p: VP) -> Int32:
    var j: Int32 = Int32(0)
    var n: Int32 = Int32(0)
    var dx: Float64 = Float64(0.0)
    var dxold: Float64 = Float64(0.0)
    var x: Float64 = Float64(0.0)
    var temp: Float64 = Float64(0.0)
    var xhi: Float64 = Float64(0.0)
    var xlo: Float64 = Float64(0.0)
    var __rv: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var df = rt.salloc[Float64](G[].R_, 1)
    var f = rt.salloc[Float64](G[].R_, 1)
    n = Int32(0)
    x = rts[]
    xlo = x1
    xhi = x2
    dxold = rt.fabs((x2 - x1))
    dx = dxold
    __fpcall1(G, func, x, f, df, p)
    n += 1
    j = Int32(1)
    while (j <= Int32(60)):
        if ((((((x - xhi) * df[]) - f[]) * (((x - xlo) * df[]) - f[])) >= Float64(0.0)) or (rt.fabs((Float64(2.0) * f[])) > rt.fabs((dxold * df[])))):
            dxold = dx
            dx = (Float64(0.5) * (xhi - xlo))
            x = (xlo + dx)
            if (xlo == x):
                break
        else:
            dxold = dx
            dx = (f[] / df[])
            temp = x
            x = (x - dx)
            if (temp == x):
                break
        if (rt.fabs(dx) < xacc):
            break
        __fpcall1(G, func, x, f, df, p)
        n += 1
        if (f[] < Float64(0.0)):
            xlo = x
        else:
            xhi = x
        j += 1
    rts[] = x
    if (n <= Int32(60)):
        __rv = n
        G[].R_[].sp = __sp
        return __rv
    else:
        __rv = Int32(0)
        G[].R_[].sp = __sp
        return __rv
    G[].R_[].sp = __sp
    return Int32(0)


