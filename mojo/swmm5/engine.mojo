    while (not rt.isnull(inlet)):
        inletValid = Int32(0)
        i = inlet[].linkIndex
        G[].xsect = rt.addr(G[].Link[unsafe_offset=Int(i)].xsect)
        inletType = G[].InletDesigns[unsafe_offset=Int(inlet[].designIndex)].type
