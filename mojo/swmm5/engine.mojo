    elev2 = (G[].Link[unsafe_offset=Int(j)].offset2 + G[].Node[unsafe_offset=Int(G[].Link[unsafe_offset=Int(j)].node2)].invertElev)
    delta = rt.fabs((elev1 - elev2))
