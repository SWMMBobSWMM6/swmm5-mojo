# link.c:489
def link_getOffsetHeight(G: P[Globals], j: Int32, var offset: Float64, elev: Float64) -> Float64:
    if ((offset <= Float64(-10000000000.0)) or (G[].Link[unsafe_offset=Int(j)].type == Int32(1))):
