# report.c:355
def report_writeRainStats(G: P[Globals], i: Int32, r: P[TRainStats]):
    var __sp = G[].R_[].sp
    var date1 = rt.salloc[Int8](G[].R_, 12)
    var date2 = rt.salloc[Int8](G[].R_, 12)
    rt.init_chars(date1, rt.s("***********"), 11)
    rt.init_chars(date2, rt.s("***********"), 11)
    if (G[].RptFlags.disabled != 0):
        G[].R_[].sp = __sp
        return
    if (i < Int32(0)):
        report_writeLine(G, rt.s(""))
        report_writeLine(G, rt.s("*********************"))
        report_writeLine(G, rt.s("Rainfall File Summary"))
        report_writeLine(G, rt.s("*********************"))
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Station    First        Last         Recording   Periods    Periods    Periods"))
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  ID         Date         Date         Frequency  w/Precip    Missing    Malfunc."))
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  -------------------------------------------------------------------------------"))
    else:
        if (r[].startDate != Float64(-693594.0)):
            datetime_dateToStr(G, r[].startDate, date1)
        if (r[].endDate != Float64(-693594.0)):
            datetime_dateToStr(G, r[].endDate, date2)
        _ = rt.fprintf(G[].Frpt.file, rt.s("%-10s %10s   %-10s   %5d min    %6ld     %6ld     %6ld\n"), rt.astr(rt.addr(G[].Gage[unsafe_offset=Int(i)].staID).unsafe_bitcast[Int8]()), rt.astr(date1), rt.astr(date2), rt.ai(rt.idiv32(G[].Gage[unsafe_offset=Int(i)].rainInterval, Int32(60))), rt.al(r[].periodsRain), rt.al(r[].periodsMissing), rt.al(r[].periodsMalfunc))
    report_writeLine(G, rt.s(""))
    G[].R_[].sp = __sp


# report.c:396
def report_writeRdiiStats(G: P[Globals], rainVol: Float64, rdiiVol: Float64):
    var ratio: Float64 = Float64(0.0)
    var ucf1: Float64 = Float64(0.0)
    var ucf2: Float64 = Float64(0.0)
    if (G[].RptFlags.disabled != 0):
        return
    ucf1 = (UCF(G, Int32(3)) * UCF(G, Int32(4)))
    if (G[].UnitSystem == Int32(0)):
        ucf2 = (Float64(0.64632) / Float64(86400.0))
    else:
        ucf2 = (Float64(2.4466) / Float64(86400.0))
    report_writeLine(G, rt.s(""))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  **********************           Volume        Volume"))
    if (G[].UnitSystem == Int32(0)):
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Rainfall Dependent I/I        acre-feet      10^6 gal"))
    else:
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Rainfall Dependent I/I        hectare-m      10^6 ltr"))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  **********************        ---------     ---------"))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Sewershed Rainfall ......%14.3f%14.3f"), rt.ad((rainVol * ucf1)), rt.ad((rainVol * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  RDII Produced ...........%14.3f%14.3f"), rt.ad((rdiiVol * ucf1)), rt.ad((rdiiVol * ucf2)))
    if (rainVol == Float64(0.0)):
        ratio = Float64(0.0)
    else:
        ratio = (rdiiVol / rainVol)
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  RDII Ratio ..............%14.3f"), rt.ad(ratio))
    report_writeLine(G, rt.s(""))


