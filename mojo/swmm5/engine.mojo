        t2 = (G[].GW[].a2 * rt.pow(((G[].Hsw - G[].Hstar) * UCF(G, Int32(3))), G[].GW[].b2))
    else:
        t2 = Float64(0.0)
    t3 = ((((G[].GW[].a3 * lowerDepth) * G[].Hsw) * UCF(G, Int32(3))) * UCF(G, Int32(3)))
    q = (((t1 - t2) + t3) / UCF(G, Int32(9)))
    if ((q < Float64(0.0)) and (G[].GW[].a3 != Float64(0.0))):
        q = Float64(0.0)
    return q


