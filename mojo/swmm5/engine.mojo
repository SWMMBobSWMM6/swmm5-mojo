def findPondedLoads(G: P[Globals], j: Int32, tStep: Float64):
    var p: Int32 = Int32(0)
    var cPonded: Float64 = Float64(0.0)
    var wPonded: Float64 = Float64(0.0)
    var bmpRemoval: Float64 = Float64(0.0)
    var vRain: Float64 = Float64(0.0)
    var wRain: Float64 = Float64(0.0)
    var wRunon: Float64 = Float64(0.0)
    var wInfil: Float64 = Float64(0.0)
    var wOutflow: Float64 = Float64(0.0)
    var fullArea: Float64 = Float64(0.0)
    var nonLidArea: Float64 = Float64(0.0)
    if (G[].Subcatch[unsafe_offset=Int(j)].area == G[].Subcatch[unsafe_offset=Int(j)].lidArea):
        return
    fullArea = G[].Subcatch[unsafe_offset=Int(j)].area
    nonLidArea = (fullArea - G[].Subcatch[unsafe_offset=Int(j)].lidArea)
    vRain = ((G[].Subcatch[unsafe_offset=Int(j)].rainfall * nonLidArea) * tStep)
    p = Int32(0)
    while (p < G[].Nobjects[unsafe_offset=4]):
        wRain = ((G[].Pollut[unsafe_offset=Int(p)].pptConcen * Float64(28.317)) * vRain)
        massbal_updateLoadingTotals(G, Int32(1), p, (wRain * G[].Pollut[unsafe_offset=Int(p)].mcf))
        if (G[].Vinflow == Float64(0.0)):
            massbal_updateLoadingTotals(G, Int32(6), p, ((G[].Subcatch[unsafe_offset=Int(j)].pondedQual)[unsafe_offset=Int(p)] * G[].Pollut[unsafe_offset=Int(p)].mcf))
            (G[].Subcatch[unsafe_offset=Int(j)].pondedQual)[unsafe_offset=Int(p)] = Float64(0.0)
        else:
            wRunon = ((G[].Subcatch[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] * tStep)
            wPonded = (((G[].Subcatch[unsafe_offset=Int(j)].pondedQual)[unsafe_offset=Int(p)] + wRain) + wRunon)
            cPonded = (wPonded / G[].Vinflow)
            wInfil = (cPonded * G[].Vinfil)
            wInfil = (wInfil if (wInfil <= wPonded) else wPonded)
            massbal_updateLoadingTotals(G, Int32(4), p, (wInfil * G[].Pollut[unsafe_offset=Int(p)].mcf))
            wPonded = (wPonded - wInfil)
            wOutflow = (cPonded * G[].Voutflow)
            wOutflow = (wOutflow if (wOutflow <= wPonded) else wPonded)
            wPonded = (wPonded - wOutflow)
            bmpRemoval = (landuse_getAvgBmpEffic(G, j, p) * wOutflow)
            massbal_updateLoadingTotals(G, Int32(3), p, (bmpRemoval * G[].Pollut[unsafe_offset=Int(p)].mcf))
            wOutflow = (wOutflow - bmpRemoval)
            (G[].Subcatch[unsafe_offset=Int(j)].pondedQual)[unsafe_offset=Int(p)] = ((cPonded * subcatch_getDepth(G, j)) * nonLidArea)
            G[].OutflowLoad[unsafe_offset=Int(p)] = (G[].OutflowLoad[unsafe_offset=Int(p)] + wOutflow)
        p += 1


