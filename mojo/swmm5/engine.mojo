# xsect.c:2317
def powerfunc_getRofA(G: P[Globals], xsect: P[TXsect], a: Float64) -> Float64:
    if (a <= Float64(0.0)):
        return Float64(0.0)
    return (a / powerfunc_getPofY(G, xsect, powerfunc_getYofA(G, xsect, a)))


# xsect.c:2323
def powerfunc_getPofY(G: P[Globals], xsect: P[TXsect], y: Float64) -> Float64:
    var dy1: Float64 = Float64(0.0)
    var h: Float64 = Float64(0.0)
    var m: Float64 = Float64(0.0)
    var p: Float64 = Float64(0.0)
    var y1: Float64 = Float64(0.0)
    var x1: Float64 = Float64(0.0)
    var x2: Float64 = Float64(0.0)
    var y2: Float64 = Float64(0.0)
    var dx: Float64 = Float64(0.0)
    var dy: Float64 = Float64(0.0)
    dy1 = (Float64(0.02) * xsect[].yFull)
    h = (((xsect[].sBot + Float64(1.0)) * xsect[].rBot) / Float64(2.0))
    m = xsect[].sBot
    p = Float64(0.0)
    y1 = Float64(0.0)
    x1 = Float64(0.0)
    while True:
        y2 = (y1 + dy1)
        if (y2 > y):
            y2 = y
        x2 = (h * rt.pow(y2, m))
        dx = (x2 - x1)
        dy = (y2 - y1)
        p = (p + sqrt(((dx * dx) + (dy * dy))))
        x1 = x2
        y1 = y2
        if not (y2 < y):
            break
    return (Float64(2.0) * p)


# xsect.c:2346
def powerfunc_getAofY(G: P[Globals], xsect: P[TXsect], y: Float64) -> Float64:
    return (xsect[].rBot * rt.pow(y, (xsect[].sBot + Float64(1.0))))


# xsect.c:2351
def powerfunc_getRofY(G: P[Globals], xsect: P[TXsect], y: Float64) -> Float64:
    if (y <= Float64(0.0)):
        return Float64(0.0)
    return (powerfunc_getAofY(G, xsect, y) / powerfunc_getPofY(G, xsect, y))


# xsect.c:2357
def powerfunc_getWofY(G: P[Globals], xsect: P[TXsect], y: Float64) -> Float64:
    return (((xsect[].sBot + Float64(1.0)) * xsect[].rBot) * rt.pow(y, xsect[].sBot))


# xsect.c:2367
def circ_getYofA(G: P[Globals], xsect: P[TXsect], a: Float64) -> Float64:
    var alpha: Float64 = Float64(0.0)
    alpha = (a / xsect[].aFull)
    if (alpha < Float64(0.04)):
        return (xsect[].yFull * getYcircular(G, alpha))
    else:
        return (xsect[].yFull * lookup(G, alpha, G[].Y_Circ, G[].N_Y_Circ))
    return Float64(0.0)


# xsect.c:2378
def circ_getAofS(G: P[Globals], xsect: P[TXsect], s: Float64) -> Float64:
    var psi: Float64 = Float64(0.0)
    psi = (s / xsect[].sFull)
    if (psi == Float64(0.0)):
        return Float64(0.0)
    if (psi >= Float64(1.0)):
        return xsect[].aFull
    if (psi <= Float64(0.015)):
        return (xsect[].aFull * getAcircular(G, psi))
    else:
        return (xsect[].aFull * invLookup(G, psi, G[].S_Circ, G[].N_S_Circ))
    return Float64(0.0)


# xsect.c:2391
def circ_getSofA(G: P[Globals], xsect: P[TXsect], a: Float64) -> Float64:
    var alpha: Float64 = Float64(0.0)
    alpha = (a / xsect[].aFull)
    if (alpha < Float64(0.04)):
        return (xsect[].sFull * getScircular(G, alpha))
    else:
        return (xsect[].sFull * lookup(G, alpha, G[].S_Circ, G[].N_S_Circ))
    return Float64(0.0)


# xsect.c:2403
def circ_getdSdA(G: P[Globals], xsect: P[TXsect], a: Float64) -> Float64:
    var alpha: Float64 = Float64(0.0)
    var theta: Float64 = Float64(0.0)
    var p: Float64 = Float64(0.0)
    var r: Float64 = Float64(0.0)
    var dPdA: Float64 = Float64(0.0)
    alpha = (a / xsect[].aFull)
    if (alpha <= Float64(1e-30)):
        return Float64(1e-30)
    elif (alpha < Float64(0.04)):
        theta = getThetaOfAlpha(G, alpha)
        p = ((theta * xsect[].yFull) / Float64(2.0))
        r = (a / p)
        dPdA = ((Float64(4.0) / xsect[].yFull) / (Float64(1.0) - rt.cos(theta)))
        return (((Float64(5.0) / Float64(3.0)) - (((Float64(2.0) / Float64(3.0)) * dPdA) * r)) * rt.pow(r, (Float64(2.0) / Float64(3.0))))
    else:
        return tabular_getdSdA(G, xsect, a, G[].S_Circ, G[].N_S_Circ)
    return Float64(0.0)


# xsect.c:2450
def circ_getAofY(G: P[Globals], xsect: P[TXsect], y: Float64) -> Float64:
    var yNorm: Float64 = Float64(0.0)
    yNorm = (y / xsect[].yFull)
    return (xsect[].aFull * lookup(G, yNorm, G[].A_Circ, G[].N_A_Circ))


# xsect.c:2462
def filled_circ_getYofA(G: P[Globals], xsect: P[TXsect], var a: Float64) -> Float64:
    var y: Float64 = Float64(0.0)
    xsect[].yFull = (xsect[].yFull + xsect[].yBot)
    xsect[].aFull = (xsect[].aFull + xsect[].aBot)
    a = (a + xsect[].aBot)
    y = circ_getYofA(G, xsect, a)
    y = (y - xsect[].yBot)
    xsect[].yFull = (xsect[].yFull - xsect[].yBot)
    xsect[].aFull = (xsect[].aFull - xsect[].aBot)
    return y


# xsect.c:2481
def filled_circ_getAofY(G: P[Globals], xsect: P[TXsect], var y: Float64) -> Float64:
    var a: Float64 = Float64(0.0)
    xsect[].yFull = (xsect[].yFull + xsect[].yBot)
    xsect[].aFull = (xsect[].aFull + xsect[].aBot)
    y = (y + xsect[].yBot)
    a = circ_getAofY(G, xsect, y)
    a = (a - xsect[].aBot)
    xsect[].yFull = (xsect[].yFull - xsect[].yBot)
    xsect[].aFull = (xsect[].aFull - xsect[].aBot)
    return a


# xsect.c:2500
def filled_circ_getRofY(G: P[Globals], xsect: P[TXsect], var y: Float64) -> Float64:
    var a: Float64 = Float64(0.0)
    var r: Float64 = Float64(0.0)
    var p: Float64 = Float64(0.0)
    xsect[].yFull = (xsect[].yFull + xsect[].yBot)
    xsect[].aFull = (xsect[].aFull + xsect[].aBot)
    y = (y + xsect[].yBot)
    a = circ_getAofY(G, xsect, y)
    r = ((Float64(0.25) * xsect[].yFull) * lookup(G, (y / xsect[].yFull), G[].R_Circ, G[].N_R_Circ))
    p = (a / r)
    a = (a - xsect[].aBot)
    p = ((p - xsect[].rBot) + xsect[].sBot)
    r = (a / p)
    xsect[].yFull = (xsect[].yFull - xsect[].yBot)
    xsect[].aFull = (xsect[].aFull - xsect[].aBot)
    return r


# xsect.c:2531
def getYcircular(G: P[Globals], alpha: Float64) -> Float64:
    var theta: Float64 = Float64(0.0)
    if (alpha >= Float64(1.0)):
        return Float64(1.0)
    if (alpha <= Float64(0.0)):
        return Float64(0.0)
    if (alpha <= Float64(1e-05)):
        theta = rt.pow((Float64(37.6911) * alpha), (Float64(1.0) / Float64(3.0)))
        return ((theta * theta) / Float64(16.0))
    theta = getThetaOfAlpha(G, alpha)
    return ((Float64(1.0) - rt.cos((theta / Float64(2.0)))) / Float64(2.0))


# xsect.c:2545
def getScircular(G: P[Globals], alpha: Float64) -> Float64:
    var theta: Float64 = Float64(0.0)
    if (alpha >= Float64(1.0)):
        return Float64(1.0)
    if (alpha <= Float64(0.0)):
        return Float64(0.0)
    if (alpha <= Float64(1e-05)):
        theta = rt.pow((Float64(37.6911) * alpha), (Float64(1.0) / Float64(3.0)))
        return (rt.pow(theta, (Float64(13.0) / Float64(3.0))) / Float64(124.4797))
    theta = getThetaOfAlpha(G, alpha)
    return ((rt.pow((theta - rt.sin(theta)), (Float64(5.0) / Float64(3.0))) / (Float64(2.0) * Float64(3.141592654))) / rt.pow(theta, (Float64(2.0) / Float64(3.0))))


# xsect.c:2559
def getAcircular(G: P[Globals], psi: Float64) -> Float64:
    var theta: Float64 = Float64(0.0)
    if (psi >= Float64(1.0)):
        return Float64(1.0)
    if (psi <= Float64(0.0)):
        return Float64(0.0)
    if (psi <= Float64(1e-06)):
        theta = rt.pow((Float64(124.4797) * psi), (Float64(3.0) / Float64(13.0)))
        return (((theta * theta) * theta) / Float64(37.6911))
    theta = getThetaOfPsi(G, psi)
    return ((theta - rt.sin(theta)) / (Float64(2.0) * Float64(3.141592654)))


# xsect.c:2573
def getThetaOfAlpha(G: P[Globals], alpha: Float64) -> Float64:
    var k: Int32 = Int32(0)
    var theta: Float64 = Float64(0.0)
    var theta1: Float64 = Float64(0.0)
    var ap: Float64 = Float64(0.0)
    var d: Float64 = Float64(0.0)
    if (alpha > Float64(0.04)):
        theta = (Float64(1.2) + ((Float64(5.08) * (alpha - Float64(0.04))) / Float64(0.96)))
    else:
        theta = ((Float64(0.031715) - (Float64(12.79384) * alpha)) + (Float64(8.28479) * sqrt(alpha)))
    theta1 = theta
    ap = ((Float64(2.0) * Float64(3.141592654)) * alpha)
    k = Int32(1)
    while (k <= Int32(40)):
        d = ((-((ap - theta) + rt.sin(theta))) / (Float64(1.0) - rt.cos(theta)))
        if (d > Float64(1.0)):
            d = (rt.fabs(Float64(1.0)) if (d >= Float64(0.0)) else (-(rt.fabs(Float64(1.0)))))
        theta = (theta - d)
        if (rt.fabs(d) <= Float64(0.0001)):
            return theta
        k += 1
    return theta1


# xsect.c:2593
def getThetaOfPsi(G: P[Globals], psi: Float64) -> Float64:
    var k: Int32 = Int32(0)
    var theta: Float64 = Float64(0.0)
    var theta1: Float64 = Float64(0.0)
    var ap: Float64 = Float64(0.0)
    var tt: Float64 = Float64(0.0)
    var tt23: Float64 = Float64(0.0)
    var t3: Float64 = Float64(0.0)
    var d: Float64 = Float64(0.0)
    if (psi > Float64(0.9)):
        theta = (Float64(4.17) + ((Float64(1.12) * (psi - Float64(0.9))) / Float64(0.176)))
    elif (psi > Float64(0.5)):
        theta = (Float64(3.14) + ((Float64(1.03) * (psi - Float64(0.5))) / Float64(0.4)))
    elif (psi > Float64(0.015)):
        theta = (Float64(1.2) + ((Float64(1.94) * (psi - Float64(0.015))) / Float64(0.485)))
    else:
        theta = ((Float64(0.12103) - (Float64(55.5075) * psi)) + (Float64(15.62254) * sqrt(psi)))
    theta1 = theta
    ap = ((Float64(2.0) * Float64(3.141592654)) * psi)
    k = Int32(1)
    while (k <= Int32(40)):
        theta = rt.fabs(theta)
        tt = (theta - rt.sin(theta))
        tt23 = rt.pow(tt, (Float64(2.0) / Float64(3.0)))
        t3 = rt.pow(theta, (Float64(1.0) / Float64(3.0)))
        d = (((ap * theta) / t3) - (tt * tt23))
        d = (d / (((ap * (Float64(2.0) / Float64(3.0))) / t3) - (((Float64(5.0) / Float64(3.0)) * tt23) * (Float64(1.0) - rt.cos(theta)))))
        theta = (theta - d)
        if (rt.fabs(d) <= Float64(0.0001)):
            return theta
        k += 1
    return theta1



# ---------------------------------------------------------------- function pointers
def __fpcall1(G: P[Globals], __f: Int32, a0: Float64, a1: P[Float64], a2: P[Float64], a3: VP):
    if __f == 7:
        return evalContinuity(G, a0, a1, a2, a3)
    if __f == 15:
        return storage_getVolDiff(G, a0, a1, a2, a3)
    if __f == 19:
        return evalSofA(G, a0, a1, a2, a3)
    rt.bad_function_pointer(__f)

def __fpcall2(G: P[Globals], __f: Int32, a0: Float64, a1: VP) -> Float64:
    if __f == 3:
        return form1Eqn(G, a0, a1)
    if __f == 20:
        return getQcritical(G, a0, a1)
    rt.bad_function_pointer(__f)
    return Float64(0.0)

def __fpcall3(G: P[Globals], __f: Int32, a0: P[Float64], a1: P[Float64]):
    if __f == 8:
        return biocellFluxRates(G, a0, a1)
    if __f == 9:
        return greenRoofFluxRates(G, a0, a1)
    if __f == 10:
        return trenchFluxRates(G, a0, a1)
    if __f == 11:
        return pavementFluxRates(G, a0, a1)
    if __f == 12:
        return barrelFluxRates(G, a0, a1)
    if __f == 13:
        return roofFluxRates(G, a0, a1)
    if __f == 14:
        return swaleFluxRates(G, a0, a1)
    rt.bad_function_pointer(__f)

def __fpcall4(G: P[Globals], __f: Int32, a0: P[Int8]) -> Int32:
    if __f == 1:
        return getVariableIndex(G, a0)
    if __f == 4:
        return gwater_getVariableIndex(G, a0)
    if __f == 17:
        return treatmnt_getVariableIndex(G, a0)
    rt.bad_function_pointer(__f)
    return Int32(0)

def __fpcall5(G: P[Globals], __f: Int32, a0: Int32) -> Float64:
    if __f == 2:
        return getNamedVariableValue(G, a0)
    if __f == 6:
        return gwater_getVariableValue(G, a0)
    if __f == 18:
