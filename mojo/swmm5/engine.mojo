# link.c:2608
def outlet_getInflow(G: P[Globals], j: Int32) -> Float64:
    var k: Int32 = Int32(0)
    var n1: Int32 = Int32(0)
    var n2: Int32 = Int32(0)
    var head: Float64 = Float64(0.0)
    var hcrest: Float64 = Float64(0.0)
    var h1: Float64 = Float64(0.0)
    var h2: Float64 = Float64(0.0)
    var y1: Float64 = Float64(0.0)
    var dir: Float64 = Float64(0.0)
    n1 = G[].Link[unsafe_offset=Int(j)].node1
    n2 = G[].Link[unsafe_offset=Int(j)].node2
    k = G[].Link[unsafe_offset=Int(j)].subIndex
    if (G[].RouteModel == Int32(4)):
        h1 = (G[].Node[unsafe_offset=Int(n1)].newDepth + G[].Node[unsafe_offset=Int(n1)].invertElev)
        h2 = (G[].Node[unsafe_offset=Int(n2)].newDepth + G[].Node[unsafe_offset=Int(n2)].invertElev)
    else:
        h1 = (G[].Node[unsafe_offset=Int(n1)].newDepth + G[].Node[unsafe_offset=Int(n1)].invertElev)
        h2 = G[].Node[unsafe_offset=Int(n1)].invertElev
    dir = (Float64(1.0) if (h1 >= h2) else Float64(-1.0))
    y1 = G[].Node[unsafe_offset=Int(n1)].newDepth
    if (dir < Float64(0.0)):
        y1 = h1
        h1 = h2
        h2 = y1
        y1 = G[].Node[unsafe_offset=Int(n2)].newDepth
    hcrest = (G[].Node[unsafe_offset=Int(n1)].invertElev + G[].Link[unsafe_offset=Int(j)].offset1)
    if ((G[].Outlet[unsafe_offset=Int(k)].curveType == Int32(1)) and (G[].RouteModel == Int32(4))):
        head = (h1 - (h2 if (h2 >= hcrest) else hcrest))
    else:
        head = (h1 - hcrest)
    if (((head <= Float64(0.0001)) or (y1 <= Float64(0.0001))) or (link_setFlapGate(G, j, n1, n2, dir) != 0)):
        G[].Link[unsafe_offset=Int(j)].newDepth = Float64(0.0)
        G[].Link[unsafe_offset=Int(j)].flowClass = Int32(0)
        return Float64(0.0)
    G[].Link[unsafe_offset=Int(j)].newDepth = head
    G[].Link[unsafe_offset=Int(j)].flowClass = Int32(3)
    return ((dir * G[].Link[unsafe_offset=Int(j)].setting) * outlet_getFlow(G, k, head))


# link.c:2672
def outlet_getFlow(G: P[Globals], k: Int32, head: Float64) -> Float64:
    var m: Int32 = Int32(0)
    var h: Float64 = Float64(0.0)
    h = (head * UCF(G, Int32(3)))
    m = G[].Outlet[unsafe_offset=Int(k)].qCurve
    if (m >= Int32(0)):
        return (table_lookup(G, G[].Curve.unsafe_offset(Int(m)), h) / UCF(G, Int32(10)))
    else:
        return ((G[].Outlet[unsafe_offset=Int(k)].qCoeff * rt.pow(h, G[].Outlet[unsafe_offset=Int(k)].qExpon)) / UCF(G, Int32(10)))
    return Float64(0.0)


