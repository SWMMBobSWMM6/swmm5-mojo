    var f: Float64 = Float64(0.0)
    if (G[].Nobjects[unsafe_offset=1] == Int32(0)):
        return
    f = ((routingTime - G[].OldRunoffTime) / (G[].NewRunoffTime - G[].OldRunoffTime))
    if (f < Float64(0.0)):
        f = Float64(0.0)
    if (f > Float64(1.0)):
        f = Float64(1.0)
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=1]):
        j = G[].Subcatch[unsafe_offset=Int(i)].outNode
        if (j >= Int32(0)):
            q = subcatch_getWtdOutflow(G, i, f)
            G[].Node[unsafe_offset=Int(j)].newLatFlow = (G[].Node[unsafe_offset=Int(j)].newLatFlow + q)
            massbal_addInflowFlow(G, Int32(2), q)
            p = Int32(0)
            while (p < G[].Nobjects[unsafe_offset=4]):
                w = surfqual_getWtdWashoff(G, i, p, f)
                (G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] = ((G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] + w)
                massbal_addInflowQual(G, Int32(2), p, w)
                p += 1
        i += 1


