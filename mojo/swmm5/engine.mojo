# report.c:183
def report_writeSysTime(G: P[Globals]):
    var elapsedTime: Float64 = Float64(0.0)
    var __sp = G[].R_[].sp
    var theTime = rt.salloc[Int8](G[].R_, 9)
    var endTime = rt.salloc[Int64](G[].R_, 1)
    if (not rt.isnull(G[].Frpt.file)):
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n\n  Analysis begun on:  %s"), rt.astr(rt.ctime(G[].R_, rt.addr(G[].SysTime))))
        _ = rt.time(endTime)
        _ = rt.fprintf(G[].Frpt.file, rt.s("  Analysis ended on:  %s"), rt.astr(rt.ctime(G[].R_, endTime)))
        elapsedTime = rt.difftime(endTime[], G[].SysTime)
        _ = rt.fprintf(G[].Frpt.file, rt.s("  Total elapsed time: "))
        if (elapsedTime < Float64(1.0)):
            _ = rt.fprintf(G[].Frpt.file, rt.s("< 1 sec"))
        else:
            elapsedTime = (elapsedTime / Float64(86400.0))
            if (elapsedTime >= Float64(1.0)):
                _ = rt.fprintf(G[].Frpt.file, rt.s("%d."), rt.ai(rt.d2i32(floor(elapsedTime))))
                elapsedTime = (elapsedTime - floor(elapsedTime))
            datetime_timeToStr(G, elapsedTime, theTime)
            _ = rt.fprintf(G[].Frpt.file, rt.s("%s"), rt.astr(theTime))
    G[].R_[].sp = __sp


