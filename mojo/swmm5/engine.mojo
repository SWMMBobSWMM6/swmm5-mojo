            massbal_updateLoadingTotals(G, Int32(0), p, (w * G[].Pollut[unsafe_offset=Int(p)].mcf))
            G[].OutflowLoad[unsafe_offset=Int(p)] = (G[].OutflowLoad[unsafe_offset=Int(p)] + w)
        p += 1


