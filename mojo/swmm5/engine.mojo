        G[].OutflowLoad[unsafe_offset=Int(p)] = (G[].OutflowLoad[unsafe_offset=Int(p)] + (wLidRain + wLidRunon))
        p += 1


# swmm5.c:186
def swmm_run(G: P[Globals], f1: P[Int8], f2: P[Int8], f3: P[Int8]) -> Int32:
    var newHour: Int64 = Int64(0)
    var oldHour: Int64 = Int64(0)
    var theDay: Int64 = Int64(0)
    var theHour: Int64 = Int64(0)
    var __rv: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var elapsedTime = rt.salloc[Float64](G[].R_, 1)
    oldHour = Int64(0)
    elapsedTime[] = Float64(0.0)
    G[].IsOpenFlag = Int32(0)
    G[].IsStartedFlag = Int32(0)
    G[].SaveResultsFlag = Int32(1)
    G[].ErrorCode = Int32(0)
    writecon(G, rt.s("\n o  Retrieving project data"))
    _ = swmm_open(G, f1, f2, f3)
    if (not (G[].ErrorCode != 0)):
        _ = swmm_start(G, Int32(1))
        if (not (G[].ErrorCode != 0)):
            writecon(G, rt.s("\n o  Simulating day: 0     hour:  0"))
            while True:
                _ = swmm_step(G, elapsedTime)
                newHour = rt.d2i64((elapsedTime[] * Float64(24.0)))
                if (newHour > oldHour):
                    theDay = rt.d2i64(elapsedTime[])
                    theHour = rt.d2i64(((elapsedTime[] - floor(elapsedTime[])) * Float64(24.0)))
                    writecon(G, rt.s("\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08"))
                    _ = rt.snprintf(G[].Msg, UInt64(1024), rt.s("%-5ld hour: %-2ld"), rt.al(theDay), rt.al(theHour))
                    writecon(G, G[].Msg)
                    oldHour = newHour
                if not ((elapsedTime[] > Float64(0.0)) and (not (G[].ErrorCode != 0))):
                    break
            writecon(G, rt.s("\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08\x08"))
            writecon(G, rt.s("Simulation complete           "))
        _ = swmm_end(G)
    if ((not (G[].ErrorCode != 0)) and (Int32(G[].Fout.mode) == Int32(1))):
        writecon(G, rt.s("\n o  Writing output report"))
        _ = swmm_report(G)
    _ = swmm_close(G)
    __rv = G[].ErrorCode
    G[].R_[].sp = __sp
    return __rv


