    upperDepth = (G[].TotalDepth - lowerDepth)
    G[].Hgw = lowerDepth
    G[].Theta = theta
    gwater_getEvapRates(G, theta, upperDepth)
    G[].UpperPerc = getUpperPerc(G, theta, upperDepth)
    G[].UpperPerc = (G[].UpperPerc if (G[].UpperPerc <= G[].MaxUpperPerc) else G[].MaxUpperPerc)
    if (Int(G[].DeepFlowExpr) != Int((rt.null[NoneType]()).unsafe_bitcast[MathExpr]())):
        G[].LowerLoss = (mathexpr_eval(G, G[].DeepFlowExpr, Int32(6)) / UCF(G, Int32(0)))
    else:
        G[].LowerLoss = ((G[].A.lowerLossCoeff * lowerDepth) / G[].TotalDepth)
    G[].LowerLoss = (G[].LowerLoss if (G[].LowerLoss <= (lowerDepth / G[].gwater_Tstep)) else (lowerDepth / G[].gwater_Tstep))
    G[].GWFlow = getGWFlow(G, lowerDepth)
    if (Int(G[].LatFlowExpr) != Int((rt.null[NoneType]()).unsafe_bitcast[MathExpr]())):
        G[].GWFlow = (G[].GWFlow + (mathexpr_eval(G, G[].LatFlowExpr, Int32(6)) / UCF(G, Int32(9))))
    if (G[].GWFlow >= Float64(0.0)):
        G[].GWFlow = (G[].GWFlow if (G[].GWFlow <= G[].MaxGWFlowPos) else G[].MaxGWFlowPos)
    else:
        G[].GWFlow = (G[].GWFlow if (G[].GWFlow >= G[].MaxGWFlowNeg) else G[].MaxGWFlowNeg)


