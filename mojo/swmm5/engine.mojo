def swmm_stride(G: P[Globals], strideStep: Int32, elapsedTime: P[Float64]) -> Int32:
    var realRouteStep: Float64 = Float64(0.0)
    realRouteStep = G[].RouteStep
    elapsedTime[] = Float64(0.0)
    if (G[].ErrorCode != 0):
        return G[].ErrorCode
    if (not (G[].IsOpenFlag != 0)):
        return (rt.set(G[].ErrorCode, Int32(501)))
    if (not (G[].IsStartedFlag != 0)):
        return (rt.set(G[].ErrorCode, Int32(502)))
    G[].RoutingDuration = (G[].NewRoutingTime + (Float64(1000.0) * Float64(strideStep)))
    G[].RoutingDuration = (G[].TotalDuration if (G[].TotalDuration <= G[].RoutingDuration) else G[].RoutingDuration)
    if (Float64(strideStep) < G[].RouteStep):
        G[].RouteStep = Float64(strideStep)
    while True:
        _ = swmm_step(G, elapsedTime)
        if not ((elapsedTime[] > Float64(0.0)) and (not (G[].ErrorCode != 0))):
            break
    G[].RouteStep = realRouteStep
    G[].RoutingDuration = G[].TotalDuration
    if (G[].NewRoutingTime < G[].TotalDuration):
        G[].ElapsedTime = (G[].NewRoutingTime / Float64(86400000.0))
    else:
        G[].ElapsedTime = Float64(0.0)
    elapsedTime[] = G[].ElapsedTime
    return G[].ErrorCode


# swmm5.c:514
def execRouting(G: P[Globals]):
    var nextRoutingTime: Float64 = Float64(0.0)
    var routingStep: Float64 = Float64(0.0)
    G[].TotalStepCount += 1
    if (not (G[].DoRouting != 0)):
        routingStep = Float64((G[].WetStep if (G[].WetStep <= G[].ReportStep) else G[].ReportStep))
    else:
        routingStep = routing_getRoutingStep(G, G[].RouteModel, G[].RouteStep)
    if (routingStep <= Float64(0.0)):
        G[].ErrorCode = Int32(107)
        return
    nextRoutingTime = (G[].NewRoutingTime + (Float64(1000.0) * routingStep))
    if (nextRoutingTime > G[].RoutingDuration):
        routingStep = ((G[].RoutingDuration - G[].NewRoutingTime) / Float64(1000.0))
        routingStep = (routingStep if (routingStep >= (Float64(1.0) / Float64(1000.0))) else (Float64(1.0) / Float64(1000.0)))
        nextRoutingTime = G[].RoutingDuration
    if (G[].DoRunoff != 0):
        while (G[].NewRunoffTime < nextRoutingTime):
            runoff_execute(G)
            if (G[].ErrorCode != 0):
                return
    else:
        climate_setState(G, getDateTime(G, G[].NewRoutingTime))
    if (G[].DoRouting != 0):
        routing_execute(G, G[].RouteModel, routingStep)
    else:
        G[].NewRoutingTime = nextRoutingTime


# swmm5.c:579
def saveResults(G: P[Globals]):
    if (G[].NewRoutingTime >= G[].ReportTime):
        if (G[].RptFlags.averages != 0):
            if (G[].NewRoutingTime == G[].ReportTime):
                output_updateAvgResults(G)
            output_saveResults(G, G[].ReportTime)
            if (G[].NewRoutingTime > G[].ReportTime):
                output_updateAvgResults(G)
        else:
            output_saveResults(G, G[].ReportTime)
        G[].ReportTime = (G[].ReportTime + (Float64(1000.0) * Float64(G[].ReportStep)))
    elif (G[].RptFlags.averages != 0):
        output_updateAvgResults(G)


# swmm5.c:618
def swmm_end(G: P[Globals]) -> Int32:
    if (not (G[].IsOpenFlag != 0)):
        return (rt.set(G[].ErrorCode, Int32(501)))
    if (G[].IsStartedFlag != 0):
        if (not rt.isnull(G[].Fout.file)):
            output_end(G)
        if ((not (G[].ErrorCode != 0)) and (Int32(G[].RptFlags.disabled) == Int32(0))):
            massbal_report(G)
            stats_report(G)
        stats_close(G)
        massbal_close(G)
        if (not (G[].IgnoreRainfall != 0)):
            rain_close(G)
        if (G[].DoRunoff != 0):
            runoff_close(G)
        if (G[].DoRouting != 0):
            routing_close(G, G[].RouteModel)
        hotstart_close(G)
        G[].IsStartedFlag = Int32(0)
    return G[].ErrorCode


