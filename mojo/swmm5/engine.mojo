    G[].IsRaining = Int8(0)
    G[].HasRunoff = Int8(0)
    G[].HasSnow = Int8(0)
    G[].runoff_Nsteps = Int32(0)
    if (not (odesolve_open(G, Int32(4)) != 0)):
        report_writeErrorMsg(G, Int32(105), rt.s(""))
    G[].OutflowLoad = (rt.null[NoneType]()).unsafe_bitcast[Float64]()
    if (G[].Nobjects[unsafe_offset=4] > Int32(0)):
        G[].OutflowLoad = (rt.calloc(UInt64(G[].Nobjects[unsafe_offset=4]), UInt64(8))).unsafe_bitcast[Float64]()
        if (not (not rt.isnull(G[].OutflowLoad))):
            report_writeErrorMsg(G, Int32(101), rt.s(""))
    __sw1 = Int32(G[].Frunoff.mode)
    if __sw1 == Int32(2):
        if (Int((rt.set(G[].Frunoff.file, rt.fopen(rt.addr(G[].Frunoff.name).unsafe_bitcast[Int8](), rt.s("r+b"))))) == Int((rt.null[NoneType]()).unsafe_bitcast[rt.FILE]())):
            report_writeErrorMsg(G, Int32(323), rt.addr(G[].Frunoff.name).unsafe_bitcast[Int8]())
        else:
            runoff_initFile(G)
    elif __sw1 == Int32(3):
        if (Int((rt.set(G[].Frunoff.file, rt.fopen(rt.addr(G[].Frunoff.name).unsafe_bitcast[Int8](), rt.s("w+b"))))) == Int((rt.null[NoneType]()).unsafe_bitcast[rt.FILE]())):
            report_writeErrorMsg(G, Int32(323), rt.addr(G[].Frunoff.name).unsafe_bitcast[Int8]())
        else:
            runoff_initFile(G)
    return G[].ErrorCode


