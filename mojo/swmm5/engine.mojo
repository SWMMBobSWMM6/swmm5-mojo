    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  **************************     ---------     ---------"))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Dry Weather Inflow .......%14.3f%14.3f"), rt.ad((totals[].dwInflow * ucf1)), rt.ad((totals[].dwInflow * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Wet Weather Inflow .......%14.3f%14.3f"), rt.ad((totals[].wwInflow * ucf1)), rt.ad((totals[].wwInflow * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Groundwater Inflow .......%14.3f%14.3f"), rt.ad((totals[].gwInflow * ucf1)), rt.ad((totals[].gwInflow * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  RDII Inflow ..............%14.3f%14.3f"), rt.ad((totals[].iiInflow * ucf1)), rt.ad((totals[].iiInflow * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  External Inflow ..........%14.3f%14.3f"), rt.ad((totals[].exInflow * ucf1)), rt.ad((totals[].exInflow * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  External Outflow .........%14.3f%14.3f"), rt.ad((totals[].outflow * ucf1)), rt.ad((totals[].outflow * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Flooding Loss ............%14.3f%14.3f"), rt.ad((totals[].flooding * ucf1)), rt.ad((totals[].flooding * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Evaporation Loss .........%14.3f%14.3f"), rt.ad((totals[].evapLoss * ucf1)), rt.ad((totals[].evapLoss * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Exfiltration Loss ........%14.3f%14.3f"), rt.ad((totals[].seepLoss * ucf1)), rt.ad((totals[].seepLoss * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Initial Stored Volume ....%14.3f%14.3f"), rt.ad((totals[].initStorage * ucf1)), rt.ad((totals[].initStorage * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Final Stored Volume ......%14.3f%14.3f"), rt.ad((totals[].finalStorage * ucf1)), rt.ad((totals[].finalStorage * ucf2)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Continuity Error (%%) .....%14.3f"), rt.ad(totals[].pctError))
