    removeConduitLosses(G)
    removeOutflows(G, routingStep)


# routing.c:435
def addExternalInflows(G: P[Globals], currentDate: Float64):
    var j: Int32 = Int32(0)
    var p: Int32 = Int32(0)
    var q: Float64 = Float64(0.0)
    var w: Float64 = Float64(0.0)
    var inflow: P[TExtInflow] = rt.null[TExtInflow]()
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        q = G[].Node[unsafe_offset=Int(j)].apiExtInflow
        inflow = G[].Node[unsafe_offset=Int(j)].extInflow
        while (not rt.isnull(inflow)):
            if (inflow[].type == Int32(5)):
                q = (q + inflow_getExtInflow(G, inflow, currentDate))
                break
            else:
                inflow = inflow[].next
        if (rt.fabs(q) < Float64(1e-05)):
            q = Float64(0.0)
        G[].Node[unsafe_offset=Int(j)].newLatFlow = (G[].Node[unsafe_offset=Int(j)].newLatFlow + q)
        if (q >= Float64(0.0)):
            massbal_addInflowFlow(G, Int32(0), q)
        else:
            massbal_addOutflowFlow(G, (-q), Int32(0))
            j += 1
            continue
        if ((G[].Node[unsafe_offset=Int(j)].type == Int32(1)) and (G[].Node[unsafe_offset=Int(j)].oldNetInflow < Float64(0.0))):
            q = (q - G[].Node[unsafe_offset=Int(j)].oldNetInflow)
        inflow = G[].Node[unsafe_offset=Int(j)].extInflow
        while (not rt.isnull(inflow)):
            if (inflow[].type != Int32(5)):
                p = inflow[].param
                w = inflow_getExtInflow(G, inflow, currentDate)
                if (inflow[].type == Int32(6)):
                    w = (w * q)
                (G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] = ((G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] + w)
                massbal_addInflowQual(G, Int32(0), p, w)
            inflow = inflow[].next
        j += 1


# routing.c:498
def addDryWeatherInflows(G: P[Globals], currentDate: Float64):
    var j: Int32 = Int32(0)
    var p: Int32 = Int32(0)
    var month: Int32 = Int32(0)
    var day: Int32 = Int32(0)
    var hour: Int32 = Int32(0)
    var q: Float64 = Float64(0.0)
    var w: Float64 = Float64(0.0)
    var inflow: P[TDwfInflow] = rt.null[TDwfInflow]()
    month = (datetime_monthOfYear(G, currentDate) - Int32(1))
    day = (datetime_dayOfWeek(G, currentDate) - Int32(1))
    hour = datetime_hourOfDay(G, currentDate)
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        inflow = G[].Node[unsafe_offset=Int(j)].dwfInflow
        if (not (not rt.isnull(inflow))):
            j += 1
            continue
        q = Float64(0.0)
        while (not rt.isnull(inflow)):
            if (inflow[].param < Int32(0)):
                q = inflow_getDwfInflow(G, inflow, month, day, hour)
                break
            inflow = inflow[].next
        if (rt.fabs(q) < Float64(1e-05)):
            q = Float64(0.0)
        G[].Node[unsafe_offset=Int(j)].newLatFlow = (G[].Node[unsafe_offset=Int(j)].newLatFlow + q)
        massbal_addInflowFlow(G, Int32(1), q)
        if (q <= Float64(0.0)):
            j += 1
            continue
        p = Int32(0)
        while (p < G[].Nobjects[unsafe_offset=4]):
            if (G[].Pollut[unsafe_offset=Int(p)].dwfConcen > Float64(0.0)):
                w = (q * G[].Pollut[unsafe_offset=Int(p)].dwfConcen)
                (G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] = ((G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] + w)
                massbal_addInflowQual(G, Int32(1), p, w)
            p += 1
        inflow = G[].Node[unsafe_offset=Int(j)].dwfInflow
        while (not rt.isnull(inflow)):
            if (inflow[].param >= Int32(0)):
                p = inflow[].param
                w = (q * inflow_getDwfInflow(G, inflow, month, day, hour))
                (G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] = ((G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] + w)
                massbal_addInflowQual(G, Int32(1), p, w)
                if (G[].Pollut[unsafe_offset=Int(p)].dwfConcen > Float64(0.0)):
                    w = (q * G[].Pollut[unsafe_offset=Int(p)].dwfConcen)
                    (G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] = ((G[].Node[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(p)] - w)
                    massbal_addInflowQual(G, Int32(1), p, (-w))
            inflow = inflow[].next
        j += 1


