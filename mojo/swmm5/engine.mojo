    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Evaporation Loss .........%14.3f%14.3f"), rt.ad(((totals[].evap * UCF(G, Int32(3))) * UCF(G, Int32(4)))), rt.ad(((totals[].evap / totalArea) * UCF(G, Int32(1)))))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Infiltration Loss ........%14.3f%14.3f"), rt.ad(((totals[].infil * UCF(G, Int32(3))) * UCF(G, Int32(4)))), rt.ad(((totals[].infil / totalArea) * UCF(G, Int32(1)))))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Surface Runoff ...........%14.3f%14.3f"), rt.ad(((totals[].runoff * UCF(G, Int32(3))) * UCF(G, Int32(4)))), rt.ad(((totals[].runoff / totalArea) * UCF(G, Int32(1)))))
    if (totals[].drains > Float64(0.0)):
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  LID Drainage .............%14.3f%14.3f"), rt.ad(((totals[].drains * UCF(G, Int32(3))) * UCF(G, Int32(4)))), rt.ad(((totals[].drains / totalArea) * UCF(G, Int32(1)))))
