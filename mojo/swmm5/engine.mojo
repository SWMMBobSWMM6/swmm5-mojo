# routing.c:776
def inflowHasChanged(G: P[Globals]) -> Int32:
    var j: Int32 = Int32(0)
    var diff: Float64 = Float64(0.0)
    var qOld: Float64 = Float64(0.0)
    var qNew: Float64 = Float64(0.0)
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        qOld = G[].Node[unsafe_offset=Int(j)].oldLatFlow
        qNew = G[].Node[unsafe_offset=Int(j)].newLatFlow
        if (rt.fabs(qOld) > Float64(1e-06)):
            diff = ((qNew / qOld) - Float64(1.0))
        elif (rt.fabs(qNew) > Float64(1e-06)):
            diff = Float64(1.0)
        else:
            diff = Float64(0.0)
        if (rt.fabs(diff) > G[].LatFlowTol):
            return Int32(1)
        if ((G[].Node[unsafe_offset=Int(j)].type == Int32(1)) or (G[].Node[unsafe_offset=Int(j)].degree == Int32(0))):
            qOld = G[].Node[unsafe_offset=Int(j)].oldFlowInflow
            qNew = G[].Node[unsafe_offset=Int(j)].inflow
            if (rt.fabs(qOld) > Float64(1e-06)):
                diff = ((qNew / qOld) - Float64(1.0))
            elif (rt.fabs(qNew) > Float64(1e-06)):
                diff = Float64(1.0)
            else:
                diff = Float64(0.0)
            if (rt.fabs(diff) > G[].LatFlowTol):
                return Int32(1)
        j += 1
    return Int32(0)


# routing.c:812
def removeStorageLosses(G: P[Globals], tStep: Float64):
    var i: Int32 = Int32(0)
    var evapLoss: Float64 = Float64(0.0)
    var exfilLoss: Float64 = Float64(0.0)
    evapLoss = Float64(0.0)
    exfilLoss = Float64(0.0)
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=2]):
        if (G[].Node[unsafe_offset=Int(i)].type == Int32(2)):
            evapLoss = (evapLoss + G[].Storage[unsafe_offset=Int(G[].Node[unsafe_offset=Int(i)].subIndex)].evapLoss)
            exfilLoss = (exfilLoss + G[].Storage[unsafe_offset=Int(G[].Node[unsafe_offset=Int(i)].subIndex)].exfilLoss)
        i += 1
    massbal_addNodeLosses(G, (evapLoss / tStep), (exfilLoss / tStep))


# routing.c:841
def removeConduitLosses(G: P[Globals]):
    var i: Int32 = Int32(0)
    var k: Int32 = Int32(0)
    var barrels: Float64 = Float64(0.0)
    var evapLoss: Float64 = Float64(0.0)
    var seepLoss: Float64 = Float64(0.0)
    evapLoss = Float64(0.0)
    seepLoss = Float64(0.0)
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=3]):
        if (G[].Link[unsafe_offset=Int(i)].type == Int32(0)):
            k = G[].Link[unsafe_offset=Int(i)].subIndex
            barrels = Float64(G[].Conduit[unsafe_offset=Int(k)].barrels)
            evapLoss = (evapLoss + (G[].Conduit[unsafe_offset=Int(k)].evapLossRate * barrels))
            seepLoss = (seepLoss + (G[].Conduit[unsafe_offset=Int(k)].seepLossRate * barrels))
        i += 1
    massbal_addLinkLosses(G, evapLoss, seepLoss)


