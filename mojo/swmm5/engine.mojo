# kinwave.c:57
def kinwave_execute(G: P[Globals], j: Int32, qinflow: P[Float64], qoutflow: P[Float64], tStep: Float64) -> Int32:
    var k: Int32 = Int32(0)
    var result: Int32 = Int32(0)
    var dxdt: Float64 = Float64(0.0)
    var dq: Float64 = Float64(0.0)
    var ain: Float64 = Float64(0.0)
    var qin: Float64 = Float64(0.0)
    var qout: Float64 = Float64(0.0)
    var a1: Float64 = Float64(0.0)
    var a2: Float64 = Float64(0.0)
    var q1: Float64 = Float64(0.0)
    var q2: Float64 = Float64(0.0)
    var q3: Float64 = Float64(0.0)
    var __rv: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var aout = rt.salloc[Float64](G[].R_, 1)
    result = Int32(1)
    qoutflow[] = qinflow[]
    if (G[].Link[unsafe_offset=Int(j)].type != Int32(0)):
        __rv = result
        G[].R_[].sp = __sp
        return __rv
    if (G[].Link[unsafe_offset=Int(j)].xsect.type == Int32(0)):
        __rv = result
        G[].R_[].sp = __sp
        return __rv
    G[].pXsect = rt.addr(G[].Link[unsafe_offset=Int(j)].xsect)
    G[].Qfull = G[].Link[unsafe_offset=Int(j)].qFull
    G[].Afull = G[].Link[unsafe_offset=Int(j)].xsect.aFull
    k = G[].Link[unsafe_offset=Int(j)].subIndex
    G[].Beta1 = (G[].Conduit[unsafe_offset=Int(k)].beta / G[].Qfull)
    q1 = (G[].Conduit[unsafe_offset=Int(k)].q1 / G[].Qfull)
    q2 = (G[].Conduit[unsafe_offset=Int(k)].q2 / G[].Qfull)
    qin = ((qinflow[] / Float64(Int32(G[].Conduit[unsafe_offset=Int(k)].barrels))) / G[].Qfull)
    q3 = (link_getLossRate(G, j, Int32(2), (qin * G[].Qfull), tStep) / G[].Qfull)
    a1 = (G[].Conduit[unsafe_offset=Int(k)].a1 / G[].Afull)
    a2 = (G[].Conduit[unsafe_offset=Int(k)].a2 / G[].Afull)
    if (qin >= Float64(1.0)):
        ain = Float64(1.0)
    else:
        ain = (xsect_getAofS(G, G[].pXsect, (qin / G[].Beta1)) / G[].Afull)
    if ((qin <= Float64(1e-06)) and (q2 <= Float64(1e-06))):
        qout = Float64(0.0)
        aout[] = Float64(0.0)
    else:
        dxdt = (((link_getLength(G, j) / tStep) * G[].Afull) / G[].Qfull)
        dq = (q2 - q1)
        G[].C1 = ((dxdt * G[].WT) / G[].WX)
        G[].C2 = ((Float64(1.0) - G[].WT) * (ain - a1))
        G[].C2 = (G[].C2 - (G[].WT * a2))
        G[].C2 = ((G[].C2 * dxdt) / G[].WX)
        G[].C2 = ((G[].C2 + (((Float64(1.0) - G[].WX) / G[].WX) * dq)) - qin)
        G[].C2 = (G[].C2 + (q3 / G[].WX))
        aout[] = a2
        result = solveContinuity(G, qin, ain, aout)
        if (result == Int32(-1)):
            report_writeErrorMsg(G, Int32(103), G[].Link[unsafe_offset=Int(j)].ID)
            __rv = Int32(1)
            G[].R_[].sp = __sp
            return __rv
        if (result <= Int32(0)):
            result = Int32(1)
        qout = (G[].Beta1 * xsect_getSofA(G, G[].pXsect, (aout[] * G[].Afull)))
        if (qin > Float64(1.0)):
            qin = Float64(1.0)
    G[].Conduit[unsafe_offset=Int(k)].q1 = (qin * G[].Qfull)
    G[].Conduit[unsafe_offset=Int(k)].a1 = (ain * G[].Afull)
    G[].Conduit[unsafe_offset=Int(k)].q2 = (qout * G[].Qfull)
    G[].Conduit[unsafe_offset=Int(k)].a2 = (aout[] * G[].Afull)
    G[].Conduit[unsafe_offset=Int(k)].fullState = link_getFullState(G, G[].Conduit[unsafe_offset=Int(k)].a1, G[].Conduit[unsafe_offset=Int(k)].a2, G[].Afull)
    qinflow[] = (G[].Conduit[unsafe_offset=Int(k)].q1 * Float64(Int32(G[].Conduit[unsafe_offset=Int(k)].barrels)))
    qoutflow[] = (G[].Conduit[unsafe_offset=Int(k)].q2 * Float64(Int32(G[].Conduit[unsafe_offset=Int(k)].barrels)))
    __rv = result
    G[].R_[].sp = __sp
    return __rv


# kinwave.c:170
def solveContinuity(G: P[Globals], qin: Float64, ain: Float64, aout: P[Float64]) -> Int32:
