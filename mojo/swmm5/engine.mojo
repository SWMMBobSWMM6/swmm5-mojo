        n = Int32(6)
    if (ntoks > n):
        i = findmatch(G, tok[unsafe_offset=Int(n)], G[].NoYesWords)
        if (i < Int32(0)):
            __rv = error_setInpError(G, Int32(205), tok[unsafe_offset=Int(n)])
            G[].R_[].sp = __sp
            return __rv
        x[unsafe_offset=4] = Float64(i)
    G[].Link[unsafe_offset=Int(j)].ID = id
