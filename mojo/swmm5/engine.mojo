    while (i < G[].Nobjects[unsafe_offset=1]):
        subcatch_validate(G, i)
        i += 1
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=0]):
        gage_validate(G, i)
        i += 1
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=13]):
        snow_validateSnowmelt(G, i)
        i += 1
    j = Int32(0)
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=7]):
        if (G[].Curve[unsafe_offset=Int(i)].curveType == Int32(5)):
            G[].Curve[unsafe_offset=Int(i)].refersTo = j
            G[].Shape[unsafe_offset=Int(j)].curve = i
            if (not (shape_validate(G, G[].Shape.unsafe_offset(Int(j)), G[].Curve.unsafe_offset(Int(i))) != 0)):
                report_writeErrorMsg(G, Int32(171), G[].Curve[unsafe_offset=Int(i)].ID)
            j += 1
        i += 1
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=2]):
        G[].Node[unsafe_offset=Int(i)].oldDepth = G[].Node[unsafe_offset=Int(i)].fullDepth
        i += 1
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=3]):
        link_validate(G, i)
        i += 1
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=2]):
        node_validate(G, i)
        i += 1
    if (G[].DryStep < G[].WetStep):
        report_writeWarningMsg(G, rt.s("WARNING 06: dry weather time step increased to the wet weather time step"), rt.s(""))
        G[].DryStep = G[].WetStep
    if (G[].RouteStep > Float64(G[].WetStep)):
        report_writeWarningMsg(G, rt.s("WARNING 07: routing time step reduced to the wet weather time step"), rt.s(""))
        G[].RouteStep = Float64(G[].WetStep)
    if (Int32(G[].RptFlags.subcatchments) == Int32(1)):
        i = Int32(0)
        while (i < G[].Nobjects[unsafe_offset=1]):
            G[].Subcatch[unsafe_offset=Int(i)].rptFlag = Int32(1)
            i += 1
    if (Int32(G[].RptFlags.nodes) == Int32(1)):
        i = Int32(0)
        while (i < G[].Nobjects[unsafe_offset=2]):
            G[].Node[unsafe_offset=Int(i)].rptFlag = Int32(1)
            i += 1
    if (Int32(G[].RptFlags.links) == Int32(1)):
        i = Int32(0)
        while (i < G[].Nobjects[unsafe_offset=3]):
            G[].Link[unsafe_offset=Int(i)].rptFlag = Int32(1)
            i += 1
    if (G[].RouteModel == Int32(4)):
        dynwave_validate(G)
    inlet_validate(G)
    if (G[].NumThreads == Int32(0)):
        G[].NumThreads = omp_get_max_threads(G)
    else:
        G[].NumThreads = (G[].NumThreads if (G[].NumThreads <= (omp_get_max_threads(G))) else (omp_get_max_threads(G)))
