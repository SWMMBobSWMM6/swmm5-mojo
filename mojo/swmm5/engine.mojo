    if (offset >= (-G[].MIN_DELTA_Z)):
        return Float64(0.0)
    report_writeWarningMsg(G, rt.s("WARNING 03: negative offset ignored for Link"), G[].Link[unsafe_offset=Int(j)].ID)
    return Float64(0.0)


