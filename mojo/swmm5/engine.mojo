# runoff.c:155
def runoff_execute(G: P[Globals]):
    var j: Int32 = Int32(0)
    var day: Int32 = Int32(0)
    var runoffStep: Float64 = Float64(0.0)
    var oldRunoffStep: Float64 = Float64(0.0)
    var runoff: Float64 = Float64(0.0)
    var currentDate: Float64 = Float64(0.0)
    var canSweep: Int8 = Int8(0)
    if (G[].ErrorCode != 0):
        return
    oldRunoffStep = ((G[].NewRunoffTime - G[].OldRunoffTime) / Float64(1000.0))
    currentDate = getDateTime(G, G[].NewRunoffTime)
    climate_setState(G, currentDate)
    if (G[].Nobjects[unsafe_offset=1] == Int32(0)):
        G[].OldRunoffTime = G[].NewRunoffTime
        G[].NewRunoffTime = (G[].NewRunoffTime + (Float64(G[].DryStep) * Float64(1000.0)))
        G[].NewRunoffTime = (G[].NewRunoffTime if (G[].NewRunoffTime <= G[].TotalDuration) else G[].TotalDuration)
        return
    G[].IsRaining = Int8(0)
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=0]):
        gage_setState(G, j, currentDate)
        if (G[].Gage[unsafe_offset=Int(j)].rainfall > Float64(0.0)):
            G[].IsRaining = Int8(1)
        j += 1
    if (Int32(G[].Frunoff.mode) == Int32(2)):
        runoff_readFromFile(G)
        return
    day = datetime_dayOfYear(G, currentDate)
    canSweep = Int8(0)
    if (G[].SweepStart <= G[].SweepEnd):
        if ((day >= G[].SweepStart) and (day <= G[].SweepEnd)):
            canSweep = Int8(1)
    elif ((day <= G[].SweepEnd) or (day >= G[].SweepStart)):
        canSweep = Int8(1)
    runoffStep = runoff_getTimeStep(G, currentDate)
    if (runoffStep <= Float64(0.0)):
        G[].ErrorCode = Int32(107)
        return
    G[].OldRunoffTime = G[].NewRunoffTime
    G[].NewRunoffTime = (G[].NewRunoffTime + (Float64(1000.0) * runoffStep))
    if (G[].NewRunoffTime > G[].TotalDuration):
        runoffStep = ((G[].TotalDuration - G[].OldRunoffTime) / Float64(1000.0))
        G[].NewRunoffTime = G[].TotalDuration
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=0]):
        gage_updatePastRain(G, j, rt.d2i32(runoffStep))
        j += 1
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=1]):
        subcatch_setOldState(G, j)
        j += 1
    if (oldRunoffStep > Float64(0.0)):
        runoff_getOutfallRunon(G, oldRunoffStep)
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=1]):
        if (G[].Subcatch[unsafe_offset=Int(j)].area == Float64(0.0)):
            j += 1
            continue
        subcatch_getRunon(G, j)
        if (not (G[].IgnoreSnowmelt != 0)):
            snow_plowSnow(G, j, runoffStep)
        j += 1
    G[].HasSnow = Int8(0)
    G[].HasRunoff = Int8(0)
    G[].HasWetLids = Int8(0)
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=1]):
        if (G[].Subcatch[unsafe_offset=Int(j)].area == Float64(0.0)):
            j += 1
            continue
        runoff = subcatch_getRunoff(G, j, runoffStep)
        if (runoff > Float64(0.0)):
            G[].HasRunoff = Int8(1)
        if (G[].Subcatch[unsafe_offset=Int(j)].newSnowDepth > Float64(0.0)):
            G[].HasSnow = Int8(1)
        if (G[].IgnoreQuality != 0):
            j += 1
            continue
        if (runoff < Float64(2.31481e-08)):
            surfqual_getBuildup(G, j, runoffStep)
        if ((Int32(canSweep) != 0) and (G[].Subcatch[unsafe_offset=Int(j)].rainfall <= Float64(2.31481e-08))):
            surfqual_sweepBuildup(G, j, currentDate)
        surfqual_getWashoff(G, j, runoff, runoffStep)
        j += 1
    stats_updateMaxRunoff(G)
    G[].runoff_Nsteps += 1
    if (Int32(G[].Frunoff.mode) == Int32(3)):
        runoff_saveToFile(G, Float32(runoffStep))
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=1]):
        G[].Subcatch[unsafe_offset=Int(j)].runon = Float64(0.0)
        j += 1


# runoff.c:299
def runoff_getTimeStep(G: P[Globals], currentDate: Float64) -> Float64:
    var j: Int32 = Int32(0)
    var timeStep: Int64 = Int64(0)
    var maxStep: Int64 = Int64(0)
    maxStep = Int64(G[].DryStep)
    timeStep = datetime_timeDiff(G, climate_getNextEvapDate(G), currentDate)
    if ((Float64(timeStep) > Float64(0.0)) and (timeStep < maxStep)):
        maxStep = timeStep
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=0]):
        timeStep = datetime_timeDiff(G, gage_getNextRainDate(G, j, currentDate), currentDate)
        if ((timeStep > Int64(0)) and (timeStep < maxStep)):
            maxStep = timeStep
        j += 1
    if ((((Int32(G[].IsRaining) != 0) or (Int32(G[].HasSnow) != 0)) or (Int32(G[].HasRunoff) != 0)) or (Int32(G[].HasWetLids) != 0)):
        timeStep = Int64(G[].WetStep)
    else:
        timeStep = Int64(G[].DryStep)
    if (timeStep > maxStep):
        timeStep = maxStep
    return Float64(timeStep)


# runoff.c:335
def runoff_initFile(G: P[Globals]):
    var __sp = G[].R_[].sp
    var nSubcatch = rt.salloc[Int32](G[].R_, 1)
    var nPollut = rt.salloc[Int32](G[].R_, 1)
    var flowUnits = rt.salloc[Int32](G[].R_, 1)
    var fileStamp = rt.salloc[Int8](G[].R_, 13)
    var fStamp = rt.salloc[Int8](G[].R_, 13)
    rt.init_chars(fileStamp, rt.s("SWMM5-RUNOFF"), 12)
    rt.init_chars(fStamp, rt.s("SWMM5-RUNOFF"), 12)
    G[].MaxSteps = Int32(0)
    if (Int32(G[].Frunoff.mode) == Int32(3)):
        nSubcatch[] = G[].Nobjects[unsafe_offset=1]
        nPollut[] = G[].Nobjects[unsafe_offset=4]
        flowUnits[] = G[].FlowUnits
        _ = rt.fwrite(fileStamp.unsafe_bitcast[NoneType](), UInt64(1), rt.strlen(fileStamp), G[].Frunoff.file)
        _ = rt.fwrite(nSubcatch.unsafe_bitcast[NoneType](), UInt64(4), UInt64(1), G[].Frunoff.file)
        _ = rt.fwrite(nPollut.unsafe_bitcast[NoneType](), UInt64(4), UInt64(1), G[].Frunoff.file)
        _ = rt.fwrite(flowUnits.unsafe_bitcast[NoneType](), UInt64(4), UInt64(1), G[].Frunoff.file)
        G[].MaxStepsPos = rt.ftell(G[].Frunoff.file)
        _ = rt.fwrite((rt.addr(G[].MaxSteps)).unsafe_bitcast[NoneType](), UInt64(4), UInt64(1), G[].Frunoff.file)
    if (Int32(G[].Frunoff.mode) == Int32(2)):
        _ = rt.fread(fStamp.unsafe_bitcast[NoneType](), UInt64(1), rt.strlen(fileStamp), G[].Frunoff.file)
        if (rt.strcmp(fStamp, fileStamp) != Int32(0)):
            report_writeErrorMsg(G, Int32(325), rt.s(""))
            G[].R_[].sp = __sp
            return
        nSubcatch[] = Int32(-1)
        nPollut[] = Int32(-1)
        flowUnits[] = Int32(-1)
        _ = rt.fread(nSubcatch.unsafe_bitcast[NoneType](), UInt64(4), UInt64(1), G[].Frunoff.file)
        _ = rt.fread(nPollut.unsafe_bitcast[NoneType](), UInt64(4), UInt64(1), G[].Frunoff.file)
        _ = rt.fread(flowUnits.unsafe_bitcast[NoneType](), UInt64(4), UInt64(1), G[].Frunoff.file)
        _ = rt.fread((rt.addr(G[].MaxSteps)).unsafe_bitcast[NoneType](), UInt64(4), UInt64(1), G[].Frunoff.file)
        if ((((nSubcatch[] != G[].Nobjects[unsafe_offset=1]) or (nPollut[] != G[].Nobjects[unsafe_offset=4])) or (flowUnits[] != G[].FlowUnits)) or (G[].MaxSteps <= Int32(0))):
            report_writeErrorMsg(G, Int32(325), rt.s(""))
    G[].R_[].sp = __sp


# runoff.c:391
def runoff_saveToFile(G: P[Globals], tStep__a: Float32):
    var j: Int32 = Int32(0)
    var n: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var tStep = rt.salloc[Float32](G[].R_, 1)
