    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=8]):
        err = table_validate(G, G[].Tseries.unsafe_offset(Int(i)))
        if (err != 0):
            report_writeTseriesErrorMsg(G, err, G[].Tseries.unsafe_offset(Int(i)))
        i += 1
    climate_validate(G)
    lid_validate(G)
    if (G[].Nobjects[unsafe_offset=13] == Int32(0)):
        G[].IgnoreSnowmelt = Int32(1)
    if (G[].Nobjects[unsafe_offset=11] == Int32(0)):
        G[].IgnoreGwater = Int32(1)
