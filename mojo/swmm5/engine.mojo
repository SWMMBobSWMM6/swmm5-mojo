    if (Int(G[].Frpt.file) != Int((rt.null[NoneType]()).unsafe_bitcast[rt.FILE]())):
        _ = rt.fclose(G[].Frpt.file)
    if (Int(G[].Fout.file) != Int((rt.null[NoneType]()).unsafe_bitcast[rt.FILE]())):
        _ = rt.fclose(G[].Fout.file)
        if (Int32(G[].Fout.mode) == Int32(1)):
            _ = rt.remove(rt.addr(G[].Fout.name).unsafe_bitcast[Int8]())
    G[].IsOpenFlag = Int32(0)
    G[].IsStartedFlag = Int32(0)
    return Int32(0)


