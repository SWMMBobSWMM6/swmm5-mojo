            p[unsafe_offset=0] = (G[].LidProcs[unsafe_offset=Int(k)].soil.suction * UCF(G, Int32(1)))
            p[unsafe_offset=1] = (G[].LidProcs[unsafe_offset=Int(k)].soil.kSat * UCF(G, Int32(0)))
