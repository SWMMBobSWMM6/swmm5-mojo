    G[].xsect = rt.addr(G[].Link[unsafe_offset=Int(inlet[].linkIndex)].xsect)
    if (G[].xsect[].type == Int32(25)):
        sides = G[].Street[unsafe_offset=Int(G[].xsect[].transect)].sides
