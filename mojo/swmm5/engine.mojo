# report.c:923
def report_writeMaxStats(G: P[Globals], maxMassBalErrs: P[TMaxStats], maxCourantCrit: P[TMaxStats], nMaxStats: Int32):
    var i: Int32 = Int32(0)
    var j: Int32 = Int32(0)
    var k: Int32 = Int32(0)
    if ((G[].RouteModel != Int32(4)) or (G[].Nobjects[unsafe_offset=3] == Int32(0))):
        return
    if (nMaxStats <= Int32(0)):
        return
    if (maxMassBalErrs[unsafe_offset=0].index >= Int32(0)):
        report_writeLine(G, rt.s(""))
        report_writeLine(G, rt.s("*************************"))
        report_writeLine(G, rt.s("Highest Continuity Errors"))
        report_writeLine(G, rt.s("*************************"))
        i = Int32(0)
        while (i < nMaxStats):
            j = maxMassBalErrs[unsafe_offset=Int(i)].index
            if (j < Int32(0)):
                i += 1
                continue
            _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Node %s (%.2f%%)"), rt.astr(G[].Node[unsafe_offset=Int(j)].ID), rt.ad(maxMassBalErrs[unsafe_offset=Int(i)].value))
            i += 1
        report_writeLine(G, rt.s(""))
    if (G[].CourantFactor == Float64(0.0)):
        return
    report_writeLine(G, rt.s(""))
    report_writeLine(G, rt.s("***************************"))
    report_writeLine(G, rt.s("Time-Step Critical Elements"))
    report_writeLine(G, rt.s("***************************"))
    k = Int32(0)
    i = Int32(0)
    while (i < nMaxStats):
        j = maxCourantCrit[unsafe_offset=Int(i)].index
        if (j < Int32(0)):
            i += 1
            continue
        k += 1
        if (maxCourantCrit[unsafe_offset=Int(i)].objType == Int32(2)):
            _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Node %s"), rt.astr(G[].Node[unsafe_offset=Int(j)].ID))
        else:
            _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Link %s"), rt.astr(G[].Link[unsafe_offset=Int(j)].ID))
        _ = rt.fprintf(G[].Frpt.file, rt.s(" (%.2f%%)"), rt.ad(maxCourantCrit[unsafe_offset=Int(i)].value))
        i += 1
    if (k == Int32(0)):
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  None"))
    report_writeLine(G, rt.s(""))


