# project.c:129
def project_readInput(G: P[Globals]):
    createHashTables(G)
    _ = input_countObjects(G)
    createObjects(G)
    _ = input_readData(G)
    if (G[].ErrorCode != 0):
        return
    G[].StartDateTime = (G[].StartDate + G[].StartTime)
    G[].EndDateTime = (G[].EndDate + G[].EndTime)
    G[].ReportStart = (G[].ReportStartDate + G[].ReportStartTime)
    G[].ReportStart = (G[].ReportStart if (G[].ReportStart >= G[].StartDateTime) else G[].StartDateTime)
    if (G[].EndDateTime <= G[].StartDateTime):
        report_writeErrorMsg(G, Int32(191), rt.s(""))
    elif (G[].EndDateTime <= G[].ReportStart):
        report_writeErrorMsg(G, Int32(193), rt.s(""))
    else:
        G[].TotalDuration = floor(((G[].EndDateTime - G[].StartDateTime) * Float64(86400.0)))
        if (Float64(G[].ReportStep) > G[].TotalDuration):
            G[].ReportStep = rt.d2i32(G[].TotalDuration)
        if (Float64(G[].ReportStep) < G[].RouteStep):
            report_writeErrorMsg(G, Int32(195), rt.s(""))
        G[].TotalDuration = (G[].TotalDuration * Float64(1000.0))


