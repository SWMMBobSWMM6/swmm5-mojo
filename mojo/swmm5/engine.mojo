                    _ = sstrcat(G, G[].Msg, rt.s(" - check subcatchment Green-Ampt parameters"), UInt64(1024))
                    report_writeErrorMsg(G, Int32(185), G[].Msg)
            if (lidUnit[].fullWidth <= Float64(0.0)):
                _ = sstrncpy(G, G[].Msg, G[].LidProcs[unsafe_offset=Int(k)].ID, UInt64(1024))
                _ = sstrcat(G, G[].Msg, rt.s(" - invalid swale width"), UInt64(1024))
                report_writeErrorMsg(G, Int32(185), G[].Msg)
        if (G[].Subcatch[unsafe_offset=Int(j)].fracImperv >= Float64(0.999)):
            lidUnit[].toPerv = Int32(0)
