    var __sp = G[].R_[].sp
    var tStep = rt.salloc[Float32](G[].R_, 1)
    if (G[].runoff_Nsteps > G[].MaxSteps):
        report_writeErrorMsg(G, Int32(327), rt.s(""))
        G[].R_[].sp = __sp
        return
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=1]):
        subcatch_setOldState(G, j)
        j += 1
    kount = Int32(0)
    kount += Int32(rt.fread(tStep.unsafe_bitcast[NoneType](), UInt64(4), UInt64(1), G[].Frunoff.file))
    nResults = ((Int32(9) + G[].Nobjects[unsafe_offset=4]) - Int32(1))
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=1]):
        kount += Int32(rt.fread(G[].SubcatchResults.unsafe_bitcast[NoneType](), UInt64(4), UInt64(nResults), G[].Frunoff.file))
        G[].Subcatch[unsafe_offset=Int(j)].newSnowDepth = (Float64(G[].SubcatchResults[unsafe_offset=1]) / UCF(G, Int32(1)))
        G[].Subcatch[unsafe_offset=Int(j)].evapLoss = (Float64(G[].SubcatchResults[unsafe_offset=2]) / UCF(G, Int32(0)))
        G[].Subcatch[unsafe_offset=Int(j)].infilLoss = (Float64(G[].SubcatchResults[unsafe_offset=3]) / UCF(G, Int32(0)))
        G[].Subcatch[unsafe_offset=Int(j)].newRunoff = (Float64(G[].SubcatchResults[unsafe_offset=4]) / UCF(G, Int32(10)))
        gw = G[].Subcatch[unsafe_offset=Int(j)].groundwater
        if (not rt.isnull(gw)):
            gw[].newFlow = (Float64(G[].SubcatchResults[unsafe_offset=5]) / UCF(G, Int32(10)))
            gw[].lowerDepth = (G[].Aquifer[unsafe_offset=Int(gw[].aquifer)].bottomElev - (Float64(G[].SubcatchResults[unsafe_offset=6]) / UCF(G, Int32(3))))
            gw[].theta = Float64(G[].SubcatchResults[unsafe_offset=7])
        i = Int32(0)
        while (i < G[].Nobjects[unsafe_offset=4]):
            (G[].Subcatch[unsafe_offset=Int(j)].newQual)[unsafe_offset=Int(i)] = Float64(G[].SubcatchResults[unsafe_offset=Int((Int32(8) + i))])
            i += 1
        j += 1
    if (kount < (Int32(1) + (G[].Nobjects[unsafe_offset=1] * nResults))):
        report_writeErrorMsg(G, Int32(329), rt.s(""))
        G[].R_[].sp = __sp
        return
    G[].OldRunoffTime = G[].NewRunoffTime
    G[].NewRunoffTime = (G[].OldRunoffTime + (Float64(tStep[]) * Float64(1000.0)))
    G[].NewRunoffTime = (G[].NewRunoffTime if (G[].NewRunoffTime <= G[].TotalDuration) else G[].TotalDuration)
    G[].runoff_Nsteps += 1
    G[].R_[].sp = __sp


# runoff.c:491
def runoff_getOutfallRunon(G: P[Globals], tStep: Float64):
    var i: Int32 = Int32(0)
    var k: Int32 = Int32(0)
    var p: Int32 = Int32(0)
    var w: Float64 = Float64(0.0)
    i = Int32(0)
    while (i < G[].Nnodes[unsafe_offset=1]):
        k = G[].Outfall[unsafe_offset=Int(i)].routeTo
        if (k < Int32(0)):
            i += 1
            continue
        if (G[].Subcatch[unsafe_offset=Int(k)].area == Float64(0.0)):
            i += 1
            continue
        subcatch_addRunonFlow(G, k, (G[].Outfall[unsafe_offset=Int(i)].vRouted / tStep))
        massbal_updateRunoffTotals(G, Int32(5), G[].Outfall[unsafe_offset=Int(i)].vRouted)
        G[].Outfall[unsafe_offset=Int(i)].vRouted = Float64(0.0)
        p = Int32(0)
        while (p < G[].Nobjects[unsafe_offset=4]):
            w = ((G[].Outfall[unsafe_offset=Int(i)].wRouted)[unsafe_offset=Int(p)] * Float64(28.317))
            massbal_updateLoadingTotals(G, Int32(1), p, (w * G[].Pollut[unsafe_offset=Int(p)].mcf))
            (G[].Subcatch[unsafe_offset=Int(k)].newQual)[unsafe_offset=Int(p)] = ((G[].Subcatch[unsafe_offset=Int(k)].newQual)[unsafe_offset=Int(p)] + (w / tStep))
            (G[].Outfall[unsafe_offset=Int(i)].wRouted)[unsafe_offset=Int(p)] = Float64(0.0)
            p += 1
        i += 1


# shape.c:42
def shape_validate(G: P[Globals], shape: P[TShape], curve: P[TTable]) -> Int32:
    if (not (computeShapeTables(G, shape, curve) != 0)):
        return Int32(0)
    if (not (normalizeShapeTables(G, shape) != 0)):
        return Int32(0)
    return Int32(1)


# shape.c:64
def computeShapeTables(G: P[Globals], shape: P[TShape], curve: P[TTable]) -> Int32:
    var i: Int32 = Int32(0)
    var n: Int32 = Int32(0)
    var dy: Float64 = Float64(0.0)
    var y: Float64 = Float64(0.0)
    var w: Float64 = Float64(0.0)
    var yLast: Float64 = Float64(0.0)
    var wLast: Float64 = Float64(0.0)
    var __rv: Int32 = Int32(0)
    var __sp = G[].R_[].sp
    var y1 = rt.salloc[Float64](G[].R_, 1)
    var y2 = rt.salloc[Float64](G[].R_, 1)
    var w1 = rt.salloc[Float64](G[].R_, 1)
    var w2 = rt.salloc[Float64](G[].R_, 1)
    var wMax = rt.salloc[Float64](G[].R_, 1)
    if (not (table_getFirstEntry(G, curve, y1, w1) != 0)):
        __rv = Int32(0)
        G[].R_[].sp = __sp
        return __rv
    if (((y1[] < Float64(0.0)) or (y1[] >= Float64(1.0))) or (w1[] < Float64(0.0))):
        __rv = Int32(0)
        G[].R_[].sp = __sp
        return __rv
    wMax[] = w1[]
    if (y1[] != Float64(0.0)):
        y2[] = y1[]
        w2[] = w1[]
        y1[] = Float64(0.0)
        w1[] = Float64(0.0)
    else:
        if (not (table_getNextEntry(G, curve, y2, w2) != 0)):
            __rv = Int32(0)
            G[].R_[].sp = __sp
            return __rv
        if ((y2[] < y1[]) or (w2[] < Float64(0.0))):
            __rv = Int32(0)
            G[].R_[].sp = __sp
            return __rv
        if (y2[] > Float64(1.0)):
            y2[] = Float64(1.0)
        if (w2[] > wMax[]):
            wMax[] = w2[]
    shape[].nTbl = Int32(51)
    n = (shape[].nTbl - Int32(1))
    dy = (Float64(1.0) / Float64(n))
    (rt.addr(shape[].areaTbl).unsafe_bitcast[Float64]())[unsafe_offset=0] = Float64(0.0)
    (rt.addr(shape[].hradTbl).unsafe_bitcast[Float64]())[unsafe_offset=0] = Float64(0.0)
    (rt.addr(shape[].widthTbl).unsafe_bitcast[Float64]())[unsafe_offset=0] = w1[]
    G[].Ptotal = w1[]
    G[].Atotal = Float64(0.0)
    y = Float64(0.0)
    w = w1[]
    i = Int32(1)
    while (i <= n):
        yLast = y
        wLast = w
        y = (y + dy)
        if (rt.fabs((y - Float64(1.0))) < Float64(1e-06)):
            y = Float64(1.0)
        if (y > y2[]):
            if (not (getNextInterval(G, curve, y, yLast, wLast, y1, y2, w1, w2, wMax) != 0)):
                __rv = Int32(0)
                G[].R_[].sp = __sp
                return __rv
