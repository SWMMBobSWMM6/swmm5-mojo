        q1 = (G[].OldIfaceValues[unsafe_offset=Int(index)])[unsafe_offset=0]
        q2 = (G[].NewIfaceValues[unsafe_offset=Int(index)])[unsafe_offset=0]
        return (((Float64(1.0) - G[].IfaceFrac) * q1) + (G[].IfaceFrac * q2))
    else:
        return Float64(0.0)
    return Float64(0.0)


