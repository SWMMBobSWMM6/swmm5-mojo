# link.c:821
def link_getVelocity(G: P[Globals], j: Int32, var flow: Float64, depth: Float64) -> Float64:
    var area: Float64 = Float64(0.0)
    var veloc: Float64 = Float64(0.0)
    var k: Int32 = Int32(0)
    veloc = Float64(0.0)
    if (depth <= Float64(0.01)):
        return Float64(0.0)
    if (G[].Link[unsafe_offset=Int(j)].type == Int32(0)):
        k = G[].Link[unsafe_offset=Int(j)].subIndex
        flow = (flow / Float64(Int32(G[].Conduit[unsafe_offset=Int(k)].barrels)))
        area = xsect_getAofY(G, rt.addr(G[].Link[unsafe_offset=Int(j)].xsect), depth)
        if (area > Float64(0.0001)):
            veloc = (flow / area)
    return veloc


# link.c:847
def link_getFroude(G: P[Globals], j: Int32, v: Float64, var y: Float64) -> Float64:
    var xsect: P[TXsect] = rt.null[TXsect]()
    xsect = rt.addr(G[].Link[unsafe_offset=Int(j)].xsect)
    if (G[].Link[unsafe_offset=Int(j)].type != Int32(0)):
        return Float64(0.0)
    if (y <= Float64(0.0001)):
        return Float64(0.0)
    if ((not (xsect_isOpen(G, xsect[].type) != 0)) and ((xsect[].yFull - y) <= Float64(0.0001))):
        return Float64(0.0)
    y = (xsect_getAofY(G, xsect, y) / xsect_getWofY(G, xsect, y))
    return (rt.fabs(v) / sqrt((Float64(32.2) * y)))


