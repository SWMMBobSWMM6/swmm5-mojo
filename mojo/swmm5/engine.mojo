def addGroundwaterInflows(G: P[Globals], routingTime: Float64):
    var i: Int32 = Int32(0)
    var j: Int32 = Int32(0)
    var p: Int32 = Int32(0)
    var q: Float64 = Float64(0.0)
    var w: Float64 = Float64(0.0)
    var f: Float64 = Float64(0.0)
    var gw: P[TGroundwater] = rt.null[TGroundwater]()
    if (G[].Nobjects[unsafe_offset=1] == Int32(0)):
        return
    f = ((routingTime - G[].OldRunoffTime) / (G[].NewRunoffTime - G[].OldRunoffTime))
    if (f < Float64(0.0)):
        f = Float64(0.0)
    if (f > Float64(1.0)):
        f = Float64(1.0)
    i = Int32(0)
    while (i < G[].Nobjects[unsafe_offset=1]):
        gw = G[].Subcatch[unsafe_offset=Int(i)].groundwater
        if (not rt.isnull(gw)):
            j = gw[].node
            if (j >= Int32(0)):
                q = ((((Float64(1.0) - f) * gw[].oldFlow) + (f * gw[].newFlow)) * G[].Subcatch[unsafe_offset=Int(i)].area)
                if (rt.fabs(q) < Float64(1e-05)):
                    i += 1
                    continue
                G[].Node[unsafe_offset=Int(j)].newLatFlow = (G[].Node[unsafe_offset=Int(j)].newLatFlow + q)
                massbal_addInflowFlow(G, Int32(3), q)
                if (q > Float64(0.0)):
                    p = Int32(0)
