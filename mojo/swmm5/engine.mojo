# controls.c:495
def controls_evaluate(G: P[Globals], currentTime: Float64, elapsedTime: Float64, tStep: Float64) -> Int32:
    var r: Int32 = Int32(0)
    var result: Int32 = Int32(0)
    var p: P[TPremise] = rt.null[TPremise]()
    var a: P[TAction] = rt.null[TAction]()
    G[].CurrentDate = floor(currentTime)
    G[].CurrentTime = (currentTime - floor(currentTime))
    G[].ElapsedTime = elapsedTime
    if (G[].RuleCount == Int32(0)):
        return Int32(0)
    clearActionList(G)
    r = Int32(0)
    while (r < G[].RuleCount):
        result = Int32(1)
        p = G[].Rules[unsafe_offset=Int(r)].firstPremise
        while (not rt.isnull(p)):
            if (p[].type == Int32(3)):
                if (result == Int32(0)):
                    result = evaluatePremise(G, p, tStep)
            else:
                if (result == Int32(0)):
                    break
                result = evaluatePremise(G, p, tStep)
            p = p[].next
        if (result == Int32(1)):
            a = G[].Rules[unsafe_offset=Int(r)].thenActions
        else:
            a = G[].Rules[unsafe_offset=Int(r)].elseActions
        while (not rt.isnull(a)):
            updateActionValue(G, a, currentTime, tStep)
            updateActionList(G, a)
            a = a[].next
        r += 1
    if (not rt.isnull(G[].ActionList)):
        return executeActionList(G, currentTime)
    else:
        return Int32(0)
    return Int32(0)


