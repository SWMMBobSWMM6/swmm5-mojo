    var curbLength: Float64 = Float64(0.0)
    var i: Int32 = Int32(0)
    var grateType: Int32 = Int32(0)
    area = Float64(0.0)
    i = inlet[].designIndex
    grateType = G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.type
    if (G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.length > Float64(0.0)):
        area = (G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.length * G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.width)
        if (grateType == Int32(7)):
            area = (area * G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.fracOpenArea)
        else:
            area = (area * G[].GrateOpeningRatios[unsafe_offset=Int(grateType)])
    curbLength = (G[].InletDesigns[unsafe_offset=Int(i)].curbInlet.length - G[].InletDesigns[unsafe_offset=Int(i)].grateInlet.length)
    if (curbLength > Float64(0.0)):
        area = (area + (curbLength * G[].InletDesigns[unsafe_offset=Int(i)].curbInlet.height))
    if (G[].InletDesigns[unsafe_offset=Int(i)].slottedInlet.length > Float64(0.0)):
        area = (G[].InletDesigns[unsafe_offset=Int(i)].slottedInlet.length * G[].InletDesigns[unsafe_offset=Int(i)].slottedInlet.width)
    return ((area * Float64(inlet[].numInlets)) * inlet[].clogFactor)


