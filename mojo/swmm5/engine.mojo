    yNorm = Float64(0.0)
    if (G[].Node[unsafe_offset=Int(G[].Link[unsafe_offset=Int(j)].node2)].type == Int32(1)):
        n = G[].Link[unsafe_offset=Int(j)].node2
        z = G[].Link[unsafe_offset=Int(j)].offset2
    elif (G[].Node[unsafe_offset=Int(G[].Link[unsafe_offset=Int(j)].node1)].type == Int32(1)):
        n = G[].Link[unsafe_offset=Int(j)].node1
        z = G[].Link[unsafe_offset=Int(j)].offset1
    else:
        return
    if (G[].Link[unsafe_offset=Int(j)].type == Int32(0)):
        k = G[].Link[unsafe_offset=Int(j)].subIndex
        q = rt.fabs((G[].Link[unsafe_offset=Int(j)].newFlow / Float64(Int32(G[].Conduit[unsafe_offset=Int(k)].barrels))))
