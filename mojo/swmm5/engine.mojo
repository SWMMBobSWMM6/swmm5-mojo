    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Total Precipitation ......%14.3f%14.3f"), rt.ad(((totals[].rainfall * UCF(G, Int32(3))) * UCF(G, Int32(4)))), rt.ad(((totals[].rainfall / totalArea) * UCF(G, Int32(1)))))
    if (totals[].runon > Float64(0.0)):
