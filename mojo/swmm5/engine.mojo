        return error_setInpError(G, Int32(203), rt.s(""))
    if (match_(G, tok[unsafe_offset=0], rt.s("VARIABLE")) != 0):
        return controls_addVariable(G, tok, ntoks)
    if (match_(G, tok[unsafe_offset=0], rt.s("EXPRESSION")) != 0):
        return controls_addExpression(G, tok, ntoks)
    keyword = findmatch(G, tok[unsafe_offset=0], G[].RuleKeyWords)
    if (keyword < Int32(0)):
        return error_setInpError(G, Int32(205), tok[unsafe_offset=0])
    if (keyword == Int32(0)):
        if (not (project_addObject(G, Int32(9), tok[unsafe_offset=1], G[].Mobjects[unsafe_offset=9]) != 0)):
            return error_setInpError(G, Int32(207), G[].Tok[unsafe_offset=1])
        G[].Mobjects[unsafe_offset=9] += 1
    index = (G[].Mobjects[unsafe_offset=9] - Int32(1))
    if (index < Int32(0)):
        return error_setInpError(G, Int32(217), rt.s(""))
    return controls_addRuleClause(G, index, keyword, G[].Tok, G[].Ntokens)


