                    (G[].Outfall[unsafe_offset=Int(k)].wRouted)[unsafe_offset=Int(p)] = ((G[].Outfall[unsafe_offset=Int(k)].wRouted)[unsafe_offset=Int(p)] + ((G[].Node[unsafe_offset=Int(i)].newQual)[unsafe_offset=Int(p)] * v))
                    p += 1
        q = node_getSystemOutflow(G, i, isFlooded)
        if (q > Float64(0.0)):
            massbal_addOutflowFlow(G, q, isFlooded[])
            p = Int32(0)
            while (p < G[].Nobjects[unsafe_offset=4]):
                w = (q * (G[].Node[unsafe_offset=Int(i)].newQual)[unsafe_offset=Int(p)])
                massbal_addOutflowQual(G, p, w, isFlooded[])
                p += 1
        else:
            massbal_addInflowFlow(G, Int32(0), (-q))
        q = G[].Node[unsafe_offset=Int(i)].newLatFlow
        if (q < Float64(0.0)):
            p = Int32(0)
            while (p < G[].Nobjects[unsafe_offset=4]):
                w = ((-q) * (G[].Node[unsafe_offset=Int(i)].newQual)[unsafe_offset=Int(p)])
                massbal_addOutflowQual(G, p, w, Int32(0))
