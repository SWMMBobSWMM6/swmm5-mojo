    if (infil[].Sat != 0):
        return grnampt_getSatInfil(G, infil, tstep, irate, depth)
    else:
        return grnampt_getUnsatInfil(G, infil, tstep, irate, depth, modelType)
    return Float64(0.0)


# infil.c:660
def grnampt_getUnsatInfil(G: P[Globals], infil: P[TGrnAmpt], tstep: Float64, irate: Float64, depth: Float64, modelType: Int32) -> Float64:
    var ia: Float64 = Float64(0.0)
    var c1: Float64 = Float64(0.0)
    var F2: Float64 = Float64(0.0)
    var dF: Float64 = Float64(0.0)
    var Fs: Float64 = Float64(0.0)
    var kr: Float64 = Float64(0.0)
    var ts: Float64 = Float64(0.0)
    var ks: Float64 = Float64(0.0)
    var lu: Float64 = Float64(0.0)
    ks = (infil[].Ks * G[].InfilFactor)
    lu = (infil[].Lu * sqrt(G[].InfilFactor))
    ia = (irate + (depth / tstep))
    if (ia < Float64(1e-10)):
        ia = Float64(0.0)
    if (ia == Float64(0.0)):
        if (infil[].Fu <= Float64(0.0)):
            return Float64(0.0)
        kr = ((lu / Float64(90000.0)) * G[].Evap.recoveryFactor)
        dF = ((kr * G[].Fumax) * tstep)
        infil[].F = (infil[].F - dF)
        infil[].Fu = (infil[].Fu - dF)
        if (infil[].Fu <= Float64(0.0)):
            infil[].Fu = Float64(0.0)
            infil[].F = Float64(0.0)
            infil[].IMD = infil[].IMDmax
            return Float64(0.0)
        if (infil[].T <= Float64(0.0)):
            infil[].IMD = ((G[].Fumax - infil[].Fu) / lu)
            infil[].F = Float64(0.0)
        return Float64(0.0)
    if (ia <= ks):
        dF = (ia * tstep)
        infil[].F = (infil[].F + dF)
        infil[].Fu = (infil[].Fu + dF)
        infil[].Fu = (infil[].Fu if (infil[].Fu <= G[].Fumax) else G[].Fumax)
        if ((modelType == Int32(2)) and (infil[].T <= Float64(0.0))):
            infil[].IMD = ((G[].Fumax - infil[].Fu) / lu)
            infil[].F = Float64(0.0)
        return ia
    infil[].T = ((Float64(5400.0) / lu) / G[].Evap.recoveryFactor)
    Fs = (((ks * (infil[].S + depth)) * infil[].IMD) / (ia - ks))
    if (infil[].F > Fs):
        infil[].Sat = Int8(1)
        return grnampt_getSatInfil(G, infil, tstep, irate, depth)
    if ((infil[].F + (ia * tstep)) < Fs):
        dF = (ia * tstep)
        infil[].F = (infil[].F + dF)
        infil[].Fu = (infil[].Fu + dF)
        infil[].Fu = (infil[].Fu if (infil[].Fu <= G[].Fumax) else G[].Fumax)
        return ia
    ts = (tstep - ((Fs - infil[].F) / ia))
    if (ts <= Float64(0.0)):
        ts = Float64(0.0)
    c1 = ((infil[].S + depth) * infil[].IMD)
    F2 = grnampt_getF2(G, Fs, c1, ks, ts)
    if (F2 > (Fs + (ia * ts))):
        F2 = (Fs + (ia * ts))
    dF = (F2 - infil[].F)
    infil[].F = F2
    infil[].Fu = (infil[].Fu + dF)
    infil[].Fu = (infil[].Fu if (infil[].Fu <= G[].Fumax) else G[].Fumax)
    infil[].Sat = Int8(1)
    return (dF / tstep)


# infil.c:767
def grnampt_getSatInfil(G: P[Globals], infil: P[TGrnAmpt], tstep: Float64, irate: Float64, depth: Float64) -> Float64:
    var ia: Float64 = Float64(0.0)
    var c1: Float64 = Float64(0.0)
    var dF: Float64 = Float64(0.0)
    var F2: Float64 = Float64(0.0)
    var ks: Float64 = Float64(0.0)
    var lu: Float64 = Float64(0.0)
    ks = (infil[].Ks * G[].InfilFactor)
    lu = (infil[].Lu * sqrt(G[].InfilFactor))
    ia = (irate + (depth / tstep))
    if (ia < Float64(1e-10)):
        return Float64(0.0)
    infil[].T = ((Float64(5400.0) / lu) / G[].Evap.recoveryFactor)
    c1 = ((infil[].S + depth) * infil[].IMD)
    F2 = grnampt_getF2(G, infil[].F, c1, ks, tstep)
    dF = (F2 - infil[].F)
    if (dF > (ia * tstep)):
        dF = (ia * tstep)
        infil[].Sat = Int8(0)
    infil[].F = (infil[].F + dF)
    infil[].Fu = (infil[].Fu + dF)
    infil[].Fu = (infil[].Fu if (infil[].Fu <= G[].Fumax) else G[].Fumax)
    return (dF / tstep)


# infil.c:813
def grnampt_getF2(G: P[Globals], f1: Float64, c1: Float64, ks: Float64, ts: Float64) -> Float64:
    var i: Int32 = Int32(0)
    var f2: Float64 = Float64(0.0)
    var f2min: Float64 = Float64(0.0)
    var df2: Float64 = Float64(0.0)
    var c2: Float64 = Float64(0.0)
    f2 = f1
    f2min = (f1 + (ks * ts))
