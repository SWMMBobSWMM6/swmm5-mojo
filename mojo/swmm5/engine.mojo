    if (__sw2 == Int32(2)) or (__sw2 == Int32(3)) or (__sw2 == Int32(4)):
        if ((G[].Node[unsafe_offset=Int(G[].Link[unsafe_offset=Int(j)].node1)].invertElev + G[].Link[unsafe_offset=Int(j)].offset1) < G[].Node[unsafe_offset=Int(G[].Link[unsafe_offset=Int(j)].node2)].invertElev):
