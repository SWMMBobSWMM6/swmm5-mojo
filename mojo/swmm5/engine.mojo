# report.c:1037
def report_writeTimeStepStats(G: P[Globals], timeStepStats: P[TTimeStepStats]):
    var timeStepCount: Float64 = Float64(0.0)
    var totalRoutingTime: Float64 = Float64(0.0)
    var fSteadyState: Float64 = Float64(0.0)
    timeStepCount = Float64(timeStepStats[].timeStepCount)
    fSteadyState = Float64(0.0)
    if ((G[].Nobjects[unsafe_offset=3] == Int32(0)) or (Float64(timeStepStats[].timeStepCount) == Float64(0.0))):
        return
    totalRoutingTime = (timeStepStats[].steadyStateTime + timeStepStats[].routingTime)
    if (totalRoutingTime > Float64(0.0)):
        fSteadyState = ((Float64(100.0) * timeStepStats[].steadyStateTime) / totalRoutingTime)
    report_writeLine(G, rt.s(""))
    report_writeLine(G, rt.s("*************************"))
    report_writeLine(G, rt.s("Routing Time Step Summary"))
    report_writeLine(G, rt.s("*************************"))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Minimum Time Step           :  %7.2f sec"), rt.ad(timeStepStats[].minTimeStep))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Average Time Step           :  %7.2f sec"), rt.ad((timeStepStats[].routingTime / timeStepCount)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Maximum Time Step           :  %7.2f sec"), rt.ad(timeStepStats[].maxTimeStep))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  %% of Time in Steady State   :  %7.2f"), rt.ad((fSteadyState if (fSteadyState <= (Float64(100.0))) else (Float64(100.0)))))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Average Iterations per Step :  %7.2f"), rt.ad((timeStepStats[].trialsCount / timeStepCount)))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  %% of Steps Not Converging   :  %7.2f"), rt.ad(((Float64(100.0) * Float64(G[].NonConvergeCount)) / timeStepCount)))
    if ((G[].RouteModel == Int32(4)) and (G[].CourantFactor > Float64(0.0))):
        report_RouteStepFreq(G, timeStepStats)
    report_writeLine(G, rt.s(""))


# report.c:1085
def report_RouteStepFreq(G: P[Globals], timeStepStats: P[TTimeStepStats]):
    var totalSteps: Float64 = Float64(0.0)
    var i: Int32 = Int32(0)
    totalSteps = Float64(0.0)
    i = Int32(1)
    while (i < Int32(6)):
        totalSteps = (totalSteps + Float64((rt.addr(timeStepStats[].timeStepCounts).unsafe_bitcast[Int32]())[unsafe_offset=Int(i)]))
        i += 1
    if (totalSteps == Float64(0.0)):
        return
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Time Step Frequencies       :"))
    i = Int32(1)
    while (i < Int32(6)):
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n     %6.3f - %6.3f sec      :  %7.2f %%"), rt.ad((rt.addr(timeStepStats[].timeStepIntervals).unsafe_bitcast[Float64]())[unsafe_offset=Int((i - Int32(1)))]), rt.ad((rt.addr(timeStepStats[].timeStepIntervals).unsafe_bitcast[Float64]())[unsafe_offset=Int(i)]), rt.ad(((Float64(100.0) * Float64(((rt.addr(timeStepStats[].timeStepCounts).unsafe_bitcast[Int32]())[unsafe_offset=Int(i)]))) / totalSteps)))
        i += 1


# report.c:1113
def report_writeReport(G: P[Globals]):
    if (G[].ErrorCode != 0):
        return
    if (G[].Nperiods == Int64(0)):
        return
    if ((Int32(G[].RptFlags.subcatchments) != Int32(0)) and (((G[].IgnoreRainfall == Int32(0)) or (G[].IgnoreSnowmelt == Int32(0))) or (G[].IgnoreGwater == Int32(0)))):
        report_Subcatchments(G)
    if ((G[].IgnoreRouting == Int32(1)) and (G[].IgnoreQuality == Int32(1))):
        return
    if (Int32(G[].RptFlags.nodes) != Int32(0)):
        report_Nodes(G)
    if (Int32(G[].RptFlags.links) != Int32(0)):
        report_Links(G)


