# report.c:599
def report_LoadingErrors(G: P[Globals], p1: Int32, p2: Int32, totals: P[TLoadingTotals]):
    var i: Int32 = Int32(0)
    var p: Int32 = Int32(0)
    var cf: Float64 = Float64(0.0)
    var __sp = G[].R_[].sp
    var units = rt.salloc[Int8](G[].R_, 15)
    cf = Float64(1.0)
    report_writeLine(G, rt.s(""))
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  **************************"))
    p = p1
    while (p <= p2):
        _ = rt.fprintf(G[].Frpt.file, rt.s("%14s"), rt.astr(G[].Pollut[unsafe_offset=Int(p)].ID))
        p += 1
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Runoff Quality Continuity "))
    p = p1
    while (p <= p2):
        i = G[].UnitSystem
        if (G[].Pollut[unsafe_offset=Int(p)].units == Int32(2)):
            i = Int32(2)
        _ = sstrncpy(G, units, G[].LoadUnitsWords[unsafe_offset=Int(i)], UInt64(14))
        _ = rt.fprintf(G[].Frpt.file, rt.s("%14s"), rt.astr(units))
        p += 1
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  **************************"))
    p = p1
    while (p <= p2):
        _ = rt.fprintf(G[].Frpt.file, rt.s("    ----------"))
        p += 1
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Initial Buildup .........."))
    p = p1
    while (p <= p2):
        _ = rt.fprintf(G[].Frpt.file, rt.s("%14.3f"), rt.ad((totals[unsafe_offset=Int(p)].initLoad * cf)))
        p += 1
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Surface Buildup .........."))
    p = p1
    while (p <= p2):
        _ = rt.fprintf(G[].Frpt.file, rt.s("%14.3f"), rt.ad((totals[unsafe_offset=Int(p)].buildup * cf)))
        p += 1
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Wet Deposition ..........."))
    p = p1
    while (p <= p2):
        _ = rt.fprintf(G[].Frpt.file, rt.s("%14.3f"), rt.ad((totals[unsafe_offset=Int(p)].deposition * cf)))
        p += 1
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Sweeping Removal ........."))
    p = p1
    while (p <= p2):
        _ = rt.fprintf(G[].Frpt.file, rt.s("%14.3f"), rt.ad((totals[unsafe_offset=Int(p)].sweeping * cf)))
        p += 1
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  Infiltration Loss ........"))
    p = p1
    while (p <= p2):
        _ = rt.fprintf(G[].Frpt.file, rt.s("%14.3f"), rt.ad((totals[unsafe_offset=Int(p)].infil * cf)))
        p += 1
    _ = rt.fprintf(G[].Frpt.file, rt.s("\n  BMP Removal .............."))
    p = p1
    while (p <= p2):
        _ = rt.fprintf(G[].Frpt.file, rt.s("%14.3f"), rt.ad((totals[unsafe_offset=Int(p)].bmpRemoval * cf)))
        p += 1
