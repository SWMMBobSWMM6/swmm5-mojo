        G[].Node[unsafe_offset=Int(n)].fullDepth = ((G[].Node[unsafe_offset=Int(n)].fullDepth) if ((G[].Node[unsafe_offset=Int(n)].fullDepth) >= (G[].Link[unsafe_offset=Int(j)].offset1 + G[].Link[unsafe_offset=Int(j)].xsect.yFull)) else (G[].Link[unsafe_offset=Int(j)].offset1 + G[].Link[unsafe_offset=Int(j)].xsect.yFull))
    n = G[].Link[unsafe_offset=Int(j)].node2
    if (((G[].Node[unsafe_offset=Int(n)].type != Int32(2)) or (G[].Node[unsafe_offset=Int(n)].surDepth > Float64(0.0))) and (G[].Link[unsafe_offset=Int(j)].type == Int32(0))):
