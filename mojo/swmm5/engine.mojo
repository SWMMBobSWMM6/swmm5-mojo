    var upperFrac: Float64 = Float64(0.0)
    G[].UpperEvap = Float64(0.0)
    G[].LowerEvap = Float64(0.0)
    if (G[].gwater_Infil > Float64(0.0)):
        return
    upperFrac = G[].A.upperEvapFrac
    f = Float64(1.0)
    p = G[].A.upperEvapPat
    if (p >= Int32(0)):
        month = datetime_monthOfYear(G, getDateTime(G, G[].NewRunoffTime))
        f = (rt.addr(G[].Pattern[unsafe_offset=Int(p)].factor).unsafe_bitcast[Float64]())[unsafe_offset=Int((month - Int32(1)))]
    upperFrac = (upperFrac * f)
    if (theta > G[].A.wiltingPoint):
        G[].UpperEvap = (upperFrac * G[].MaxEvap)
        G[].UpperEvap = (G[].UpperEvap if (G[].UpperEvap <= G[].AvailEvap) else G[].AvailEvap)
    if (G[].A.lowerEvapDepth > Float64(0.0)):
        lowerFrac = ((G[].A.lowerEvapDepth - upperDepth) / G[].A.lowerEvapDepth)
        lowerFrac = ((Float64(0.0)) if ((Float64(0.0)) >= lowerFrac) else lowerFrac)
        lowerFrac = (lowerFrac if (lowerFrac <= (Float64(1.0))) else (Float64(1.0)))
        G[].LowerEvap = ((lowerFrac * (Float64(1.0) - upperFrac)) * G[].MaxEvap)
        G[].LowerEvap = (G[].LowerEvap if (G[].LowerEvap <= (G[].AvailEvap - G[].UpperEvap)) else (G[].AvailEvap - G[].UpperEvap))


# gwater.c:769
def getUpperPerc(G: P[Globals], theta: Float64, upperDepth: Float64) -> Float64:
    var delta: Float64 = Float64(0.0)
    var dhdz: Float64 = Float64(0.0)
    var hydcon: Float64 = Float64(0.0)
    if ((upperDepth <= Float64(0.0)) or (theta <= G[].A.fieldCapacity)):
        return Float64(0.0)
    delta = (theta - G[].A.porosity)
    hydcon = (G[].A.conductivity * rt.exp((delta * G[].A.conductSlope)))
    delta = (theta - G[].A.fieldCapacity)
    dhdz = (Float64(1.0) + (((G[].A.tensionSlope * Float64(2.0)) * delta) / upperDepth))
    G[].HydCon = hydcon
    return (hydcon * dhdz)


