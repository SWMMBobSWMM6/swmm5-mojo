                qIncrement = ((inlet[].clogFactor * table_lookupEx(G, G[].Curve.unsafe_offset(Int(c)), (qBypassed * UCF(G, Int32(10))))) / UCF(G, Int32(10)))
                qIncrement = (qIncrement if (qIncrement <= qMax) else qMax)
                qIncrement = (qIncrement if (qIncrement <= qBypassed) else qBypassed)
                qCaptured = (qCaptured + qIncrement)
                qBypassed = (qBypassed - qIncrement)
                if (qBypassed < Float64(0.001)):
                    break
                j += 1
