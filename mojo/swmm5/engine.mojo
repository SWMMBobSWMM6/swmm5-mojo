# roadway.c:85
def roadway_getInflow(G: P[Globals], j: Int32, dir: Float64, hRoad: Float64, h1: Float64, h2: Float64) -> Float64:
    var k: Int32 = Int32(0)
    var roadSurf: Int32 = Int32(0)
    var useVariableCd: Int32 = Int32(0)
    var length: Float64 = Float64(0.0)
    var roadWidth: Float64 = Float64(0.0)
    var hWr: Float64 = Float64(0.0)
    var ht: Float64 = Float64(0.0)
    var cD: Float64 = Float64(0.0)
    var q: Float64 = Float64(0.0)
    var dqdh: Float64 = Float64(0.0)
    q = Float64(0.0)
    dqdh = Float64(0.0)
    if (G[].Link[unsafe_offset=Int(j)].type != Int32(3)):
        return Float64(0.0)
    k = G[].Link[unsafe_offset=Int(j)].subIndex
    roadWidth = G[].Weir[unsafe_offset=Int(k)].roadWidth
    roadSurf = G[].Weir[unsafe_offset=Int(k)].roadSurface
    cD = G[].Weir[unsafe_offset=Int(k)].cDisch1
    if (G[].UnitSystem == Int32(1)):
        cD = (cD / Float64(0.552))
    useVariableCd = Int32(0)
    if ((roadWidth > Float64(0.0)) and (roadSurf >= Int32(1))):
        useVariableCd = Int32(1)
    hWr = (h1 - hRoad)
    ht = (h2 - hRoad)
    if (hWr > Float64(0.0001)):
        if (useVariableCd != 0):
            cD = getCd(G, hWr, ht, roadWidth, roadSurf)
        length = G[].Link[unsafe_offset=Int(j)].xsect.wMax
        q = ((cD * length) * rt.pow(hWr, Float64(1.5)))
        dqdh = ((Float64(1.5) * q) / hWr)
    G[].Link[unsafe_offset=Int(j)].dqdh = dqdh
    G[].Link[unsafe_offset=Int(j)].newDepth = ((h1 - hRoad) if ((h1 - hRoad) >= (Float64(0.0))) else (Float64(0.0)))
    G[].Link[unsafe_offset=Int(j)].flowClass = Int32(3)
    if (hRoad > h2):
        if (dir == Float64(1.0)):
            G[].Link[unsafe_offset=Int(j)].flowClass = Int32(6)
        else:
            G[].Link[unsafe_offset=Int(j)].flowClass = Int32(5)
    return (dir * q)


# roadway.c:146
def getCd(G: P[Globals], hWr: Float64, ht: Float64, roadWidth: Float64, roadSurf: Int32) -> Float64:
    var kT: Float64 = Float64(0.0)
    var hL: Float64 = Float64(0.0)
    var htH: Float64 = Float64(0.0)
    var cR: Float64 = Float64(0.0)
    kT = Float64(1.0)
    if (hWr <= Float64(0.0)):
        return Float64(0.0)
    hL = (hWr / roadWidth)
    if (hL <= Float64(0.15)):
        if (roadSurf == Int32(1)):
            cR = getY(G, hWr, G[].Cr_Low_Paved, G[].N_Cr_Low_Paved)
        else:
            cR = getY(G, hWr, G[].Cr_Low_Gravel, G[].N_Cr_Low_Gravel)
    else:
        if (roadSurf == Int32(1)):
            cR = getY(G, hL, G[].Cr_High_Paved, G[].N_Cr_High_Paved)
        else:
            cR = getY(G, hL, G[].Cr_High_Gravel, G[].N_Cr_High_Gravel)
    if (ht > Float64(0.0)):
        htH = (ht / hWr)
        if (roadSurf == Int32(1)):
            kT = getY(G, htH, G[].Kt_Paved, G[].N_Kt_Paved)
        else:
            kT = getY(G, htH, G[].Kt_Gravel, G[].N_Kt_Gravel)
    return (cR * kT)


# roadway.c:176
def getY(G: P[Globals], x: Float64, table: P[Float64], n: Int32) -> Float64:
    var i: Int32 = Int32(0)
    var x1: Float64 = Float64(0.0)
    var y1: Float64 = Float64(0.0)
    var dx: Float64 = Float64(0.0)
    var dy: Float64 = Float64(0.0)
    if (x <= (table.unsafe_offset(0))[unsafe_offset=0]):
        return (table.unsafe_offset(0))[unsafe_offset=1]
    if (x >= (table.unsafe_offset(Int((n - Int32(1))) * 2))[unsafe_offset=0]):
        return (table.unsafe_offset(Int((n - Int32(1))) * 2))[unsafe_offset=1]
    i = Int32(1)
    while (i < n):
        if (x <= (table.unsafe_offset(Int(i) * 2))[unsafe_offset=0]):
            x1 = (table.unsafe_offset(Int((i - Int32(1))) * 2))[unsafe_offset=0]
            dx = ((table.unsafe_offset(Int(i) * 2))[unsafe_offset=0] - x1)
            y1 = (table.unsafe_offset(Int((i - Int32(1))) * 2))[unsafe_offset=1]
            dy = ((table.unsafe_offset(Int(i) * 2))[unsafe_offset=1] - y1)
            return (y1 + (((x - x1) * dy) / dx))
        i += 1
    return (table.unsafe_offset(Int((n - Int32(1))) * 2))[unsafe_offset=1]


# routing.c:93
def routing_open(G: P[Globals]) -> Int32:
    if (not (treatmnt_open(G) != 0)):
        return G[].ErrorCode
    G[].SortedLinks = (rt.null[NoneType]()).unsafe_bitcast[Int32]()
    if (G[].Nobjects[unsafe_offset=3] > Int32(0)):
        G[].SortedLinks = (rt.calloc(UInt64(G[].Nobjects[unsafe_offset=3]), UInt64(4))).unsafe_bitcast[Int32]()
        if (not (not rt.isnull(G[].SortedLinks))):
            report_writeErrorMsg(G, Int32(101), rt.s(""))
            return G[].ErrorCode
        toposort_sortLinks(G, G[].SortedLinks)
        if (G[].ErrorCode != 0):
            return G[].ErrorCode
    iface_openRoutingFiles(G)
    flowrout_init(G, G[].RouteModel)
    if (Int32(G[].Fhotstart1.mode) == Int32(0)):
        qualrout_init(G)
    if (G[].NumEvents > Int32(0)):
        sortEvents(G)
    G[].NextEvent = Int32(0)
    G[].BetweenEvents = Int32((G[].NumEvents > Int32(0)))
    G[].NewRuleTime = Float64(0.0)
    return G[].ErrorCode


# routing.c:134
def routing_close(G: P[Globals], routingModel: Int32):
    iface_closeRoutingFiles(G)
    flowrout_close(G, routingModel)
    treatmnt_close(G)
    if (not rt.isnull(G[].SortedLinks)):
        rt.free(G[].SortedLinks.unsafe_bitcast[NoneType]())
        G[].SortedLinks = (rt.null[NoneType]()).unsafe_bitcast[Int32]()


# routing.c:152
def routing_getRoutingStep(G: P[Globals], routingModel: Int32, fixedStep: Float64) -> Float64:
    var date1: Float64 = Float64(0.0)
    var date2: Float64 = Float64(0.0)
    var nextTime: Float64 = Float64(0.0)
    var routingStep: Float64 = Float64(0.0)
    var nextRuleTime: Float64 = Float64(0.0)
    var nextRoutingTime: Float64 = Float64(0.0)
    routingStep = Float64(0.0)
    if (G[].Nobjects[unsafe_offset=3] == Int32(0)):
        return fixedStep
    if ((G[].NumEvents > Int32(0)) and (G[].BetweenEvents != 0)):
        nextTime = (G[].NewRunoffTime if (G[].NewRunoffTime <= G[].ReportTime) else G[].ReportTime)
        date1 = getDateTime(G, G[].NewRoutingTime)
        date2 = getDateTime(G, nextTime)
        if ((date2 > date1) and (date2 < G[].Event[unsafe_offset=Int(G[].NextEvent)].start)):
            routingStep = ((nextTime - G[].NewRoutingTime) / Float64(1000.0))
        else:
            date1 = getDateTime(G, (G[].NewRoutingTime + (Float64(1000.0) * fixedStep)))
            if (date1 < G[].Event[unsafe_offset=Int(G[].NextEvent)].start):
                return fixedStep
    if (routingStep == Float64(0.0)):
        routingStep = flowrout_getRoutingStep(G, routingModel, fixedStep)
    if (G[].RuleStep > Int32(0)):
        nextRuleTime = (G[].NewRuleTime + (Float64(1000.0) * Float64(G[].RuleStep)))
        nextRoutingTime = (G[].NewRoutingTime + (Float64(1000.0) * routingStep))
        if (nextRoutingTime >= nextRuleTime):
            routingStep = ((nextRuleTime - G[].NewRoutingTime) / Float64(1000.0))
    return routingStep


# routing.c:203
def routing_execute(G: P[Globals], routingModel: Int32, routingStep: Float64):
    var trialsCount: Int32 = Int32(0)
    var actionCount: Int32 = Int32(0)
    var inSteadyState: Int32 = Int32(0)
    var currentDate: Float64 = Float64(0.0)
    var stepFlowError: Float64 = Float64(0.0)
    trialsCount = Int32(1)
    actionCount = Int32(0)
    inSteadyState = Int32(1)
    if (G[].ErrorCode != 0):
        return
    massbal_updateRoutingTotals(G, (routingStep / Float64(2.0)))
    currentDate = getDateTime(G, G[].NewRoutingTime)
    actionCount = evaluateControlRules(G, currentDate, routingStep)
    stepFlowError = massbal_getStepFlowError(G)
    massbal_initTimeStepTotals(G)
    initSystemInflows(G)
    G[].BetweenEvents = isBetweenEvents(G, currentDate)
    if (G[].BetweenEvents == Int32(0)):
        addSystemInflows(G, currentDate, routingStep)
        inlet_findCapturedFlows(G, routingStep)
        inSteadyState = isInSteadyState(G, actionCount, stepFlowError)
        if (inSteadyState == Int32(0)):
            trialsCount = routeFlow(G, routingModel, routingStep)
        if ((G[].Nobjects[unsafe_offset=4] > Int32(0)) and (not (G[].IgnoreQuality != 0))):
            inlet_adjustQualInflows(G)
            qualrout_execute(G, routingStep)
        removeSystemOutflows(G, routingStep)
        inlet_adjustQualOutflows(G)
        if (G[].Nobjects[unsafe_offset=3] > Int32(0)):
            stats_updateFlowStats(G, routingStep, getDateTime(G, G[].NewRoutingTime))
            stats_updateTimeStepStats(G, routingStep, trialsCount, inSteadyState)
    massbal_updateRoutingTotals(G, (routingStep / Float64(2.0)))


# routing.c:269
def evaluateControlRules(G: P[Globals], currentDate: Float64, routingStep: Float64) -> Int32:
    var j: Int32 = Int32(0)
    var actionCount: Int32 = Int32(0)
    actionCount = Int32(0)
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=3]):
        link_setTargetSetting(G, j)
        j += 1
    if ((G[].RuleStep == Int32(0)) or (rt.fabs((G[].NewRoutingTime - G[].NewRuleTime)) < Float64(1.0))):
        _ = controls_evaluate(G, currentDate, (currentDate - G[].StartDateTime), (routingStep / Float64(86400.0)))
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=3]):
        if (G[].Link[unsafe_offset=Int(j)].targetSetting != G[].Link[unsafe_offset=Int(j)].setting):
            if ((G[].Link[unsafe_offset=Int(j)].targetSetting * G[].Link[unsafe_offset=Int(j)].setting) == Float64(0.0)):
                G[].Link[unsafe_offset=Int(j)].timeLastSet = currentDate
            link_setSetting(G, j, routingStep)
            actionCount += 1
        j += 1
    G[].OldRoutingTime = G[].NewRoutingTime
    G[].NewRoutingTime = (G[].NewRoutingTime + (Float64(1000.0) * routingStep))
    if (rt.fabs((G[].NewRoutingTime - (G[].NewRuleTime + (Float64(1000.0) * Float64(G[].RuleStep))))) < Float64(1.0)):
        G[].NewRuleTime = (G[].NewRuleTime + (Float64(1000.0) * Float64(G[].RuleStep)))
    return actionCount


# routing.c:312
def initSystemInflows(G: P[Globals]):
    var j: Int32 = Int32(0)
    if (G[].Nobjects[unsafe_offset=4] > Int32(0)):
        j = Int32(0)
        while (j < G[].Nobjects[unsafe_offset=2]):
            node_setOldQualState(G, j)
            j += 1
        j = Int32(0)
        while (j < G[].Nobjects[unsafe_offset=3]):
            link_setOldQualState(G, j)
            j += 1
    infil_setInfilFactor(G, Int32(-1))
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        G[].Node[unsafe_offset=Int(j)].oldLatFlow = G[].Node[unsafe_offset=Int(j)].newLatFlow
        G[].Node[unsafe_offset=Int(j)].newLatFlow = Float64(0.0)
        j += 1


# routing.c:337
def isBetweenEvents(G: P[Globals], currentDate: Float64) -> Int32:
    if (G[].NumEvents == Int32(0)):
        return Int32(0)
    if (currentDate > G[].Event[unsafe_offset=Int(G[].NextEvent)].end):
        G[].NextEvent += 1
        return Int32(1)
    elif (currentDate >= G[].Event[unsafe_offset=Int(G[].NextEvent)].start):
        return Int32(0)
    return Int32(1)


# routing.c:359
def addSystemInflows(G: P[Globals], currentDate: Float64, routingStep: Float64):
    var j: Int32 = Int32(0)
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        G[].Node[unsafe_offset=Int(j)].losses = node_getLosses(G, j, routingStep)
        j += 1
    addExternalInflows(G, currentDate)
    addDryWeatherInflows(G, currentDate)
    addWetWeatherInflows(G, G[].OldRoutingTime)
    addGroundwaterInflows(G, G[].OldRoutingTime)
    addLidDrainInflows(G, G[].OldRoutingTime)
    addRdiiInflows(G, currentDate)
    addIfaceInflows(G, currentDate)
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        G[].Node[unsafe_offset=Int(j)].qualInflow = ((Float64(0.0)) if ((Float64(0.0)) >= (G[].Node[unsafe_offset=Int(j)].newLatFlow)) else (G[].Node[unsafe_offset=Int(j)].newLatFlow))
        j += 1


# routing.c:383
def isInSteadyState(G: P[Globals], actionCount: Int32, stepFlowError: Float64) -> Int32:
    if (G[].SkipSteadyState != 0):
        if ((((G[].OldRoutingTime == Float64(0.0)) or (actionCount > Int32(0))) or (rt.fabs(stepFlowError) > G[].SysFlowTol)) or (inflowHasChanged(G) != 0)):
            return Int32(0)
        else:
            return Int32(1)
    return Int32(0)


# routing.c:399
def routeFlow(G: P[Globals], routingModel: Int32, routingStep: Float64) -> Int32:
    var j: Int32 = Int32(0)
    var stepCount: Int32 = Int32(0)
    stepCount = Int32(1)
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=3]):
        link_setOldHydState(G, j)
        j += 1
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        node_setOldHydState(G, j)
        j += 1
    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=2]):
        node_initFlows(G, j, routingStep)
        j += 1
    if (G[].Nobjects[unsafe_offset=3] > Int32(0)):
        stepCount = flowrout_execute(G, G[].SortedLinks, routingModel, routingStep)
    return stepCount


# routing.c:425
def removeSystemOutflows(G: P[Globals], routingStep: Float64):
