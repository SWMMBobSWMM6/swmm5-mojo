        inlet[].backflow = Float64(0.0)
        inlet[].stats.flowPeriods = Int32(0)
        inlet[].stats.capturePeriods = Int32(0)
        inlet[].stats.backflowPeriods = Int32(0)
        inlet[].stats.peakFlow = Float64(0.0)
        inlet[].stats.peakFlowCapture = Float64(0.0)
        inlet[].stats.avgFlowCapture = Float64(0.0)
        inlet[].stats.bypassFreq = Float64(0.0)


# inlet.c:985
def updateInletStats(G: P[Globals], inlet: P[TInlet], q: Float64):
    var qCapture: Float64 = Float64(0.0)
    var qBackflow: Float64 = Float64(0.0)
    var qNet: Float64 = Float64(0.0)
    var qBypass: Float64 = Float64(0.0)
    var fCapture: Float64 = Float64(0.0)
    qCapture = inlet[].flowCapture
    qBackflow = inlet[].backflow
    qNet = (qCapture - qBackflow)
    qBypass = (q - qNet)
    fCapture = Float64(0.0)
    if ((q < Float64(0.001)) and (qBackflow <= Float64(0.0))):
        return
    inlet[].stats.flowPeriods += 1
    if (qNet > Float64(0.0)):
        inlet[].stats.capturePeriods += 1
        fCapture = (qNet / q)
        fCapture = (fCapture if (fCapture <= (Float64(1.0))) else (Float64(1.0)))
        inlet[].stats.avgFlowCapture = (inlet[].stats.avgFlowCapture + fCapture)
        if (qBypass > Float64(0.001)):
            inlet[].stats.bypassFreq += Float64(1.0)
    else:
        inlet[].stats.backflowPeriods += 1
    if (q > inlet[].stats.peakFlow):
        inlet[].stats.peakFlow = q
        inlet[].stats.peakFlowCapture = (fCapture * Float64(100.0))


