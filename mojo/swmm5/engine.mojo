    elev = G[].Node[unsafe_offset=Int(G[].Link[unsafe_offset=Int(j)].node1)].invertElev
    G[].Link[unsafe_offset=Int(j)].offset1 = link_getOffsetHeight(G, j, G[].Link[unsafe_offset=Int(j)].offset1, elev)
    if (G[].Link[unsafe_offset=Int(j)].type == Int32(0)):
        elev = G[].Node[unsafe_offset=Int(G[].Link[unsafe_offset=Int(j)].node2)].invertElev
        G[].Link[unsafe_offset=Int(j)].offset2 = link_getOffsetHeight(G, j, G[].Link[unsafe_offset=Int(j)].offset2, elev)
