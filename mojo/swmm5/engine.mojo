        report_writeWarningMsg(G, rt.s("WARNING 04: minimum elevation drop used for Conduit"), G[].Link[unsafe_offset=Int(j)].ID)
        delta = G[].MIN_DELTA_Z
    if (delta >= length):
        report_writeWarningMsg(G, rt.s("WARNING 08: elevation drop exceeds length for Conduit"), G[].Link[unsafe_offset=Int(j)].ID)
        slope = (delta / length)
    else:
