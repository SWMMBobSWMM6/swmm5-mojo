    if (irate > Float64(1e-10)):
        if (infil[].T >= infil[].Tmax):
            infil[].P = Float64(0.0)
            infil[].F = Float64(0.0)
            infil[].f = Float64(0.0)
            infil[].Se = infil[].S
        infil[].T = Float64(0.0)
        infil[].P = (infil[].P + (irate * tstep))
