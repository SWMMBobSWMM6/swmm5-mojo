            f1 = Float64(0.0)
    else:
        if ((depth > Float64(0.004167)) and (infil[].S > Float64(0.0))):
            f1 = infil[].f
            if ((f1 * tstep) > infil[].S):
                f1 = (infil[].S / tstep)
        else:
            infil[].T = (infil[].T + tstep)
    if (f1 > Float64(0.0)):
        f1 = (f1 if (f1 <= fa) else fa)
        f1 = (f1 if (f1 >= (Float64(0.0))) else (Float64(0.0)))
        infil[].F = (infil[].F + (f1 * tstep))
        if (infil[].regen > Float64(0.0)):
            infil[].S = (infil[].S - (f1 * tstep))
            if (infil[].S < Float64(0.0)):
                infil[].S = Float64(0.0)
    else:
        infil[].S = (infil[].S + (((infil[].regen * infil[].Smax) * tstep) * G[].Evap.recoveryFactor))
        if (infil[].S > infil[].Smax):
            infil[].S = infil[].Smax
    infil[].f = f1
    return f1


