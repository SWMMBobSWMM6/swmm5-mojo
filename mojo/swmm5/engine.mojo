def getImpervAreaRunoff(G: P[Globals], j: Int32) -> Float64:
    var i: Int32 = Int32(0)
    var q: Float64 = Float64(0.0)
    var nonLidArea: Float64 = Float64(0.0)
    q = Float64(0.0)
    i = Int32(0)
    while (i <= Int32(1)):
