    var y: Float64 = Float64(0.0)
    var q: Float64 = Float64(0.0)
    var u: Float64 = Float64(0.0)
    var v: Float64 = Float64(0.0)
    var c: Float64 = Float64(0.0)
    var f1: Float64 = Float64(0.0)
    f1 = (Float64(1.0) - f)
    y = ((f1 * G[].Link[unsafe_offset=Int(j)].oldDepth) + (f * G[].Link[unsafe_offset=Int(j)].newDepth))
    q = ((f1 * G[].Link[unsafe_offset=Int(j)].oldFlow) + (f * G[].Link[unsafe_offset=Int(j)].newFlow))
    v = ((f1 * G[].Link[unsafe_offset=Int(j)].oldVolume) + (f * G[].Link[unsafe_offset=Int(j)].newVolume))
    u = link_getVelocity(G, j, q, y)
    c = Float64(0.0)
    if (G[].Link[unsafe_offset=Int(j)].type == Int32(0)):
        if (G[].Link[unsafe_offset=Int(j)].xsect.type != Int32(0)):
            c = (xsect_getAofY(G, rt.addr(G[].Link[unsafe_offset=Int(j)].xsect), y) / G[].Link[unsafe_offset=Int(j)].xsect.aFull)
    else:
        c = G[].Link[unsafe_offset=Int(j)].setting
    if ((G[].Link[unsafe_offset=Int(j)].type == Int32(1)) and ((G[].Link[unsafe_offset=Int(j)].oldFlow * G[].Link[unsafe_offset=Int(j)].newFlow) == Float64(0.0))):
        if (f >= f1):
            q = G[].Link[unsafe_offset=Int(j)].newFlow
        else:
            q = G[].Link[unsafe_offset=Int(j)].oldFlow
    y = (y * UCF(G, Int32(3)))
    v = (v * UCF(G, Int32(5)))
    q = (q * (UCF(G, Int32(10)) * Float64(G[].Link[unsafe_offset=Int(j)].direction)))
    u = (u * (UCF(G, Int32(3)) * Float64(G[].Link[unsafe_offset=Int(j)].direction)))
