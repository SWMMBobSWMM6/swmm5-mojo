    j = Int32(0)
    while (j < G[].Nobjects[unsafe_offset=1]):
        if ((G[].Subcatch[unsafe_offset=Int(j)].area == Float64(0.0)) or (Int(G[].Subcatch[unsafe_offset=Int(j)].groundwater) == Int((rt.null[NoneType]()).unsafe_bitcast[TGroundwater]()))):
            j += 1
            continue
        _ = rt.fprintf(G[].Frpt.file, rt.s("\n  %-20s"), rt.astr(G[].Subcatch[unsafe_offset=Int(j)].ID))
        x[unsafe_offset=0] = ((G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].stats.infil * UCF(G, Int32(1)))
        x[unsafe_offset=1] = ((G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].stats.evap * UCF(G, Int32(1)))
        x[unsafe_offset=2] = ((G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].stats.deepFlow * UCF(G, Int32(1)))
        x[unsafe_offset=3] = ((G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].stats.latFlow * UCF(G, Int32(1)))
        x[unsafe_offset=4] = (((G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].stats.maxFlow * UCF(G, Int32(10))) * G[].Subcatch[unsafe_offset=Int(j)].area)
        x[unsafe_offset=5] = ((G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].stats.avgUpperMoist / totalSeconds)
        x[unsafe_offset=6] = (((G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].stats.avgWaterTable * UCF(G, Int32(3))) / totalSeconds)
        x[unsafe_offset=7] = (G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].stats.finalUpperMoist
        x[unsafe_offset=8] = ((G[].Subcatch[unsafe_offset=Int(j)].groundwater)[].stats.finalWaterTable * UCF(G, Int32(3)))
        i = Int32(0)
        while (i < Int32(9)):
