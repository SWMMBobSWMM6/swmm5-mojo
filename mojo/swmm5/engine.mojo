    vInfil = (G[].gwater_Infil * ft2sec)
    vUpperEvap = (G[].UpperEvap * ft2sec)
    vLowerEvap = (G[].LowerEvap * ft2sec)
    vLowerPerc = (G[].LowerLoss * ft2sec)
    vGwater = ((Float64(0.5) * (G[].GW[].oldFlow + G[].GW[].newFlow)) * ft2sec)
