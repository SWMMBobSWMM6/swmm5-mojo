# rdii.c:720
def createRdiiFile(G: P[Globals]):
    var hasRdii: Int32 = Int32(0)
    var elapsedTime: Float64 = Float64(0.0)
    var duration: Float64 = Float64(0.0)
    var currentDate: Float64 = Float64(0.0)
    G[].RdiiStep = G[].WetStep
    G[].NumRdiiNodes = getNumRdiiNodes(G)
    if (G[].NumRdiiNodes == Int32(0)):
        G[].Frdii.mode = Int8(0)
        return
    elif (Int32(G[].Frdii.mode) == Int32(0)):
        G[].Frdii.mode = Int8(1)
    validateRdii(G)
    initGageData(G)
    if (G[].ErrorCode != 0):
        return
    openRdiiProcessor(G)
    if (not (G[].ErrorCode != 0)):
        initUnitHydData(G)
        duration = (G[].TotalDuration / Float64(1000.0))
        elapsedTime = Float64(0.0)
        while ((elapsedTime <= duration) and (not (G[].ErrorCode != 0))):
            currentDate = (G[].StartDateTime + (elapsedTime / Float64(86400.0)))
            getRainfall(G, currentDate)
            getUnitHydRdii(G, currentDate)
            hasRdii = getNodeRdii(G)
            if (hasRdii != 0):
                saveRdiiFlows(G, currentDate)
            elapsedTime = (elapsedTime + Float64(G[].RdiiStep))
    closeRdiiProcessor(G)


