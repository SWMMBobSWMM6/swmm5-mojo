def horton_getInfil(G: P[Globals], infil: P[THorton], tstep: Float64, irate: Float64, depth: Float64) -> Float64:
    var iter: Int32 = Int32(0)
    var fa: Float64 = Float64(0.0)
    var fp: Float64 = Float64(0.0)
    var Fp: Float64 = Float64(0.0)
    var F1: Float64 = Float64(0.0)
    var t1: Float64 = Float64(0.0)
    var tlim: Float64 = Float64(0.0)
    var ex: Float64 = Float64(0.0)
    var kt: Float64 = Float64(0.0)
    var FF: Float64 = Float64(0.0)
    var FF1: Float64 = Float64(0.0)
    var r: Float64 = Float64(0.0)
    var f0: Float64 = Float64(0.0)
    var fmin: Float64 = Float64(0.0)
    var Fmax: Float64 = Float64(0.0)
    var tp: Float64 = Float64(0.0)
    var df: Float64 = Float64(0.0)
    var kd: Float64 = Float64(0.0)
    var kr: Float64 = Float64(0.0)
    fp = Float64(0.0)
    f0 = (infil[].f0 * G[].InfilFactor)
    fmin = (infil[].fmin * G[].InfilFactor)
    Fmax = infil[].Fmax
    tp = infil[].tp
    df = (f0 - fmin)
    kd = infil[].decay
    kr = (infil[].regen * G[].Evap.recoveryFactor)
    if (((df < Float64(0.0)) or (kd < Float64(0.0))) or (kr < Float64(0.0))):
        return Float64(0.0)
    if ((df == Float64(0.0)) or (kd == Float64(0.0))):
        fp = f0
        fa = (irate + (depth / tstep))
        if (fp > fa):
            fp = fa
        return ((Float64(0.0)) if ((Float64(0.0)) >= fp) else fp)
    fa = (irate + (depth / tstep))
    if (fa > Float64(1e-10)):
        t1 = (tp + tstep)
        tlim = (Float64(16.0) / kd)
        if (tp >= tlim):
            Fp = ((fmin * tp) + (df / kd))
            F1 = (Fp + (fmin * tstep))
        else:
            Fp = ((fmin * tp) + ((df / kd) * (Float64(1.0) - rt.exp(((-kd) * tp)))))
            F1 = ((fmin * t1) + ((df / kd) * (Float64(1.0) - rt.exp(((-kd) * t1)))))
        fp = ((F1 - Fp) / tstep)
        fp = (fp if (fp >= fmin) else fmin)
        if (fp > fa):
            fp = fa
        if (t1 > tlim):
            tp = t1
        elif (fp < fa):
            tp = t1
        else:
            F1 = (Fp + (fp * tstep))
            tp = (tp + (tstep / Float64(2.0)))
            iter = Int32(1)
            while (iter <= Int32(20)):
                kt = ((Float64(60.0)) if ((Float64(60.0)) <= (kd * tp)) else (kd * tp))
                ex = rt.exp((-kt))
                FF = (((fmin * tp) + ((df / kd) * (Float64(1.0) - ex))) - F1)
                FF1 = (fmin + (df * ex))
                r = (FF / FF1)
                tp = (tp - r)
                if (rt.fabs(r) <= (Float64(0.001) * tstep)):
                    break
                iter += 1
        if (Fmax > Float64(0.0)):
            if ((infil[].Fe + (fp * tstep)) > Fmax):
                fp = ((Fmax - infil[].Fe) / tstep)
            fp = (fp if (fp >= (Float64(0.0))) else (Float64(0.0)))
            infil[].Fe = (infil[].Fe + (fp * tstep))
    elif (kr > Float64(0.0)):
        r = rt.exp(((-kr) * tstep))
        tp = (Float64(1.0) - rt.exp(((-kd) * tp)))
        tp = ((-(rt.log((Float64(1.0) - (r * tp))))) / kd)
        if (Fmax > Float64(0.0)):
            infil[].Fe = ((fmin * tp) + ((df / kd) * (Float64(1.0) - rt.exp(((-kd) * tp)))))
    infil[].tp = tp
    return fp


# infil.c:496
def modHorton_getInfil(G: P[Globals], infil: P[THorton], tstep: Float64, irate: Float64, depth: Float64) -> Float64:
    var f: Float64 = Float64(0.0)
    var fp: Float64 = Float64(0.0)
    var fa: Float64 = Float64(0.0)
    var f0: Float64 = Float64(0.0)
    var fmin: Float64 = Float64(0.0)
    var df: Float64 = Float64(0.0)
    var kd: Float64 = Float64(0.0)
    var kr: Float64 = Float64(0.0)
    f = Float64(0.0)
    f0 = (infil[].f0 * G[].InfilFactor)
    fmin = (infil[].fmin * G[].InfilFactor)
    df = (f0 - fmin)
    kd = infil[].decay
    kr = (infil[].regen * G[].Evap.recoveryFactor)
    if (((df < Float64(0.0)) or (kd < Float64(0.0))) or (kr < Float64(0.0))):
        return Float64(0.0)
    if ((df == Float64(0.0)) or (kd == Float64(0.0))):
        fp = f0
        fa = (irate + (depth / tstep))
        if (fp > fa):
            fp = fa
        return ((Float64(0.0)) if ((Float64(0.0)) >= fp) else fp)
    fa = (irate + (depth / tstep))
    if (fa > Float64(1e-10)):
        if ((infil[].Fmax > Float64(0.0)) and (infil[].Fe >= infil[].Fmax)):
            return Float64(0.0)
        fp = (f0 - (kd * infil[].Fe))
        fp = (fp if (fp >= fmin) else fmin)
        f = (fa if (fa <= fp) else fp)
        infil[].Fe = (infil[].Fe + (((f - fmin) if ((f - fmin) >= (Float64(0.0))) else (Float64(0.0))) * tstep))
        if (infil[].Fmax > Float64(0.0)):
            infil[].Fe = (infil[].Fe if (infil[].Fe >= infil[].Fmax) else infil[].Fmax)
    elif (kr > Float64(0.0)):
        infil[].Fe = (infil[].Fe * rt.exp(((-kr) * tstep)))
        infil[].Fe = (infil[].Fe if (infil[].Fe >= (Float64(0.0))) else (Float64(0.0)))
    return f


